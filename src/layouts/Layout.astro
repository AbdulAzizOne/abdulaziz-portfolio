---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { type Lang, dir, homePath, ui } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  /** Site-relative path used for the canonical and og:url, e.g. "/work/alard". */
  path?: string;
  ogType?: "website" | "article";
  /** File name in /assets/img, e.g. "og-alard.jpg". */
  ogImage?: string;
  /** Structured data, serialised into a JSON-LD script. */
  jsonLd?: unknown;
  /** Home page: in-page nav anchors. */
  home?: boolean;
  /** Error pages: no header/footer, not indexed. */
  bare?: boolean;
  lang?: Lang;
  /** Path of this page in the other language, if it has one. Adds hreflang
      links; the language switch falls back to the other language's home. */
  alternate?: string;
}

const {
  title,
  description,
  path = "/",
  ogType = "website",
  ogImage = "og-image.jpg",
  jsonLd,
  home = false,
  bare = false,
  lang = "en",
  alternate,
} = Astro.props;

const site = Astro.site!.origin;
const url = site + path;
const image = `${site}/assets/img/${ogImage}`;
const t = ui[lang];
const other: Lang = lang === "en" ? "ar" : "en";
const switchHref = alternate ?? homePath[other];
// Both language versions of this page, for hreflang (x-default is English).
const pair = alternate ? { [lang]: path, [other]: alternate } as Record<Lang, string> : undefined;
---
<!doctype html>
<html lang={lang} dir={dir[lang]}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {bare ? (
    <meta name="robots" content="noindex">
  ) : (
    <>
      <meta name="description" content={description}>
      <meta name="author" content={t.name}>
      <meta name="google-site-verification" content="-nG1wKJtrmgK22AbvAJdpewyquqKT23dPthQsD787BU">
      <meta name="theme-color" content="#eceae4">
      <link rel="canonical" href={url}>
      {pair && (
        <>
          <link rel="alternate" hreflang="en" href={site + pair.en}>
          <link rel="alternate" hreflang="ar" href={site + pair.ar}>
          <link rel="alternate" hreflang="x-default" href={site + pair.en}>
        </>
      )}

      <meta property="og:type" content={ogType}>
      <meta property="og:site_name" content={t.name}>
      <meta property="og:locale" content={lang === "ar" ? "ar_AR" : "en_US"}>
      {pair && <meta property="og:locale:alternate" content={lang === "ar" ? "en_US" : "ar_AR"}>}
      <meta property="og:url" content={url}>
      <meta property="og:title" content={title}>
      <meta property="og:description" content={description}>
      <meta property="og:image" content={image}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content={title}>
      <meta name="twitter:description" content={description}>
      <meta name="twitter:image" content={image}>
    </>
  )}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin>
  {lang === "ar" ? (
    <>
      <link rel="preload" href="/assets/fonts/ibm-plex-sans-arabic-400.woff2" as="font" type="font/woff2" crossorigin>
      <link rel="preload" href="/assets/fonts/noto-naskh-arabic-500.woff2" as="font" type="font/woff2" crossorigin>
    </>
  ) : (
    <link rel="preload" href="/assets/fonts/noto-serif-500.woff2" as="font" type="font/woff2" crossorigin>
  )}
  {/* The two inline scripts below are allowed by SHA-256 hash in the CSP (vercel.json).
      Editing either one means regenerating its hash. */}
  <script is:inline>document.documentElement.classList.add("js");</script>
  <script is:inline src="/assets/js/main.js" defer></script>
  <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />}
</head>
<body id={bare ? undefined : "top"}>
  {bare ? (
    <slot />
  ) : (
    <>
      <a class="skip-link" href="#main">{t.skipLink}</a>
      <Header home={home} lang={lang} switchHref={switchHref} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </>
  )}
</body>
</html>
