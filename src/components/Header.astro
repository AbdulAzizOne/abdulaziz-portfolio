---
interface Props {
  /** On the home page, section links stay in-page anchors. */
  home?: boolean;
}
const { home = false } = Astro.props;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Abdulaziz Abu Dhair — home">
      <svg viewBox="0 0 1011 601" aria-hidden="true" focusable="false"><path class="brand__ink" fill="#433717" d="M0 600 349 0l291 500h68a200 200 0 0 0 0-400H523L465 0h243a300 300 0 0 1 0 600H582L349 201 116 600Z"/><path fill="#b18f3c" d="m233 600 116-199 116 199Z"/></svg>
      <span>Abdulaziz Abu Dhair</span>
    </a>
    <div class="site-header__end">
      <nav class="nav" id="site-nav" aria-label="Main">
        <ul class="nav__list">
          <li><a class="nav__link" href={home ? "#case-studies" : "/#case-studies"}>Work</a></li>
          <li><a class="nav__link" href={home ? "#about" : "/#about"}>About</a></li>
          {/* Every page ends with the testimonials section, so this stays in-page. */}
          <li><a class="nav__link" href="#testimonials">Testimonials</a></li>
          <li><a class="btn btn--dark btn--sm" href="#contact">Let’s talk</a></li>
        </ul>
      </nav>
      {/* main.js reveals it and flips data-theme; without JS the site follows the OS setting. */}
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" hidden>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
      </button>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <span class="nav-toggle__bars"></span>
      </button>
    </div>
  </div>
</header>
