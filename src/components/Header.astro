---
import { type Lang, homePath, ui } from "../i18n/ui";

interface Props {
  /** On the home page, section links stay in-page anchors. */
  home?: boolean;
  lang?: Lang;
  /** The same page in the other language, or that language's home. */
  switchHref: string;
}
const { home = false, lang = "en", switchHref } = Astro.props;
const t = ui[lang];
const other = lang === "en" ? "ar" : "en";
const homeHref = homePath[lang];
const section = (id: string) => (home ? `#${id}` : `${homeHref}#${id}`);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={homeHref} aria-label={t.homeLabel}>
      <svg viewBox="0 0 1011 601" aria-hidden="true" focusable="false"><path fill="#433717" d="M0 600 349 0l291 500h68a200 200 0 0 0 0-400H523L465 0h243a300 300 0 0 1 0 600H582L349 201 116 600Z"/><path fill="#b18f3c" d="m233 600 116-199 116 199Z"/></svg>
      <span class="brand__text"><span class="brand__name">{t.name}</span><span class="brand__role">{t.tagline}</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.menuOpen} data-label-open={t.menuOpen} data-label-close={t.menuClose}>
      <span class="nav-toggle__bars"></span>
    </button>
    <nav class="nav" id="site-nav" aria-label={lang === "ar" ? "القائمة الرئيسية" : "Main"}>
      <ul class="nav__list">
        <li><a class="nav__link" href={section("case-studies")}>{t.navWork}</a></li>
        <li><a class="nav__link" href={section("about")}>{t.navAbout}</a></li>
        {/* Every page ends with the testimonials section, so this stays in-page. */}
        <li><a class="nav__link" href="#testimonials">{t.navTestimonials}</a></li>
        <li><a class="nav__link lang-switch" href={switchHref} lang={other} hreflang={other} aria-label={t.switchAria}>{t.switchLabel}</a></li>
        <li><a class="btn btn--dark btn--sm" href="#contact">{t.navContact}</a></li>
      </ul>
    </nav>
  </div>
</header>
