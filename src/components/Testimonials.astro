---
import { testimonials } from "../data/testimonials";

interface Props {
  /** Background band; alternates with the section above it. */
  band?: "light" | "alt";
}
const { band = "alt" } = Astro.props;

const featured = testimonials.find((t) => t.featured);
const others = testimonials.filter((t) => t !== featured);
---
<section class={`band band--${band}`} id="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="section-head section-head--tight reveal">
      <h2 class="section-title" id="testimonials-title">What people say</h2>
      <p class="section-sub">A few words from the people I've had the pleasure of working with.</p>
    </div>

    {featured && (
      <figure class="quote-feature reveal">
        <blockquote><p>“{featured.quote.replace(/\s*\n\s*/g, " ")}”</p></blockquote>
        <figcaption><cite>{featured.name}</cite><span>{featured.role}</span></figcaption>
      </figure>
    )}

    <ul class="quotes">
      {others.map((t) => (
        <li class="reveal">
          <figure class="quote">
            <blockquote><p>“{t.quote}”</p></blockquote>
            <figcaption><cite>{t.name}</cite><span>{t.role}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
