---
import { testimonials } from "../data/testimonials";
import { type Lang, ui } from "../i18n/ui";

interface Props {
  /** Background band; alternates with the section above it. */
  band?: "light" | "alt";
  lang?: Lang;
}
const { band = "alt", lang = "en" } = Astro.props;
const t = ui[lang];
// On Arabic pages, the translation where there is one (the section intro says
// so); a quote without one stays in English, marked as such.
const items = testimonials.map((q) => {
  const tr = lang === "ar" ? q.ar : undefined;
  return { ...q, ...tr, original: lang === "ar" && !tr ? "en" : undefined };
});
// Arabic quotation marks for translated quotes.
const marks = (original?: string) => (lang === "ar" && !original ? ["«", "»"] : ["“", "”"]);
---
<section class={`band band--${band}`} id="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="section-head section-head--tight reveal">
      <h2 class="section-title" id="testimonials-title">{t.testimonialsTitle}</h2>
      <p class="section-sub">{t.testimonialsSub}</p>
    </div>
    <ul class="quotes">
      {items.map((q) => (
        <li class="reveal">
          <figure class="quote" lang={q.original} dir={q.original && "ltr"}>
            <blockquote><p>{marks(q.original)[0]}{q.quote.replace(/\s*\n\s*/g, " ")}{marks(q.original)[1]}</p></blockquote>
            <figcaption><cite>{q.name}</cite><span>{q.role}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
