---
import Eyebrow from "./Eyebrow.astro";
import TestimonialCard from "./TestimonialCard.astro";
import { testimonials } from "../data/testimonials";
import { type Lang, ui } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = ui[lang];
const rtl = lang === "ar";

// On Arabic pages, the translation where there is one. Pending quotes
// (no approved full text yet) are not displayed.
const items = testimonials.filter((q) => !q.pending).map((q) => {
  const tr = lang === "ar" ? q.ar : undefined;
  return { ...q, ...tr, isOriginal: lang === "ar" && !tr };
});
const initialsOf = (name: string) => name.replace(/[^\p{L}\s]/gu, "").split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("");

const [featured, ...rest] = items;
// Two cards stay visible; the rest expand inline ("Show N more" / "Show less").
const visible = rest.slice(0, 2);
const extra = rest.slice(2);
---
<section class="testimonials" id="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="testimonials__head reveal">
      <Eyebrow label={t.testimonialsEyebrow} rtl={rtl} />
      <h2 class="testimonials__title" id="testimonials-title">{t.testimonialsTitle}</h2>
    </div>
    <div class="testimonials__stack reveal">
      <figure class="testimonials__featured theme-inverse" dir={featured.isOriginal ? "ltr" : undefined} lang={featured.isOriginal ? "en" : undefined}>
        <span class="testimonials__quote-mark" aria-hidden="true">&ldquo;</span>
        <blockquote><p>{featured.quote}</p></blockquote>
        <figcaption>
          <span class="testimonial-card__avatar" aria-hidden="true">{initialsOf(featured.name)}</span>
          <span class="testimonial-card__who">
            <cite>{featured.name}</cite>
            <span>{featured.role}</span>
          </span>
        </figcaption>
      </figure>
      <div class="testimonials__more" data-testimonials>
        <div class="testimonials__cards">
          {visible.map((q) => (
            <TestimonialCard quote={q.quote} name={q.name} role={q.role} initials={initialsOf(q.name)} rtl={rtl} original={q.isOriginal} />
          ))}
          <div class="testimonials__extra" id="more-testimonials">
            {extra.map((q) => (
              <TestimonialCard quote={q.quote} name={q.name} role={q.role} initials={initialsOf(q.name)} rtl={rtl} original={q.isOriginal} />
            ))}
          </div>
        </div>
        {extra.length > 0 && (
          <button type="button" class="testimonials__toggle" aria-expanded="false" aria-controls="more-testimonials" data-more={t.testimonialsMore.replace("{n}", String(extra.length))} data-less={t.testimonialsLess} hidden>
            <span data-toggle-label>{t.testimonialsMore.replace("{n}", String(extra.length))}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        )}
      </div>
    </div>
  </div>
</section>
