---
import { type Project, caseHref } from "../data/projects";
import { type Lang, ui } from "../i18n/ui";

interface Props {
  project: Project;
  /** 1-based position, shown as 01, 02, … */
  index: number;
  lang?: Lang;
}

const { project, index, lang = "en" } = Astro.props;
const num = String(index).padStart(2, "0");
const t = ui[lang];
// Arabic text where it exists.
const tr = lang === "ar" ? project.ar : undefined;
const text = { ...project, ...tr };
const alts = tr?.alts ?? [];
const href = caseHref(project, lang);
// Arabic card pointing at the English case study: say so, and mark the link.
const toEnglish = lang === "ar" && !project.ar?.page;
const tablets = project.layout === "tablets";
// Tablet apps show two screens in device frames; web apps one screenshot.
const shots = (tablets ? project.images.slice(0, 2) : project.images.slice(0, 1)).map((img, i) => ({ ...img, alt: alts[i] ?? img.alt }));
const sizes = tablets ? "(min-width: 961px) 200px, 30vw" : "(min-width: 1448px) 570px, (min-width: 961px) 40vw, 86vw";
---
<li class="work-card reveal" id={project.id} style={`--tint: ${project.tint}`}>
  <div class:list={["work-card__media", { "work-card__media--tablets": tablets }]} dir="ltr">
    <span class="work-card__num" aria-hidden="true">{num} /</span>
    {shots.map((img) => tablets ? (
      <span class="work-card__device"><img src={img.src} srcset={img.srcset} sizes={sizes} width={img.width} height={img.height} loading="lazy" decoding="async" alt={img.alt}></span>
    ) : (
      <img src={img.src} srcset={img.srcset} sizes={sizes} width={img.width} height={img.height} loading="lazy" decoding="async" alt={img.alt}>
    ))}
  </div>
  <div class="work-card__body">
    <div class="work-card__head">
      {/* The title link covers the whole card (::after). */}
      <h3 class="work-card__title"><a class="work-card__link" href={href} hreflang={toEnglish ? "en" : undefined}>{project.title}{toEnglish && <span class="visually-hidden">{t.inEnglish}</span>}</a></h3>
      <span class="work-card__arrow" aria-hidden="true">{t.arrowOut}</span>
    </div>
    <p class="work-card__eyebrow">{text.eyebrow}</p>
    <p class="work-card__subtitle">{text.subtitle}</p>
    <p class="work-card__text">{text.summary}</p>
    <dl class="work-card__meta">
      <div><dt class="visually-hidden">{t.role}</dt><dd>{text.role}</dd></div>
      <div class="work-card__status"><dt class="visually-hidden">{t.outcome}</dt><dd>{text.outcome}</dd></div>
    </dl>
  </div>
</li>
