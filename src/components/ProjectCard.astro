---
import { type Project, caseHref } from "../data/projects";
import { type Lang, ui } from "../i18n/ui";

interface Props {
  project: Project;
  /** 1-based position, shown as 01, 02, … */
  index: number;
  lang?: Lang;
}

const { project, index, lang = "en" } = Astro.props;
const num = String(index).padStart(2, "0");
const t = ui[lang];
// Arabic text where it exists.
const tr = lang === "ar" ? project.ar : undefined;
const text = { ...project, ...tr };
const alts = tr?.alts ?? [];
const href = caseHref(project, lang);
// Arabic card pointing at the English case study: say so, and mark the link.
const toEnglish = lang === "ar" && !project.ar?.page;
---
<li class="showcase reveal" id={project.id}>
  <div class:list={["showcase__media", { "showcase__media--tablets": project.layout === "tablets" }]}>
    {project.images.map((img, i) => (
      <img src={img.src} srcset={img.srcset} sizes={img.sizes} width={img.width} height={img.height} loading="lazy" decoding="async" alt={alts[i] ?? img.alt}>
    ))}
  </div>
  <div class="showcase__body">
    <p class="case__num" aria-hidden="true">{num}</p>
    <p class="case__eyebrow">{text.eyebrow}</p>
    <h3 class="showcase__title">{project.title} <span>{text.subtitle}</span></h3>
    {text.status && <p class="status-pill">{text.status}</p>}
    <p class="showcase__text">{text.summary}</p>
    <dl class="showcase__meta">
      <div><dt>{t.role}</dt><dd>{text.role}</dd></div>
      <div><dt>{t.outcome}</dt><dd>{text.outcome}</dd></div>
    </dl>
    <a class="showcase__link" href={href} hreflang={toEnglish ? "en" : undefined}>{toEnglish ? t.readCaseEnglish : t.readCase} <span aria-hidden="true">{t.arrow}</span><span class="visually-hidden">: {project.title}</span></a>
  </div>
</li>
