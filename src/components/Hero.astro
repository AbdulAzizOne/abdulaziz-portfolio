---
import { type Lang, ui } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = ui[lang];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__intro">
      <p class="hero__location"><span class="hero__dot" aria-hidden="true"></span>{t.heroEyebrow}</p>
      <h1 class="hero__title" id="hero-title">{t.heroTitle1}<br class="hero__break"><span class="hero__highlight">{t.heroTitleHighlight}</span>{t.heroTitle2}</h1>
      <p class="hero__lead">{t.heroLead}</p>
    </div>
    <div class="hero__actions">
      {/* Arrows: ↓ in-page jump, → another page or section, ↗ external. */}
      <a class="btn btn--primary btn--xl" href="#work">
        {t.heroCta1}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
      </a>
      <a class="btn btn--link hero__secondary" href="#contact">
        {t.heroCta2}
        <svg class="hero__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    <dl class="hero__stats">
      <div><dt>{t.heroStat1Title}</dt><dd>{t.heroStat1Sub}</dd></div>
      <div><dt>{t.heroStat2Title}</dt><dd>{t.heroStat2Sub}</dd></div>
      <div><dt>{t.heroStat3Title}</dt><dd>{t.heroStat3Sub}</dd></div>
      <div><dt>{t.heroStat4Title}</dt><dd>{t.heroStat4Sub}</dd></div>
    </dl>
  </div>
</section>
