---
import { clientRows } from "../data/clients";
import { type Lang, ui } from "../i18n/ui";

interface Props {
  lang?: Lang;
  /** The section label shown beside the Pause button. */
  label: string;
}
const { lang = "en", label } = Astro.props;
const t = ui[lang];
// Static grid by default; main.js turns it into a two-way marquee
// (skipped when the visitor prefers reduced motion) and reveals Pause.
---
<div class="logo-marquee" data-marquee>
  <div class="logo-marquee__head">
    <p class="clients__label">{label}</p>
    <button class="logo-marquee__toggle" type="button" aria-pressed="false" aria-label={t.logosPauseAria} data-label-pause={t.logosPause} data-label-play={t.logosPlay} data-aria-pause={t.logosPauseAria} data-aria-play={t.logosPlayAria} hidden>
      <svg class="logo-marquee__icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
      <svg class="logo-marquee__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 7 5.5Z"/></svg>
      <span data-toggle-label>{t.logosPause}</span>
    </button>
  </div>
  {clientRows.map((row, i) => (
    <div class="logo-marquee__viewport" dir="ltr">
      <ul class="logo-marquee__row" data-reverse={i % 2 === 1 ? "" : undefined}>
        {row.map((logo) => (
          <li><img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} decoding="async" style={logo.scale ? { "--logo-scale": logo.scale } : undefined}></li>
        ))}
      </ul>
    </div>
  ))}
</div>
