---
/* Section head: eyebrow, two-tone heading (second line in primary), lead. */
interface Props {
  eyebrow: string;
  line1: string;
  line2?: string;
  lead?: string;
  id?: string;
  /** Second line in primary (default) or in the heading colour. */
  accent?: boolean;
}
const { eyebrow, line1, line2, lead, id, accent = true } = Astro.props;
---
<div class="study-head">
  <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>{eyebrow}</p>
  <h2 class="study-head__title" id={id}>{line1}{line2 && <><br><span class:list={[accent && "study-head__accent"]}>{line2}</span></>}</h2>
  {lead && <p class="study-head__lead">{lead}</p>}
</div>
