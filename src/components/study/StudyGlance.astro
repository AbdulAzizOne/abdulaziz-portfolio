---
import { type Lang, ui } from "../../i18n/ui";
interface Item { label: string; value: string; text: string }
interface Props { lang?: Lang; items: Item[] }
const { lang = "en", items } = Astro.props;
const t = ui[lang];
---
<section class="study-glance" aria-labelledby="glance-title">
  <div class="container">
    <h2 class="study-glance__label" id="glance-title">{t.atAGlance}</h2>
    <dl class="study-glance__grid">
      {items.map((i) => (
        <div class="fact">
          <dt class="fact__label">{i.label}</dt>
          <dd class="fact__value">{i.value}</dd>
          <dd class="fact__text">{i.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
