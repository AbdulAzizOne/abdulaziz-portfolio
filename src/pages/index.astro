---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Process from "../components/Process.astro";
import About from "../components/About.astro";
import Testimonials from "../components/Testimonials.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { projects } from "../data/projects";
import { ui } from "../i18n/ui";

const t = ui.en;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://abdulazizabudhair.com/#person",
  "name": "Abdulaziz Abu Dhair",
  "alternateName": ["Abdulaziz Abudhair", "AbdulAziz AbuDhair", "Abdulaziz Abu-Dhair", "عبدالعزيز أبو ضهير"],
  "jobTitle": "Senior Product Designer (UX/UI)",
  "image": "https://abdulazizabudhair.com/assets/img/abdulaziz-portrait-v4-960.webp",
  "url": "https://abdulazizabudhair.com/",
  "email": "mailto:abdulaziz.abudhair@gmail.com",
  "telephone": "+970599835978",
  "sameAs": [
    "https://linkedin.com/in/abdulaziz-abudhair",
    "https://www.behance.net/abdulazizabudhair",
    "https://www.upwork.com/freelancers/~01608bf0df4b2dc6fd"
  ]
};
---
<Layout
  title="Abdulaziz Abu Dhair — Senior Product Designer (UX/UI)"
  description="Senior product designer with 15+ years shipping enterprise, healthcare, travel and fintech products for Fortune 500 R&D teams and startups."
  path="/"
  alternate="/ar"
  jsonLd={jsonLd}
  home
>
<Hero />

<!-- Clients -->
<section class="clients" aria-labelledby="clients-title">
  <h2 class="visually-hidden" id="clients-title">Clients and partners</h2>
  <LogoMarquee />
</section>

<!-- Selected work -->
<section class="work" id="work" aria-labelledby="work-title">
  <span id="case-studies" aria-hidden="true"></span>{/* old links to /#case-studies */}
  <div class="container">
    <div class="work__head reveal">
      <Eyebrow label={t.workEyebrow} />
      <h2 class="work__title" id="work-title">{t.workTitle}</h2>
    </div>
    <ol class="work__grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
    </ol>
  </div>
</section>

<Process />
<About />
<Testimonials />

</Layout>
