---
import Layout from "../layouts/Layout.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Testimonials from "../components/Testimonials.astro";
import FeaturedQuote from "../components/FeaturedQuote.astro";
import { projects } from "../data/projects";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://abdulazizabudhair.com/#person",
  "name": "Abdulaziz Abu Dhair",
  "alternateName": ["Abdulaziz Abudhair", "AbdulAziz AbuDhair", "Abdulaziz Abu-Dhair", "عبدالعزيز أبو ضهير"],
  "jobTitle": "Senior Product Designer (UX/UI)",
  "image": "https://abdulazizabudhair.com/assets/img/abdulaziz-portrait-v4-960.webp",
  "url": "https://abdulazizabudhair.com/",
  "email": "mailto:abdulaziz.abudhair@gmail.com",
  "telephone": "+970599835978",
  "sameAs": [
    "https://linkedin.com/in/abdulaziz-abudhair",
    "https://www.behance.net/abdulazizabudhair",
    "https://www.upwork.com/freelancers/~01608bf0df4b2dc6fd"
  ]
};
---
<Layout
  title="Abdulaziz Abu Dhair — Senior Product Designer (UX/UI)"
  description="Senior product designer with 15+ years shipping enterprise, healthcare, travel and fintech products for Fortune 500 R&D teams and startups."
  path="/"
  alternate="/ar"
  jsonLd={jsonLd}
  home
>
<!-- Hero -->
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__inner">
      <p class="eyebrow">Independent product designer · Nablus, Palestine</p>
      <h1 class="hero__title" id="hero-title">Complex products, <em>made simple to use.</em></h1>
      <p class="hero__lead">Senior product designer with 15+ years of work for Fortune 500 teams and startups — from discovery and UX strategy to interface design and developer handoff.</p>
      <div class="hero__actions">
        <a class="btn btn--dark" href="#case-studies">View selected work <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="text-link" href="#contact">Let’s build something <span aria-hidden="true">→</span></a>
      </div>
      <dl class="hero__stats">
        <div><dt>15+ years</dt><dd>Designing digital products</dd></div>
        <div><dt>Google certified</dt><dd>UX Design Professional</dd></div>
        <div><dt>University lecturer</dt><dd>UX/UI at An-Najah</dd></div>
      </dl>
    </div>
    <figure class="hero__visual">
      <span class="hero__panel" aria-hidden="true"></span>
      <span class="hero__label" aria-hidden="true">Strategy → Experience → Product</span>
      <div class="hero__stage" dir="ltr">
        <img class="hero__shot" src="/assets/img/crpton-1-1368.webp" srcset="/assets/img/crpton-1-1368.webp 1368w, /assets/img/crpton-1-2736.webp 2736w" sizes="(min-width: 1448px) 560px, (min-width: 961px) 40vw, 84vw" width="2736" height="1778" fetchpriority="high" decoding="async" alt="Crpton clinic web app: a patient's finance tab with fees, payments, insurance and balance.">
        <span class="hero__tablet"><img src="/assets/img/zenraise-3-445.webp" srcset="/assets/img/zenraise-3-445.webp 445w, /assets/img/zenraise-3-891.webp 891w" sizes="(min-width: 961px) 200px, 30vw" width="891" height="1424" decoding="async" alt="ZenRaise tablet app: the donation screen with program, frequency and phone number."></span>
        <p class="hero__badge" dir="auto"><span class="hero__badge-icon" aria-hidden="true">✓</span>Live in real clinics</p>
      </div>
      <figcaption class="hero__caption"><span aria-hidden="true">↳</span> Real products. Thoughtful decisions.</figcaption>
    </figure>
  </div>
</section>

<!-- Clients -->
<section class="clients" aria-labelledby="clients-title">
  <div class="container">
    <div class="clients__head">
      <h2 class="eyebrow" id="clients-title">Teams I’ve designed for</h2>
      <p class="clients__intro">From enterprise software, banking and capital markets to healthcare, travel, e-commerce, telecom and logistics. Several global engagements remain under NDA.</p>
    </div>
    <LogoMarquee />
  </div>
</section>

<!-- Case studies -->
<section class="band band--light" id="case-studies" aria-labelledby="case-studies-title">
  <div class="container">
    <div class="section-head section-head--split reveal">
      <div>
        <p class="eyebrow">Selected work / 01–04</p>
        <h2 class="section-title" id="case-studies-title">Four problems <em>worth telling you about.</em></h2>
      </div>
      <p class="section-sub">Real work with real users — from a system clinics run their whole day on, to a donation app live at real events and a store selling across three regions.</p>
    </div>
    <ol class="work-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
    </ol>
  </div>
</section>

<!-- Featured testimonial -->
<div class="quote-band">
  <div class="container reveal">
    <FeaturedQuote />
  </div>
</div>

<!-- About -->
<section class="band band--light" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about">
      <figure class="about__card reveal">
        <img src="/assets/img/abdulaziz-portrait-v4-480.webp" srcset="/assets/img/abdulaziz-portrait-v4-480.webp 480w, /assets/img/abdulaziz-portrait-v4-960.webp 960w" sizes="(min-width: 961px) 400px, (min-width: 721px) 300px, 86vw" width="960" height="960" loading="lazy" decoding="async" alt="Portrait of Abdulaziz Abu Dhair">
        <figcaption><span class="about__card-name">Abdulaziz Abu Dhair</span><span>Nablus, Palestine</span></figcaption>
      </figure>
      <div class="about__body reveal">
        <p class="eyebrow">The person behind the work</p>
        <h2 class="section-title" id="about-title">A design partner, <em>from the first question.</em></h2>
        <div class="about__bio">
          <p>I’m Abdulaziz, a senior product designer who takes complex digital products from early requirements to development-ready design. I combine domain research, user flows, interface design and close collaboration with engineers to deliver systems — not just screens.</p>
          <p>I began working in product design in 2011 at EXALT Technologies and have worked independently since 2023. My background spans enterprise software and startup products across healthcare, travel, e-commerce, fintech and the public sector — more and more on products where AI does part of the work and people stay in control.</p>
        </div>
        <dl class="about__facts">
          <div><dt>Experience</dt><dd>15+ years, 12+ at EXALT Technologies</dd></div>
          <div><dt>Education</dt><dd>BA in Graphic Design, An-Najah National University</dd></div>
          <div><dt>Certification</dt><dd>Google UX Design Certificate</dd></div>
          <div><dt>Languages</dt><dd>Arabic (native), English (proficient)</dd></div>
        </dl>
        <p class="about__links">
          <a class="text-link" href="/assets/files/abdulaziz-abudhair-resume.pdf" target="_blank" rel="noopener">View résumé <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="https://linkedin.com/in/abdulaziz-abudhair" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </div>

    <div class="beyond reveal">
      <div class="beyond__head">
        <h3 class="eyebrow" id="beyond-design">Beyond the screen</h3>
        <p>Teaching and evaluating design keeps my own process honest.</p>
      </div>
      <ul class="beyond__list">
        <li><span>Lecturer, Graphic Design &amp; UX/UI</span><span>An-Najah National University</span></li>
        <li><span>External UX/UI projects evaluator</span><span>Birzeit University · 2023–2026</span></li>
        <li><span>Curriculum redevelopment committee</span><span>An-Najah National University</span></li>
        <li><span>AI-in-design workshop trainer</span><span>Independent training</span></li>
        <li><span>UX/UI mentor</span><span>Startup Weekend, Nablus</span></li>
        <li><span>Certificate of appreciation</span><span>TEDI Najah Expo, mentoring graduation projects</span></li>
      </ul>
    </div>
  </div>
</section>

<Testimonials featured="none" />

</Layout>
