---
import Layout from "../../../layouts/Layout.astro";
import Testimonials from "../../../components/Testimonials.astro";
import NextProject from "../../../components/NextProject.astro";

const img = (name: string, w: number) => `/assets/img/radx/radx-a-${name}-${w}.webp`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "RADX — An Arabic assistant that doesn't just answer, it gets it done",
    "description": "Redesigning the RADX AI assistant app: an audit, ten competitors, a 40-screen map, an Arabic-first design system and a developer-ready prototype in five weeks.",
    "url": "https://abdulazizabudhair.com/work/radx/assistant",
    "image": "https://abdulazizabudhair.com/assets/img/radx/radx-a-hero-1368.webp",
    "author": {
      "@type": "Person",
      "@id": "https://abdulazizabudhair.com/#person",
      "name": "Abdulaziz Abu Dhair",
      "url": "https://abdulazizabudhair.com/"
    },
    "genre": "AI assistant, mobile app",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulazizabudhair.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://abdulazizabudhair.com/#case-studies" },
      { "@type": "ListItem", "position": 3, "name": "RADX", "item": "https://abdulazizabudhair.com/work/radx/assistant" }
    ]
  }
];
---
<Layout
  title="RADX — Case Study · Abdulaziz Abu Dhair"
  description="Redesigning the RADX AI assistant app: an audit, ten competitors, a 40-screen map, an Arabic-first design system and a developer-ready prototype in five weeks."
  path="/work/radx/assistant"
  alternate="/ar/work/radx/assistant"
  ogType="article"
  jsonLd={jsonLd}
>
<article class="band band--light case" aria-labelledby="case-title">
  <div class="container">
    <a class="back-link" href="/#case-studies"><span aria-hidden="true">←</span> Back to portfolio</a>
    <header>
      <p class="case__eyebrow">AI Assistant · Mobile App · Arabic-first</p>
      <h1 class="case__title" id="case-title">RADX <span>An Arabic assistant that doesn't just answer — it gets it done</span></h1>
      <p class="status-pill">In progress · Prototype</p>
      <dl class="case__meta case__meta--4">
        <div><dt>Role</dt><dd>UX/UI Designer, the app's experience and interface end to end</dd></div>
        <div><dt>Platform</dt><dd>iOS and Android app — Arabic interface, light and dark</dd></div>
        <div><dt>Tools</dt><dd>Figma · Dev Mode · AI tools</dd></div>
        <div><dt>Timeline</dt><dd>5 weeks · Oct – Nov 2026</dd></div>
      </dl>
    </header>

    <div class="case__media">
      <img src={img("hero", 1368)} srcset={`${img("hero", 1368)} 1368w, ${img("hero", 2736)} 2736w`} sizes="(min-width: 1448px) 1368px, 94vw" width="2736" height="1400" fetchpriority="high" decoding="async" alt="RADX home screen in light and dark themes: the pearl falcon greets the user, with recent tasks and suggested tasks below.">
    </div>

    <ul class="stats" aria-label="At a glance">
      <li><b>5</b><span>weeks from audit to handoff</span></li>
      <li><b>40</b><span>screens in the product map</span></li>
      <li><b>86</b><span>findings in the app audit</span></li>
      <li><b>10</b><span>competitors analysed</span></li>
    </ul>

    <div class="case__body">
      <div class="prose">
        <h2>The challenge</h2>
        <p>An app that presented itself as a voice guide — when what was needed was an agent that acts in the user's name and earns their trust.</p>
        <h2>What I did</h2>
        <p>Audited the app (86 findings), analysed 10 competitors, and built 40 screens around one flow: ask, approve, follow along, get the result.</p>
      </div>
      <div class="prose">
        <h2>The result</h2>
        <p>Every phase was approved on time or early, and the development team started building from the approved screens before the project ended.</p>
      </div>
    </div>

    <!-- 01 Context -->
    <section class="cs-section" aria-labelledby="s-context">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">01 — Context</p>
          <h2 class="cs-title" id="s-context">A chance to build the region's first Arabic AI agent</h2>
        </div>
        <p class="cs-lead">RADX is a Dubai startup building an AI assistant for Arabic-speaking users in the Gulf. Ask by voice or text, and the assistant searches, books and reaches out on your behalf over WhatsApp or a call — then comes back with the result.</p>
      </div>
      <div class="case__body">
        <div class="prose">
          <p>Booking is the heart of the product: restaurants, hotels, activities, appointments and tickets. Similar global agents are limited either to the US market or to paid subscriptions, so the opportunity was for RADX to be the first Arabic agent in the region.</p>
        </div>
        <div class="collections" style="margin-top:0">
          <div>
            <h3>Booking domains</h3>
            <ul><li>Restaurants</li><li>Hotels</li><li>Activities</li><li>Appointments</li><li>Tickets</li></ul>
          </div>
          <div>
            <h3>Channels</h3>
            <ul><li>WhatsApp</li><li>Call</li></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Problem -->
    <section class="cs-section" aria-labelledby="s-problem">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">02 — The problem</p>
          <h2 class="cs-title" id="s-problem">The app was a guide that answered, not an agent that acted</h2>
        </div>
        <p class="cs-lead">I audited the existing app screen by screen before designing anything. These are the audit's numbers, and what stood out.</p>
      </div>
      <ul class="stats stats--3" aria-label="Audit">
        <li><b>19</b><span>screens and states reviewed</span></li>
        <li><b>86</b><span>findings in the audit</span></li>
        <li><b>9</b><span>critical findings</span></li>
      </ul>
      <p class="stats-note">Of the 86: 9 critical, 52 medium and 25 improvements.</p>

      <div class="cs-split">
        <figure class="cs-split__media">
          <img src={img("before-after", 548)} srcset={`${img("before-after", 548)} 548w, ${img("before-after", 1096)} 1096w`} sizes="(min-width: 721px) 46vw, 94vw" width="1096" height="1084" loading="lazy" decoding="async" alt="The home screen before and after: a voice-only screen with a robot mascot on the right, and the new home with the falcon, recent tasks and suggested tasks on the left.">
          <figcaption class="stats-note">Before (right) and after (left).</figcaption>
        </figure>
        <ol class="cs-list" style="margin-top:0">
          <li><strong>Unclear interaction</strong><span>Voice only, with no text chat and no history — users never knew what the assistant heard or did.</span></li>
          <li><strong>The core value was hidden</strong><span>Booking, the heart of the vision, was locked behind a tier badge.</span></li>
          <li><strong>A long start</strong><span>Sign-in, onboarding and settings were long and repetitive before any real value.</span></li>
          <li><strong>Incomplete Arabic</strong><span>Localisation and right-to-left layout were unfinished, in an app built for Arabic speakers.</span></li>
          <li><strong>A scattered identity</strong><span>Five different brand messages, and a dark theme only.</span></li>
        </ol>
      </div>

      <div class="case__body">
        <div class="prose">
          <h2>Not one requirement fully met</h2>
          <p>I measured the existing app against 13 requirements from the vision document and the agreement: 8 were partly met, 5 not met, and none fully met.</p>
        </div>
        <div class="prose">
          <h2>What we kept</h2>
          <ul>
            <li>Choosing a dialect with live examples — a competitive edge in the Arabic market.</li>
            <li>Asking for permissions only when needed, with the reason.</li>
            <li>A simple four-tab navigation.</li>
            <li>A dark identity with gold touches, and a memorable visual character.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 Role -->
    <section class="cs-section" aria-labelledby="s-role">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">03 — My role</p>
          <h2 class="cs-title" id="s-role">One designer for the app's experience and interface</h2>
        </div>
        <p class="cs-lead">The only designer on the app's experience and interface — from audit and research to screens, the design system, the prototype and developer handoff.</p>
      </div>
      <blockquote class="pull-quote">
        <p>“How does a user trust an assistant that acts in their name — and know at every moment what it's doing?”</p>
        <footer>The design question</footer>
      </blockquote>

      <h3 class="cs-h3">Design principles</h3>
      <ul class="features features--4 features--numbered">
        <li><strong>From answer to action</strong><span>Every answer ends in a “Do it for me” button, so the conversation becomes a task.</span></li>
        <li><strong>No contact before approval</strong><span>The assistant contacts no one without the user's explicit approval.</span></li>
        <li><strong>One clear status</strong><span>16 technical states became one status for the assistant and six for tasks.</span></li>
        <li><strong>Requests never get lost</strong><span>If the connection drops, the request is saved and the user never has to repeat it.</span></li>
      </ul>

      <h3 class="cs-h3">Constraints</h3>
      <ul class="features features--4">
        <li><strong>Time</strong><span>5 weeks for 40 screens, with one review round per phase.</span></li>
        <li><strong>Language</strong><span>An Arabic-only interface: Arabic is the source, not a translation.</span></li>
        <li><strong>Character</strong><span>In week one the mascot changed from a robot to the “pearl falcon”, designed by a team the RADX founder chose.</span></li>
        <li><strong>Development</strong><span>Developers built in parallel, in React Native with Expo.</span></li>
      </ul>
    </section>

    <!-- 04 Process -->
    <section class="cs-section" aria-labelledby="s-process">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">04 — Process</p>
          <h2 class="cs-title" id="s-process">Four phases, with sign-off before every step</h2>
        </div>
        <p class="cs-lead">One review round per phase, and no moving on before approval.</p>
      </div>
      <ol class="steps steps--4" aria-label="Phases">
        <li><strong>Strategy</strong><span>Week 1 · App audit (86 findings), 10 competitors analysed, a 40-screen map</span><small>Approved 10 Oct</small></li>
        <li><strong>Design system</strong><span>Week 2 · Three visual directions, two themes, home and chat</span><small>Approved 19 Oct</small></li>
        <li><strong>App screens</strong><span>Weeks 3–4 · Onboarding, camera and map; booking and account; system states</span><small>Delivered 31 Oct</small></li>
        <li><strong>Prototype</strong><span>Week 5 · Interactive prototype, final review, developer handoff, store assets and promo video</span><small>In progress</small></li>
      </ol>
      <div class="cs-callout">
        <strong>A turning point in week two</strong>
        <p>I presented three visual directions. The first, navy one was rejected, and the client chose “pearl and charcoal”. I built the design system on it, and it was approved a day early.</p>
      </div>
    </section>

    <!-- 05 Research -->
    <section class="cs-section" aria-labelledby="s-research">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">05 — Research</p>
          <h2 class="cs-title" id="s-research">Ten references, and five patterns that became user expectations</h2>
        </div>
        <p class="cs-lead">How the apps closest to RADX design voice, character, task execution, booking, maps and Arabic — to keep what's proven, avoid what failed, and find where RADX stands out.</p>
      </div>
      <h3 class="cs-h3">The ten references</h3>
      <ul class="features features--5">
        <li><strong>Copilot (Mico)</strong><span>An assistant with a visual character</span><small>Character</small></li>
        <li><strong>Gemini Live</strong><span>A voice assistant with the camera</span><small>Voice and camera</small></li>
        <li><strong>ChatGPT Voice</strong><span>Voice and chat</span><small>Voice</small></li>
        <li><strong>ChatGPT Dots</strong><span>An always-on agent working in the background</span><small>Core</small></li>
        <li><strong>Meta Muse</strong><span>A personal agent that carries out tasks</span><small>Core</small></li>
        <li><strong>Booking · OpenTable</strong><span>Booking apps</span><small>Booking patterns</small></li>
        <li><strong>HUMAIN Chat</strong><span>An Arabic assistant</span><small>Arabic and dialects</small></li>
        <li><strong>Mindtrip</strong><span>Trip planning</span><small>Trips</small></li>
        <li><strong>Google Maps</strong><span>Maps with AI</span><small>Maps</small></li>
        <li><strong>AI Mode · Ask for Me</strong><span>Books and calls on your behalf</span><small>Booking</small></li>
      </ul>

      <h3 class="cs-h3">Five shared patterns</h3>
      <ol class="cs-list">
        <li><strong>Voice moved into the chat</strong><span>ChatGPT and Gemini dropped the separate voice screen: speech, text and cards live in one place.</span></li>
        <li><strong>Approval before sensitive actions</strong><span>Muse, Dots and Ask for Me take no sensitive action without clear approval — and users now expect it.</span></li>
        <li><strong>Transparency builds trust</strong><span>An activity log, disclosure on calls, and a visible status for every task. Users want to know what's happening in their name.</span></li>
        <li><strong>The agent works in the background</strong><span>It keeps working after the app is closed, and comes back with a notification when there's a result or a decision to make.</span></li>
        <li><strong>Character serves status</strong><span>Mico and Jolly work when they show what's happening, and annoy when they interrupt.</span></li>
      </ol>

      <h3 class="cs-h3">Where RADX stands out</h3>
      <ul class="features features--4">
        <li><strong>A character with meaning</strong><span>The falcon's expressions map to RADX's states, so it adds clarity, not decoration.</span></li>
        <li><strong>Booking completed in the app</strong><span>Instead of sending users to other sites, RADX reaches the confirmation and keeps every detail in one place.</span></li>
        <li><strong>WhatsApp first, then a call</strong><span>A flow that fits how businesses in the region work, shown as a transparent timeline.</span></li>
        <li><strong>An Arabic agent in the Gulf</strong><span>Muse is US-only, Dots is for business subscriptions, and today's Arabic assistants chat rather than act.</span></li>
      </ul>
    </section>

    <!-- 06 Structure -->
    <section class="cs-section" aria-labelledby="s-structure">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">06 — Structure</p>
          <h2 class="cs-title" id="s-structure">40 screens in nine groups, and eight journeys</h2>
        </div>
        <p class="cs-lead">Before any screen, I mapped the whole app: structure and navigation, then the 40 screens in their groups, then the user journeys that tie each screen to its goal — with proposed decisions and their reasons.</p>
      </div>
      <div class="collections">
        <div>
          <h3>Screen groups</h3>
          <ul>
            <li>Sign-in and onboarding · 6</li><li>Home · 4</li><li>Chat · 5</li>
            <li>Booking and tasks · 9</li><li>Map · 4</li><li>Camera · 3</li>
            <li>Account · 4</li><li>System states · 2</li><li>Trip planning · 3</li>
          </ul>
        </div>
        <div>
          <h3>User journeys</h3>
          <ul>
            <li>Sign-in and onboarding</li><li>Chat: text and voice</li><li>Booking and tasks</li><li>Trip planning</li>
            <li>Map</li><li>Camera</li><li>Account</li><li>System states</li>
          </ul>
        </div>
      </div>
      <figure class="cs-figure">
        <img src={img("app-map", 1120)} srcset={`${img("app-map", 1120)} 1120w, ${img("app-map", 2240)} 2240w`} sizes="(min-width: 1448px) 1368px, 94vw" width="2240" height="1212" loading="lazy" decoding="async" alt="The RADX app map: the screen groups and how navigation connects them.">
        <figcaption>The RADX app map, version 1.0 · 7 October 2026.</figcaption>
      </figure>
      <figure class="cs-figure">
        <img src={img("journey", 1120)} srcset={`${img("journey", 1120)} 1120w, ${img("journey", 2240)} 2240w`} sizes="(min-width: 1448px) 1368px, 94vw" width="2240" height="728" loading="lazy" decoding="async" alt="The booking and tasks journey as a flow diagram, from the request through the approval to the result.">
        <figcaption>The booking and tasks journey: the user approves once, clearly, and RADX does the rest and reports back.</figcaption>
      </figure>
    </section>

    <!-- 07 Decisions -->
    <section class="cs-section" aria-labelledby="s-decisions">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">07 — Key decisions</p>
          <h2 class="cs-title" id="s-decisions">Seven decisions that shaped the product</h2>
        </div>
        <p class="cs-lead">Each decision answers part of the trust question: what the assistant does, when, and with whose permission.</p>
      </div>

      <div class="cs-split">
        <div class="cs-split__media"><img src={img("d1-agent", 620)} srcset={`${img("d1-agent", 620)} 620w, ${img("d1-agent", 1240)} 1240w`} sizes="(min-width: 721px) 50vw, 94vw" width="1240" height="1132" loading="lazy" decoding="async" alt="Four chat screens: the booking details to confirm, an approval card asking whether to go ahead, a live timeline while RADX contacts the restaurant, and the confirmed booking."></div>
        <div>
          <p class="cs-eyebrow">Decision 01</p>
          <h3 class="cs-title">From guide to agent</h3>
          <p>A request becomes a task: a summary, then an approval card, then a timeline of the work — WhatsApp, then a call, then the result — ending with the booking number. The user sees every step.</p>
        </div>
      </div>

      <div class="cs-split cs-split--flip">
        <div class="cs-split__media"><img src={img("d2-approval", 620)} srcset={`${img("d2-approval", 620)} 620w, ${img("d2-approval", 1240)} 1240w`} sizes="(min-width: 721px) 50vw, 94vw" width="1240" height="1132" loading="lazy" decoding="async" alt="Two approval screens: the request summary to review, and RADX waiting for the user's go-ahead before contacting anyone."></div>
        <div>
          <p class="cs-eyebrow">Decision 02</p>
          <h3 class="cs-title">No contact before approval</h3>
          <p>The assistant contacts no one until the user explicitly approves. Payment stays in the user's hands, through the provider's own link — the assistant never holds money.</p>
        </div>
      </div>

      <div class="cs-split">
        <div class="cs-split__media"><img src={img("d3-falcon", 620)} srcset={`${img("d3-falcon", 620)} 620w, ${img("d3-falcon", 1240)} 1240w`} sizes="(min-width: 721px) 50vw, 94vw" width="1240" height="1132" loading="lazy" decoding="async" alt="The pearl falcon in each of its states, every one labelled."></div>
        <div>
          <p class="cs-eyebrow">Decision 03</p>
          <h3 class="cs-title">The falcon is a status indicator</h3>
          <p>The “pearl falcon” isn't decoration but a status indicator with seven states: ready, listening, thinking, acting, success, needs you and error.</p>
          <p class="cs-note">Falcon concept and illustration: a design team chosen by the RADX founder. Animation: the development team.</p>
        </div>
      </div>

      <div class="cs-split cs-split--flip">
        <div class="cs-split__media"><img src={img("d4-voice", 620)} srcset={`${img("d4-voice", 620)} 620w, ${img("d4-voice", 1240)} 1240w`} sizes="(min-width: 721px) 50vw, 94vw" width="1240" height="1132" loading="lazy" decoding="async" alt="Voice inside the chat: live text while RADX listens, and the conversation history with a result card."></div>
        <div>
          <p class="cs-eyebrow">Decision 04</p>
          <h3 class="cs-title">Voice inside the chat</h3>
          <p>Voice isn't a replacement for the chat but part of it: a text chat with full history, and live text while listening, so users know what the assistant heard.</p>
        </div>
      </div>

      <div class="cs-split">
        <div class="cs-split__media"><img src={img("d5-system", 620)} srcset={`${img("d5-system", 620)} 620w, ${img("d5-system", 1240)} 1240w`} sizes="(min-width: 721px) 50vw, 94vw" width="1240" height="1132" loading="lazy" decoding="async" alt="The same chat components in the dark and light themes, with status chips and action buttons."></div>
        <div>
          <p class="cs-eyebrow">Decision 05</p>
          <h3 class="cs-title">An Arabic-first design system</h3>
          <p>98 raw colours became 49 roles and 9 colour styles, with 4.5:1 text contrast and Noto Sans Arabic. Theme and language switch through variables.</p>
        </div>
      </div>

      <ul class="features" style="margin-top:clamp(48px, 6vw, 88px)">
        <li><strong>06 · The shortest path to first value</strong><span>I cut the long onboarding tour, made the app four tabs, and reduced five brand messages to one: “Always with you”.</span></li>
        <li><strong>07 · Proposed decisions, not open questions</strong><span>For every point of disagreement I brought a proposed decision with its reason, and logged anything outside the vision for a later phase instead of spreading the five weeks thin.</span></li>
      </ul>
    </section>

    <!-- 08 Results -->
    <section class="cs-section" aria-labelledby="s-results">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">08 — Results so far</p>
          <h2 class="cs-title" id="s-results">The design is the foundation of today's build</h2>
        </div>
        <p class="cs-lead">The app hasn't launched yet, but developers are building from the approved screens.</p>
      </div>
      <div class="case__body">
        <ol class="cs-list cs-list--dates" style="margin-top:0" aria-label="Milestones">
          <li><time datetime="2026-10-10">10 Oct</time><strong>Strategy approved</strong></li>
          <li><time datetime="2026-10-15">15 Oct</time><strong>Home approved from the first option</strong></li>
          <li><time datetime="2026-10-19">19 Oct</time><strong>Design system approved a day early</strong></li>
          <li><time datetime="2026-10-31">31 Oct</time><strong>Full interactive prototype started, with right-to-left transitions</strong></li>
        </ol>
        <div class="prose">
          <h2>Not measured yet</h2>
          <p>Booking completion, approval-card acceptance, and the time from request to result. Next comes usability testing on the prototype; I'll update these numbers after launch.</p>
          <h2>The collaboration grew</h2>
          <p>The client asked for proposals for other RADX products.</p>
        </div>
      </div>

      <h3 class="cs-h3">Launch kit — ready for the stores, and ready to build</h3>
      <p class="cs-lead" style="margin-top:12px">The work didn't stop at screens: I prepared everything the App Store and Google Play launch needs, and everything developers need to build.</p>
      <figure class="cs-figure">
        <img src={img("store-set", 1120)} srcset={`${img("store-set", 1120)} 1120w, ${img("store-set", 2240)} 2240w`} sizes="(min-width: 1448px) 1368px, 94vw" width="2240" height="974" loading="lazy" decoding="async" alt="Five App Store screenshots forming one panorama: Ask RADX, get it done; Just say it; Options, ranked for you; Nothing happens without your OK; Booked, confirmed, reminded.">
        <figcaption>App Store screenshots: a five-shot panorama that tells the journey — ask, talk, compare, approve, booked.</figcaption>
      </figure>
      <div class="cs-split cs-split--flip" style="margin-top:40px">
        <div class="cs-split__media"><img src={img("play-graphic", 512)} srcset={`${img("play-graphic", 512)} 512w, ${img("play-graphic", 1024)} 1024w`} sizes="(min-width: 721px) 40vw, 94vw" width="1024" height="500" loading="lazy" decoding="async" alt="Google Play feature graphic: Meet RADX — Ask. RADX gets it done, beside the pearl falcon."></div>
        <div>
          <h3 class="cs-title">Google Play feature graphic</h3>
          <p>Shown at the top of the store page and in promotions, it repeats the first screenshot's message so the impression stays the same.</p>
        </div>
      </div>
      <ul class="features features--3 features--numbered">
        <li><strong>Store screenshots with captions</strong><span>App Store and Google Play screenshots, each headed by the feature it shows. iPhone 6.9″ 1320×2868 · Google Play 1080×1920 · feature graphic 1024×500.</span></li>
        <li><strong>Promo video</strong><span>Two versions, for iPhone and Android, showing the app from request to result. App Preview 886×1920 · 15–30 seconds · Google Play and YouTube.</span></li>
        <li><strong>Developer assets</strong><span>Everything developers need to build and ship, starting with the app icon in every version: iOS light, dark and tinted at 1024; Android adaptive in two layers; monochrome; Play 512.</span></li>
      </ul>

      <blockquote class="pull-quote">
