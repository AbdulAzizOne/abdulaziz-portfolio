    },
    "creator": {
      "@type": "Person",
      "name": "Abdulaziz Abu Dhair",
      "url": "https://abdulazizabudhair-portfolio.vercel.app/"
    },
    "genre": "B2B travel booking platform",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://abdulazizabudhair-portfolio.vercel.app/"
