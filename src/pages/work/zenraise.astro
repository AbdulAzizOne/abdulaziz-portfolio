---
import Layout from "../../layouts/Layout.astro";
import StudyHero from "../../components/study/StudyHero.astro";
import StudyGlance from "../../components/study/StudyGlance.astro";
import StudyHead from "../../components/study/StudyHead.astro";
import StudyMedia from "../../components/study/StudyMedia.astro";
import StudyQuote from "../../components/study/StudyQuote.astro";
import StudyCta from "../../components/study/StudyCta.astro";
import StudyNext from "../../components/study/StudyNext.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "ZenRaise — Turning cash-in-a-box collection into a documented, recurring system",
    "description": "A tablet app designed to get staff ready to collect in under a minute — every donation tied to its event, recurring giving front and center.",
    "url": "https://abdulazizabudhair.com/work/zenraise",
    "image": "https://abdulazizabudhair.com/assets/img/og-zenraise.jpg",
    "author": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "creator": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "genre": "Tablet app · Fundraising",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulazizabudhair.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://abdulazizabudhair.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "ZenRaise", "item": "https://abdulazizabudhair.com/work/zenraise" }
    ]
  }
];
---
<Layout
  title="ZenRaise — Case Study · Abdulaziz Abu Dhair"
  description="A tablet app designed to get staff ready to collect in under a minute — every donation tied to its event, recurring giving front and center, and returning donors recognized by phone number."
  path="/work/zenraise"
  alternate="/ar/work/zenraise"
  ogType="article"
  ogImage="og-zenraise.jpg"
  jsonLd={jsonLd}
  study
>
<article class="study" aria-labelledby="case-title">
  <StudyHero
    project="zenraise"
    eyebrow="Case study · Tablet app · Fundraising"
    title="ZenRaise"
    subtitle="Turning cash-in-a-box collection into a documented, recurring system"
    lead="A tablet app designed to get staff ready to collect in under a minute — every donation tied to its event, recurring giving front and center, and returning donors recognized by phone number."
    facts={[
      { label: "My role", value: "UX/UI Designer, solo end-to-end" },
      { label: "Platform", value: "Tablet app" },
      { label: "Timeline", value: "7 weeks · April – May 2026" },
      { label: "Status", value: "Live on the App Store", status: true },
    ]}
    coverAlt="Three ZenRaise tablet screens: getting started, a donation with a per-child stepper, and the thank-you screen."
  />

  <StudyGlance items={[
    { label: "Scope", value: "7 weeks", text: "Solo, end to end — flows, UI, prototype & micro-interactions" },
    { label: "Design goal", value: "< 1 min", text: "Designed to get staff ready to collect in under a minute." },
    { label: "Status", value: "Live", text: "On the App Store, used at real events" },
  ]} />

  <section class="study-section study-overview" aria-labelledby="overview-title">
    <div class="container study-overview__grid">
      <div class="study-overview__head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>The challenge</p>
        <h2 class="study-overview__title" id="overview-title">A cashbox,<br>and no real record.</h2>
      </div>
      <div class="study-overview__body">
        <div>
          <h3>Context</h3>
          <p>ZenRaise replaces the clipboard-and-cashbox way mosques and community organizations collect donations at events. Staff run the same night with dozens of donors, multiple giving programs, and a card reader — often with no dedicated tech person on hand.</p>
        </div>
        <div>
          <h3>Problem</h3>
          <p>Manual collection left no real record: no reliable way to see how much came in, no way to compare one event against another, and no way to set up recurring gifts instead of one-off cash. Whoever ran the tablet needed a card reader working in minutes with no technical background, and donors needed a screen simple enough to understand what they were giving to and how often.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="decisions-title">
    <div class="container">
      <StudyHead id="decisions-title" eyebrow="01 — Key decisions" line1="Seven decisions behind a tablet" line2="anyone on staff can run" lead="From pairing a card reader to closing out the night — each one removes a step that used to need a technical person or a manual tally." accent={false} />
      <ol class="study-decisions">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">A guided 3-step setup</h3><p class="fact__text">Select event, pair reader, ready to collect — with a live Bluetooth pairing state, so any staff member, not just a technical one, can get ready to collect. Designed for under a minute.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Every donation tied to its event</h3><p class="fact__text">Totals for each event stay separated automatically, turning “which event performs better” from a guess into a real, comparable number.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">Input shaped by the program</h3><p class="fact__text">A dollar amount with quick presets for one program, and a per-recipient stepper at a fixed rate for another — since the two are fundamentally different kinds of giving.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">Recurring giving up front</h3><p class="fact__text">Monthly / yearly is a visible choice on the main donation screen, not a secondary setting, since moving people from one-time to recurring giving was a core goal.</p></li>
        <li class="fact fact--md"><span class="fact__label">05</span><h3 class="fact__value">“Is this you?”</h3><p class="fact__text">Phone-number recognition greets a returning donor by name, giving the organization one clean donor record instead of duplicates scattered across events.</p></li>
        <li class="fact fact--md"><span class="fact__label">06</span><h3 class="fact__value">The night’s number, instantly</h3><p class="fact__text">An always-available event-details screen — total raised by program and frequency, plus leads captured — so ending a shift produces the number organizers used to wait for.</p></li>
        <li class="fact fact--md"><span class="fact__label">07</span><h3 class="fact__value">Built to be white-labeled</h3><p class="fact__text">The whole system on Material Theme Builder with vector components, since the client planned to resell ZenRaise to partner organizations under their own colors and branding.</p></li>
      </ol>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="tablet-title">
    <div class="container study-stack">
      <StudyHead id="tablet-title" eyebrow="02 — The tablet app" line1="From the first donor" line2="to the night’s total" accent={false} />
      <figure class="study-figure study-group">
        <StudyMedia project="zenraise" name="02-programs" desktop={[1200, 600]} tablet={[704, 352]} mobile={[358, 213]} alt="Three ZenRaise tablet screens: selecting the event, a Food Aid donation with quick presets, and the Orphan program with a per-child stepper and yearly frequency." />
        <figcaption class="study-group__captions study-group__captions--3 study-group__captions--center">
          <span>Select the event — every donation is tied to it.</span>
          <span>Food Aid — a dollar amount with quick presets.</span>
          <span>Orphan program — per-child stepper with yearly frequency selected.</span>
        </figcaption>
      </figure>
      <figure class="study-figure study-group">
        <StudyMedia project="zenraise" name="03-after-payment" desktop={[1200, 600]} tablet={[704, 352]} mobile={[358, 213]} alt="Three ZenRaise tablet screens: a returning donor recognized by phone number, payment processed, and event details with the total raised." />
        <figcaption class="study-group__captions study-group__captions--3 study-group__captions--center">
          <span>A returning donor recognized by phone number.</span>
          <span>Payment processed.</span>
          <span>Event details — total raised by program and frequency, plus leads.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <StudyQuote
    quote="Great UX/UI design and wireframing. He provided multiple prototypes in Figma and delivered high-fidelity designs for our tablet app, creating the best possible user experience. I highly recommend hiring him and would definitely work with Abdulaziz again."
    name="Ameed J."
    role="Founder, ZenRaise · USA"
    initials="AJ"
  />

  <section class="study-section" aria-labelledby="outcome-title">
    <div class="container">
      <StudyHead id="outcome-title" eyebrow="03 — Outcome" line1="Live on the App Store" />
      <div class="study-outcome">
        <div>
          <h3>Outcome</h3>
          <p class="study-outcome__lead">ZenRaise is live on the App Store — in use at real events, collecting real donations from real donors.</p>
        </div>
        <div>
          <h3>What I learned</h3>
          <p>Building on Material Theme Builder from day one meant that when the white-label ask came up, it was a token and font swap across the whole app, not a redesign. Working in fast feedback loops with the client — quick check-ins instead of long silent build cycles — caught misdirection early. I also started using AI tools to sanity-check finished screens for typos and small inconsistencies before handoff, a five-minute pass that saved a few rounds of fixes.</p>
        </div>
      </div>
    </div>
  </section>

  <StudyCta title="Collecting donations or payments in person?" text="Tell me how it works today, and where it slows your team down." />
</article>

<StudyNext current="zenraise" />

</Layout>
