---
import Layout from "../../layouts/Layout.astro";
import Testimonials from "../../components/Testimonials.astro";
import NextProject from "../../components/NextProject.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "ZenRaise — Turning cash-in-a-box collection into a documented, recurring system",
    "description": "A tablet app designed to get staff ready to collect in under a minute — every donation tied to its event, recurring giving front and center.",
    "url": "https://abdulazizabudhair.com/work/zenraise",
    "image": "https://abdulazizabudhair.com/assets/img/og-zenraise.jpg",
    "author": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "creator": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "genre": "Tablet app · Fundraising",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulazizabudhair.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://abdulazizabudhair.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "ZenRaise", "item": "https://abdulazizabudhair.com/work/zenraise" }
    ]
  }
];
---
<Layout
  title="ZenRaise — Case Study · Abdulaziz Abu Dhair"
  description="A tablet app designed to get staff ready to collect in under a minute — every donation tied to its event, recurring giving front and center, and returning donors recognized by phone number."
  path="/work/zenraise"
  alternate="/ar/work/zenraise"
  ogType="article"
  ogImage="og-zenraise.jpg"
  jsonLd={jsonLd}
>
<article class="case" aria-labelledby="case-title">
  <div class="container cs-hero">
    <a class="back-link text-link" href="/#work"><span aria-hidden="true">←</span> Back to portfolio</a>
    <p class="cs-hero__eyebrow">Case study · Tablet app · Fundraising</p>
    <h1 class="cs-hero__title" id="case-title">ZenRaise</h1>
    <p class="cs-hero__subtitle">Turning cash-in-a-box collection into a documented, recurring system — a tablet app designed to get staff ready to collect in under a minute, every donation tied to its event, recurring giving front and center, and returning donors recognized by phone number.</p>
    <dl class="cs-hero__facts">
      <div><dt>My role</dt><dd>UX/UI Designer, solo end-to-end</dd></div>
      <div><dt>Platform</dt><dd>Tablet app</dd></div>
      <div><dt>Timeline</dt><dd>7 weeks · April – May 2026</dd></div>
      <div><dt>Status</dt><dd class="cs-status"><span class="work-card__dot" aria-hidden="true"></span>Live on the App Store</dd></div>
    </dl>
    <nav class="cs-onthispage" aria-label="On this page">
      <span class="cs-onthispage__label">On this page</span>
      <a href="#overview">Overview</a>
      <a href="#decisions">Key decisions</a>
      <a href="#tablet-app">The tablet app</a>
      <a href="#outcome">Outcome</a>
    </nav>
  </div>

  <div class="container">
    <div class="cs-grid cs-grid--4" style={{ "--project-tile": "var(--project-zenraise)" }}>
      <figure><img src="/assets/img/zenraise-cs-hero-1-300.webp" srcset="/assets/img/zenraise-cs-hero-1-300.webp 300w, /assets/img/zenraise-cs-hero-1-600.webp 600w" sizes="300px" width="300" height="480" fetchpriority="high" decoding="async" alt="ZenRaise onboarding: three steps to start collecting — select event, pair reader, collect."><figcaption>Three steps to start collecting — select event, pair reader, collect.</figcaption></figure>
      <figure><img src="/assets/img/zenraise-cs-hero-2-300.webp" srcset="/assets/img/zenraise-cs-hero-2-300.webp 300w, /assets/img/zenraise-cs-hero-2-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise card reader paired and ready, with a live Bluetooth state."><figcaption>Card reader paired and ready, with a live Bluetooth state.</figcaption></figure>
      <figure><img src="/assets/img/zenraise-cs-hero-3-300.webp" srcset="/assets/img/zenraise-cs-hero-3-300.webp 300w, /assets/img/zenraise-cs-hero-3-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise donation screen: program, number of children, frequency, phone."><figcaption>Donation screen — program, number of children, frequency, phone.</figcaption></figure>
    </div>
  </div>

  <div class="container cs-section">
    <p class="fact-card__label">Project at a glance</p>
    <div class="cs-glance">
      <div class="fact-card"><p class="fact-card__value">7 weeks</p><p class="fact-card__text">Solo, end to end — flows, UI, prototype &amp; micro-interactions</p></div>
      <div class="fact-card"><p class="fact-card__value">&lt; 1 min</p><p class="fact-card__text">Designed to get staff ready to collect in under a minute.</p></div>
      <div class="fact-card"><p class="fact-card__value">Live</p><p class="fact-card__text">On the App Store, used at real events</p></div>
    </div>
  </div>

  <div class="container cs-section" id="overview">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>The challenge</div>
    <h2 class="cs-title">A cashbox, and no real record.</h2>
    <div class="cs-prose">
      <div>
        <h3>Context</h3>
        <p>ZenRaise replaces the clipboard-and-cashbox way mosques and community organizations collect donations at events. Staff run the same night with dozens of donors, multiple giving programs, and a card reader — often with no dedicated tech person on hand.</p>
      </div>
      <div>
        <h3>Problem</h3>
        <p>Manual collection left no real record: no reliable way to see how much came in, no way to compare one event against another, and no way to set up recurring gifts instead of one-off cash. Whoever ran the tablet needed a card reader working in minutes with no technical background, and donors needed a screen simple enough to understand what they were giving to and how often.</p>
      </div>
    </div>
  </div>

  <div class="container cs-section" id="decisions">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>01 — Key decisions</div>
    <h2 class="cs-title">Seven decisions behind a tablet <em>anyone on staff can run</em></h2>
    <p class="cs-lead">From pairing a card reader to closing out the night — each one removes a step that used to need a technical person or a manual tally.</p>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">A guided 3-step setup</p><p class="fact-card__text">Select event, pair reader, ready to collect — with a live Bluetooth pairing state, so any staff member, not just a technical one, can get ready to collect. Designed for under a minute.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Every donation tied to its event</p><p class="fact-card__text">Totals for each event stay separated automatically, turning “which event performs better” from a guess into a real, comparable number.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">Input shaped by the program</p><p class="fact-card__text">A dollar amount with quick presets for one program, and a per-recipient stepper at a fixed rate for another — since the two are fundamentally different kinds of giving.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">Recurring giving up front</p><p class="fact-card__text">Monthly / yearly is a visible choice on the main donation screen, not a secondary setting, since moving people from one-time to recurring giving was a core goal.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">05</p><p class="fact-card__value">“Is this you?”</p><p class="fact-card__text">Phone-number recognition greets a returning donor by name, giving the organization one clean donor record instead of duplicates scattered across events.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">06</p><p class="fact-card__value">The night’s number, instantly</p><p class="fact-card__text">An always-available event-details screen — total raised by program and frequency, plus leads captured — so ending a shift produces the number organizers used to wait for.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">07</p><p class="fact-card__value">Built to be white-labeled</p><p class="fact-card__text">The whole system on Material Theme Builder with vector components, since the client planned to resell ZenRaise to partner organizations under their own colors and branding.</p></div>
    </div>
  </div>

  <div class="container cs-section" id="tablet-app">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>02 — The tablet app</div>
    <h2 class="cs-title">From the first donor to the night’s total</h2>
    <div class="cs-grid cs-grid--4" style={{ "--project-tile": "var(--project-zenraise)", marginTop: "40px" }}>
      <figure><img src="/assets/img/zenraise-cs-app-1-300.webp" srcset="/assets/img/zenraise-cs-app-1-300.webp 300w, /assets/img/zenraise-cs-app-1-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise: select the event — every donation is tied to it."><figcaption>Select the event — every donation is tied to it.</figcaption></figure>
      <figure><img src="/assets/img/zenraise-cs-app-2-300.webp" srcset="/assets/img/zenraise-cs-app-2-300.webp 300w, /assets/img/zenraise-cs-app-2-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise Food Aid program: a dollar amount with quick presets."><figcaption>Food Aid — a dollar amount with quick presets.</figcaption></figure>
      <figure><img src="/assets/img/zenraise-cs-app-3-300.webp" srcset="/assets/img/zenraise-cs-app-3-300.webp 300w, /assets/img/zenraise-cs-app-3-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise Orphan program: per-child stepper with yearly frequency selected."><figcaption>Orphan program — per-child stepper with yearly frequency selected.</figcaption></figure>
    </div>
    <div class="cs-grid cs-grid--4" style={{ "--project-tile": "var(--project-zenraise)", marginTop: "24px" }}>
      <figure><img src="/assets/img/zenraise-cs-app-4-300.webp" srcset="/assets/img/zenraise-cs-app-4-300.webp 300w, /assets/img/zenraise-cs-app-4-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise: a returning donor recognized by phone number."><figcaption>A returning donor recognized by phone number.</figcaption></figure>
      <figure><img src="/assets/img/zenraise-cs-app-5-300.webp" srcset="/assets/img/zenraise-cs-app-5-300.webp 300w, /assets/img/zenraise-cs-app-5-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise payment processed confirmation."><figcaption>Payment processed.</figcaption></figure>
      <figure><img src="/assets/img/zenraise-cs-app-6-300.webp" srcset="/assets/img/zenraise-cs-app-6-300.webp 300w, /assets/img/zenraise-cs-app-6-600.webp 600w" sizes="300px" width="300" height="480" loading="lazy" decoding="async" alt="ZenRaise event details: total raised by program and frequency, plus leads."><figcaption>Event details — total raised by program and frequency, plus leads.</figcaption></figure>
    </div>
  </div>

  <div class="container cs-section">
    <figure class="cs-quote">
      <span class="cs-quote__mark" aria-hidden="true">&ldquo;</span>
      <blockquote><p>Great UX/UI design and wireframing. He provided multiple prototypes in Figma and delivered high-fidelity designs for our tablet app, creating the best possible user experience. I highly recommend hiring him and would definitely work with Abdulaziz again.</p></blockquote>
      <figcaption>
        <span class="testimonial-card__avatar" aria-hidden="true">AJ</span>
        <span class="testimonial-card__who"><cite>Ameed J.</cite><span>Founder, ZenRaise · USA</span></span>
      </figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="outcome">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>03 — Outcome</div>
    <h2 class="cs-title">Live on the App Store</h2>
    <div class="cs-outcome">
      <div>
        <h3>Outcome</h3>
        <p>ZenRaise is live on the App Store — in use at real events, collecting real donations from real donors.</p>
      </div>
      <div>
        <h3>What I learned</h3>
        <p>Building on Material Theme Builder from day one meant that when the white-label ask came up, it was a token and font swap across the whole app, not a redesign. Working in fast feedback loops with the client — quick check-ins instead of long silent build cycles — caught misdirection early. I also started using AI tools to sanity-check finished screens for typos and small inconsistencies before handoff, a five-minute pass that saved a few rounds of fixes.</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="cs-cta">
      <div>
        <h2>Collecting donations or payments in person?</h2>
        <p>Tell me how it works today, and where it slows your team down.</p>
      </div>
      <a class="btn btn--primary btn--xl" href="/#contact">Let’s talk</a>
    </div>
  </div>
</article>

<NextProject current="zenraise" />

<Testimonials />

</Layout>
