const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "VBooking — One travel platform, two sides",
    "description": "A traveler community with AI trip planning and real travel experts, and a workspace that unifies booking, CRM and AI for travel agents — designed end to end as one system.",
    "url": "https://abdulazizabudhair-portfolio.vercel.app/work/vbooking",
    "image": "https://abdulazizabudhair-portfolio.vercel.app/assets/img/og-vbooking.jpg",
    "author": {
      "@type": "Person",
      "name": "Abdulaziz Abu Dhair",
      "url": "https://abdulazizabudhair-portfolio.vercel.app/"
    },
    "creator": {
      "@type": "Person",
      "name": "Abdulaziz Abu Dhair",
      "url": "https://abdulazizabudhair-portfolio.vercel.app/"
    },
    "genre": "Travel tech, B2C and B2B",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://abdulazizabudhair-portfolio.vercel.app/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Work",
        "item": "https://abdulazizabudhair-portfolio.vercel.app/#case-studies"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "VBooking",
        "item": "https://abdulazizabudhair-portfolio.vercel.app/work/vbooking"
      }
    ]
  }
