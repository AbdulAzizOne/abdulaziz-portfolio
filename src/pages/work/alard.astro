---
import Layout from "../../layouts/Layout.astro";
import StudyHero from "../../components/study/StudyHero.astro";
import StudyGlance from "../../components/study/StudyGlance.astro";
import StudyHead from "../../components/study/StudyHead.astro";
import StudyMedia from "../../components/study/StudyMedia.astro";
import StudyQuote from "../../components/study/StudyQuote.astro";
import StudyCta from "../../components/study/StudyCta.astro";
import StudyNext from "../../components/study/StudyNext.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "AL'ARD — Making a beautiful story easy to buy",
    "description": "A conversion-focused redesign of AL'ARD's US online store for Palestinian olive oil and heritage goods.",
    "url": "https://abdulazizabudhair.com/work/alard",
    "image": "https://abdulazizabudhair.com/assets/img/og-alard.jpg",
    "author": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "creator": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "genre": "E-commerce · Conversion redesign",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulazizabudhair.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://abdulazizabudhair.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "AL'ARD", "item": "https://abdulazizabudhair.com/work/alard" }
    ]
  }
];
---
<Layout
  title="AL'ARD — Case Study · Abdulaziz Abu Dhair"
  description="A conversion-focused redesign of AL'ARD's US online store for Palestinian olive oil and heritage goods — calmer homepage, every category one click away, and a product page rebuilt around the fold."
  path="/work/alard"
  alternate="/ar/work/alard"
  ogType="article"
  ogImage="og-alard.jpg"
  jsonLd={jsonLd}
  study
>
<article class="study" aria-labelledby="case-title">
  <StudyHero
    project="alard"
    eyebrow="Case study · E-commerce · Conversion redesign"
    title="AL’ARD"
    subtitle="Making a beautiful story easy to buy"
    lead="A conversion-focused redesign of AL’ARD’s US online store for Palestinian olive oil and heritage goods — calmer homepage, every category one click away, and a product page rebuilt around the fold."
    facts={[
      { label: "My role", value: "UX/UI Designer" },
      { label: "Platform", value: "Responsive web — US storefront on Shopify" },
      { label: "Timeline", value: "12 months · Sep 2025 – Aug 2026" },
      { label: "Status", value: "Redesign now live", status: true },
    ]}
    coverAlt="The redesigned AL’ARD storefront: the olive oil mega menu over the Palestinian Olive Oil collection."
  />

  <StudyGlance items={[
    { label: "Scope", value: "US store", text: "Desktop and mobile, built on Shopify" },
    { label: "Status", value: "Live", text: "Redesign live at alardproducts.com" },
  ]} />

  <section class="study-section study-overview" aria-labelledby="overview-title">
    <div class="container study-overview__grid">
      <div class="study-overview__head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>The challenge</p>
        <h2 class="study-overview__title" id="overview-title">A beautiful story —<br>that was hard to buy</h2>
      </div>
      <div class="study-overview__body">
        <div>
          <h3>Context</h3>
          <p>AL’ARD sells Palestinian olive oil and artisan foods — heritage products tied closely to Palestinian identity. My redesign covered its US online store.</p>
        </div>
        <div>
          <h3>The brief</h3>
          <p>A conversion-focused redesign that makes shopping effortless on desktop and mobile — without diluting the brand’s Palestinian heritage identity.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="problem-title">
    <div class="container">
      <StudyHead id="problem-title" eyebrow="01 — The problem" line1="What made the old store" line2="hard to shop" accent={false} />
      <ol class="study-facts study-facts--4">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">Pop-up overload</h3><p class="fact__text">Homepages cluttered with stacked pop-ups competing for attention.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Buried navigation</h3><p class="fact__text">Key categories hidden inside a desktop side menu.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">Below the fold</h3><p class="fact__text">Product image, price and size options all sat below the fold.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">SEO debt</h3><p class="fact__text">SEO audits of the store flagged structural issues.</p></li>
      </ol>
      <h3 class="eyebrow study-subhead" id="worked-title"><span class="eyebrow__square" aria-hidden="true"></span>How I worked</h3>
      <ol class="study-facts study-facts--5">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">Audit</h3><p class="fact__text">UX pain points &amp; SEO findings</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Restructure</h3><p class="fact__text">Catalog &amp; IA around how people shop</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">Design</h3><p class="fact__text">Desktop + mobile screens</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">Prototype</h3><p class="fact__text">Interactive Figma prototype</p></li>
        <li class="fact fact--md"><span class="fact__label">05</span><h3 class="fact__value">Iterate</h3><p class="fact__text">Marketing feedback, new features &amp; SEO reviews</p></li>
      </ol>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="nav-title">
    <div class="container">
      <StudyHead id="nav-title" eyebrow="02 — Key decision · Navigation & IA" line1="Every category, one click away —" line2="from any scroll position" accent={false} />
      <ol class="study-facts study-facts--4">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">Sticky header</h3><p class="fact__text">Primary navigation moved out of the side menu into a header that stays with the shopper.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Mega menu by intent</h3><p class="fact__text">Shop by need, by size or by type — the way people actually decide.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">Merchandising tile</h3><p class="fact__text">Seasonal hooks like “First Press of the Season” live right inside the menu.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">Search-first header</h3><p class="fact__text">A wide search bar with helpful prompts: olive oil, za’atar, gift boxes.</p></li>
      </ol>
      <figure class="study-figure study-figure--after-facts">
        <StudyMedia project="alard" name="02-mega-menu-olive-oil" desktop={[1200, 487]} tablet={[704, 287]} mobile={[358, 145]} alt="The AL’ARD Palestinian Olive Oil mega menu: shop by need, by size and by type, with a First Press of the Season tile." />
        <figcaption>The Palestinian Olive Oil mega menu — by need, size and type.</figcaption>
      </figure>
      <div class="study-next-block">
        <StudyHead id="home-title" eyebrow="03 — Key decision · Homepage" line1="A calmer homepage that sells" />
      <ol class="study-facts study-facts--3">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">Minimized pop-ups</h3><p class="fact__text">One clear message at a time instead of stacked overlays.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">More products above the fold</h3><p class="fact__text">Best sellers surface in the very first scroll.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">“Compare the Gifts”</h3><p class="fact__text">Guides buyers by budget and occasion — Mini, Pantry, Olive Oil, Premium.</p></li>
      </ol>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="pdp-title">
    <div class="container">
      <StudyHead id="pdp-title" eyebrow="04 — Key decision · Product page" line1="The product page," line2="rebuilt around the fold" accent={false} />
      <ol class="study-facts study-facts--3">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">Gallery above the fold</h3><p class="fact__text">Hero image and thumbnails visible without scrolling.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Title, rating &amp; proof</h3><p class="fact__text">Halal and Harvest tags, rating and “300+ bought” up top.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">Per-unit pricing</h3><p class="fact__text">Price per ml makes the bulk discount self-evident.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">Size variants as cards</h3><p class="fact__text">Every size shows its own price and saving.</p></li>
        <li class="fact fact--md"><span class="fact__label">05</span><h3 class="fact__value">Subscribe &amp; Save</h3><p class="fact__text">One-time or recurring delivery in a single step.</p></li>
        <li class="fact fact--md"><span class="fact__label">06</span><h3 class="fact__value">Persistent trust badges</h3><p class="fact__text">Authentic Palestinian origin + free-shipping threshold.</p></li>
      </ol>
      <figure class="study-figure study-figure--after-facts">
        <StudyMedia project="alard" name="03-product-page" desktop={[1200, 894]} tablet={[704, 524]} mobile={[358, 281]} alt="The AL’ARD product page: gallery, Halal and Harvest tags, rating, per-ml pricing, size cards, subscribe and save, and trust badges above the fold." />
        <figcaption>Gallery, tags, rating, per-ml pricing, size cards, subscribe &amp; save and trust badges — all above the fold.</figcaption>
      </figure>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="mobile-title">
    <div class="container">
      <StudyHead id="mobile-title" eyebrow="05 — Mobile" line1="Designed for mobile, too" lead="The key screens were designed for the phone as well — home, mega menu, product page and filters." />
      <figure class="study-figure study-group">
        <StudyMedia project="alard" name="04-mobile-screens" desktop={[1200, 590]} tablet={[704, 346]} mobile={[358, 211]} alt="Four AL’ARD mobile screens: home, the olive oil mega menu, the product page with sizes, and All Products filters." />
        <figcaption class="study-group__captions study-group__captions--4">
          <span>Home</span><span>Mega menu — Palestinian Olive Oil</span><span>Product page — sizes &amp; per-ml pricing</span><span>All Products — filters</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="conversion-title">
    <div class="container">
      <StudyHead id="conversion-title" eyebrow="06 — Conversion, gifting & B2B" line1="Patterns for more —" line2="and bigger — orders" lead="Subscribe & Save, bundles, reviews, a build-your-own box and a free-shipping bar — plus a dedicated path for gifting and corporate orders." accent={false} />
      <ol class="study-facts study-facts--3">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">Gift tiers</h3><p class="fact__text">By budget &amp; occasion, compared side by side.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Add-ons</h3><p class="fact__text">Kufiya, dates, Nabulsi soap, tree sponsorship, gift card.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">B2B</h3><p class="fact__text">Corporate &amp; bulk gifting with custom branding and multi-address shipping.</p></li>
      </ol>
      <div class="study-pair study-pair--after">
        <figure class="study-figure">
          <StudyMedia project="alard" name="05-frequently-bought-together" desktop={[588, 447]} tablet={[704, 535]} mobile={[358, 271]} alt="AL’ARD frequently bought together: tahini paste and Medjool dates, with a 10% bundle price." />
          <figcaption>Frequently bought together.</figcaption>
        </figure>
        <figure class="study-figure">
          <StudyMedia project="alard" name="06-cart-drawer-free-shipping" desktop={[588, 447]} tablet={[704, 535]} mobile={[358, 271]} alt="The AL’ARD cart drawer with free-shipping progress and loyalty points." />
          <figcaption>Cart drawer — free-shipping progress &amp; loyalty points.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <StudyQuote
    quote="He understands the direction well, is responsive to feedback, and has been helping translate our ideas into a clearer and more user-friendly website experience."
    name="Ahmad Al-Nimr"
    role="Digital Marketing Manager, AL’ARD · Nablus, Palestine"
    initials="AN"
  />

  <section class="study-section" aria-labelledby="outcome-title">
    <div class="container">
      <StudyHead id="outcome-title" eyebrow="07 — Outcome" line1="Reviewed before a line of code —" line2="now live" accent={false} />
      <div class="study-outcome">
        <div>
          <h3>Outcome</h3>
          <p class="study-outcome__lead">I built an interactive Figma prototype before development. AL’ARD’s marketing manager reviewed it and sent back changes and new feature requests, and the SEO team audited the site — I turned both into design updates, and the redesigned US storefront is now live at alardproducts.com.</p>
        </div>
        <div>
          <h3>What I learned</h3>
          <p>A conversion redesign isn’t just a visual refresh. Business goals, real usability for a wide audience, SEO requirements, and what the dev stack could support all pulled in different directions — most of the work was making sure no single priority won at the expense of the others, while keeping the brand’s Palestinian heritage front and center.</p>
        </div>
      </div>
    </div>
  </section>

  <StudyCta title="Selling online, but losing shoppers before checkout?" text="Tell me about your store, and where people drop off." />
</article>

<StudyNext current="alard" />

</Layout>
