---
import Layout from "../../layouts/Layout.astro";
import Testimonials from "../../components/Testimonials.astro";
import NextProject from "../../components/NextProject.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "AL'ARD — Making a beautiful story easy to buy",
    "description": "A conversion-focused redesign of AL'ARD's US online store for Palestinian olive oil and heritage goods.",
    "url": "https://abdulazizabudhair.com/work/alard",
    "image": "https://abdulazizabudhair.com/assets/img/og-alard.jpg",
    "author": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "creator": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "genre": "E-commerce · Conversion redesign",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulazizabudhair.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://abdulazizabudhair.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "AL'ARD", "item": "https://abdulazizabudhair.com/work/alard" }
    ]
  }
];
---
<Layout
  title="AL'ARD — Case Study · Abdulaziz Abu Dhair"
  description="A conversion-focused redesign of AL'ARD's US online store for Palestinian olive oil and heritage goods — calmer homepage, every category one click away, and a product page rebuilt around the fold."
  path="/work/alard"
  alternate="/ar/work/alard"
  ogType="article"
  ogImage="og-alard.jpg"
  jsonLd={jsonLd}
>
<article class="case" aria-labelledby="case-title">
  <div class="container cs-hero">
    <a class="back-link text-link" href="/#work"><span aria-hidden="true">←</span> Back to portfolio</a>
    <p class="cs-hero__eyebrow">Case study · E-commerce · Conversion redesign</p>
    <h1 class="cs-hero__title" id="case-title">AL'ARD</h1>
    <p class="cs-hero__subtitle">Making a beautiful story easy to buy — a conversion-focused redesign of AL'ARD's US online store for Palestinian olive oil and heritage goods, calmer homepage, every category one click away, and a product page rebuilt around the fold.</p>
    <dl class="cs-hero__facts">
      <div><dt>My role</dt><dd>UX/UI Designer</dd></div>
      <div><dt>Platform</dt><dd>Responsive web — US storefront on Shopify</dd></div>
      <div><dt>Timeline</dt><dd>12 months · Sep 2025 – Aug 2026</dd></div>
      <div><dt>Status</dt><dd class="cs-status"><span class="work-card__dot" aria-hidden="true"></span>Redesign now live</dd></div>
    </dl>
    <nav class="cs-onthispage" aria-label="On this page">
      <span class="cs-onthispage__label">On this page</span>
      <a href="#overview">Overview</a>
      <a href="#the-problem">The problem</a>
      <a href="#navigation">Navigation</a>
      <a href="#homepage">Homepage</a>
      <a href="#product-page">Product page</a>
      <a href="#mobile">Mobile</a>
      <a href="#conversion">Conversion &amp; B2B</a>
      <a href="#outcome">Outcome</a>
    </nav>
  </div>

  <div class="container">
    <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
      <img src="/assets/img/alard-cs-hero-1040.webp" srcset="/assets/img/alard-cs-hero-1040.webp 1040w, /assets/img/alard-cs-hero-2080.webp 2080w" sizes="(min-width: 1280px) 1040px, 90vw" width="1040" height="589" fetchpriority="high" decoding="async" alt="The redesigned AL'ARD homepage for Palestinian olive oil and heritage goods.">
    </div>
  </div>

  <div class="container cs-section">
    <p class="fact-card__label">Project at a glance</p>
    <div class="cs-glance">
      <div class="fact-card"><p class="fact-card__value">US store</p><p class="fact-card__text">Desktop and mobile, built on Shopify</p></div>
      <div class="fact-card"><p class="fact-card__value">Live</p><p class="fact-card__text">Redesign live at alardproducts.com</p></div>
    </div>
  </div>

  <div class="container cs-section" id="overview">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>The challenge</div>
    <h2 class="cs-title">A beautiful story — <em>that was hard to buy</em></h2>
    <div class="cs-prose">
      <div>
        <h3>Context</h3>
        <p>AL'ARD sells Palestinian olive oil and artisan foods — heritage products tied closely to Palestinian identity. My redesign covered its US online store.</p>
      </div>
      <div>
        <h3>The brief</h3>
        <p>A conversion-focused redesign that makes shopping effortless on desktop and mobile — without diluting the brand's Palestinian heritage identity.</p>
      </div>
    </div>
  </div>

  <div class="container cs-section" id="the-problem">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>01 — The problem</div>
    <h2 class="cs-title">What made the old store hard to shop</h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">Pop-up overload</p><p class="fact-card__text">Homepages cluttered with stacked pop-ups competing for attention.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Buried navigation</p><p class="fact-card__text">Key categories hidden inside a desktop side menu.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">Below the fold</p><p class="fact-card__text">Product image, price and size options all sat below the fold.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">SEO debt</p><p class="fact-card__text">SEO audits of the store flagged structural issues.</p></div>
    </div>
    <div class="cs-eyebrow" style={{ marginTop: "32px" }}><span class="cs-eyebrow__square"></span>How I worked</div>
    <div class="cs-decisions" style={{ marginTop: "24px" }}>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">Audit</p><p class="fact-card__text">UX pain points &amp; SEO findings</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Restructure</p><p class="fact-card__text">Catalog &amp; IA around how people shop</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">Design</p><p class="fact-card__text">Desktop + mobile screens</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">Prototype</p><p class="fact-card__text">Interactive Figma prototype</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">05</p><p class="fact-card__value">Iterate</p><p class="fact-card__text">Marketing feedback, new features &amp; SEO reviews</p></div>
    </div>
  </div>

  <div class="container cs-section" id="navigation">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>02 — Key decision · Navigation &amp; IA</div>
    <h2 class="cs-title">Every category, one click away — <em>from any scroll position</em></h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">Sticky header</p><p class="fact-card__text">Primary navigation moved out of the side menu into a header that stays with the shopper.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Mega menu by intent</p><p class="fact-card__text">Shop by need, by size or by type — the way people actually decide.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">Merchandising tile</p><p class="fact-card__text">Seasonal hooks like “First Press of the Season” live right inside the menu.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">Search-first header</p><p class="fact-card__text">A wide search bar with helpful prompts: olive oil, za'atar, gift boxes.</p></div>
    </div>
    <figure style={{ marginTop: "48px" }}>
      <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
        <img src="/assets/img/alard-cs-megamenu-1104.webp" srcset="/assets/img/alard-cs-megamenu-1104.webp 1104w, /assets/img/alard-cs-megamenu-2208.webp 2208w" sizes="(min-width: 1280px) 1104px, 90vw" width="1104" height="744" loading="lazy" decoding="async" alt="AL'ARD's Palestinian Olive Oil mega menu, organized by need, size and type.">
      </div>
      <figcaption>The Palestinian Olive Oil mega menu — by need, size and type.</figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="homepage">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>03 — Key decision · Homepage</div>
    <h2 class="cs-title">A calmer homepage that sells</h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">Minimized pop-ups</p><p class="fact-card__text">One clear message at a time instead of stacked overlays.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">More products above the fold</p><p class="fact-card__text">Best sellers surface in the very first scroll.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">“Compare the Gifts”</p><p class="fact-card__text">Guides buyers by budget and occasion — Mini, Pantry, Olive Oil, Premium.</p></div>
    </div>
  </div>

  <div class="container cs-section" id="product-page">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>04 — Key decision · Product page</div>
    <h2 class="cs-title">The product page, rebuilt around the fold</h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">Gallery above the fold</p><p class="fact-card__text">Hero image and thumbnails visible without scrolling.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Title, rating &amp; proof</p><p class="fact-card__text">Halal and Harvest tags, rating and “300+ bought” up top.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">Per-unit pricing</p><p class="fact-card__text">Price per ml makes the bulk discount self-evident.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">Size variants as cards</p><p class="fact-card__text">Every size shows its own price and saving.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">05</p><p class="fact-card__value">Subscribe &amp; Save</p><p class="fact-card__text">One-time or recurring delivery in a single step.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">06</p><p class="fact-card__value">Persistent trust badges</p><p class="fact-card__text">Authentic Palestinian origin + free-shipping threshold.</p></div>
    </div>
    <figure style={{ marginTop: "48px" }}>
      <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
        <img src="/assets/img/alard-cs-productpage-1104.webp" srcset="/assets/img/alard-cs-productpage-1104.webp 1104w, /assets/img/alard-cs-productpage-2208.webp 2208w" sizes="(min-width: 1280px) 1104px, 90vw" width="1104" height="833" loading="lazy" decoding="async" alt="AL'ARD product page with gallery, tags, rating, per-ml pricing, size cards, subscribe and save, and trust badges above the fold.">
      </div>
      <figcaption>Gallery, tags, rating, per-ml pricing, size cards, subscribe &amp; save and trust badges — all above the fold.</figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="mobile">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>05 — Mobile</div>
    <h2 class="cs-title">Designed for mobile, too</h2>
    <p class="cs-lead">The key screens were designed for the phone as well — home, mega menu, product page and filters.</p>
    <div class="cs-grid cs-grid--4" style={{ "--project-tile": "var(--project-alard)", marginTop: "40px" }}>
      <figure><img src="/assets/img/alard-cs-mobile-1-216.webp" srcset="/assets/img/alard-cs-mobile-1-216.webp 216w, /assets/img/alard-cs-mobile-1-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="AL'ARD mobile homepage."><figcaption>Home</figcaption></figure>
      <figure><img src="/assets/img/alard-cs-mobile-2-216.webp" srcset="/assets/img/alard-cs-mobile-2-216.webp 216w, /assets/img/alard-cs-mobile-2-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="AL'ARD mobile mega menu for Palestinian Olive Oil."><figcaption>Mega menu — Palestinian Olive Oil</figcaption></figure>
      <figure><img src="/assets/img/alard-cs-mobile-3-216.webp" srcset="/assets/img/alard-cs-mobile-3-216.webp 216w, /assets/img/alard-cs-mobile-3-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="AL'ARD mobile product page with sizes and per-ml pricing."><figcaption>Product page — sizes &amp; per-ml pricing</figcaption></figure>
      <figure><img src="/assets/img/alard-cs-mobile-4-216.webp" srcset="/assets/img/alard-cs-mobile-4-216.webp 216w, /assets/img/alard-cs-mobile-4-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="AL'ARD mobile all-products page with filters."><figcaption>All Products — filters</figcaption></figure>
    </div>
  </div>

  <div class="container cs-section" id="conversion">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>06 — Conversion, gifting &amp; B2B</div>
    <h2 class="cs-title">Patterns for more — <em>and bigger — orders</em></h2>
    <p class="cs-lead">Subscribe &amp; Save, bundles, reviews, a build-your-own box and a free-shipping bar — plus a dedicated path for gifting and corporate orders.</p>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">Gift tiers</p><p class="fact-card__text">By budget &amp; occasion, compared side by side.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Add-ons</p><p class="fact-card__text">Kufiya, dates, Nabulsi soap, tree sponsorship, gift card.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">B2B</p><p class="fact-card__text">Corporate &amp; bulk gifting with custom branding and multi-address shipping.</p></div>
    </div>
    <div class="cs-grid cs-grid--2" style={{ marginTop: "48px" }}>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
          <img src="/assets/img/alard-cs-conv-1-524.webp" srcset="/assets/img/alard-cs-conv-1-524.webp 524w, /assets/img/alard-cs-conv-1-1048.webp 1048w" sizes="524px" width="524" height="348" loading="lazy" decoding="async" alt="AL'ARD 'frequently bought together' bundle suggestion.">
        </div>
        <figcaption>Frequently bought together.</figcaption>
      </figure>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
          <img src="/assets/img/alard-cs-conv-2-524.webp" srcset="/assets/img/alard-cs-conv-2-524.webp 524w, /assets/img/alard-cs-conv-2-1048.webp 1048w" sizes="524px" width="524" height="353" loading="lazy" decoding="async" alt="AL'ARD cart drawer with free-shipping progress and loyalty points.">
        </div>
        <figcaption>Cart drawer — free-shipping progress &amp; loyalty points.</figcaption>
      </figure>
    </div>
  </div>

  <div class="container cs-section">
    <figure class="cs-quote">
      <span class="cs-quote__mark" aria-hidden="true">&ldquo;</span>
      <blockquote><p>He understands the direction well, is responsive to feedback, and has been helping translate our ideas into a clearer and more user-friendly website experience.</p></blockquote>
      <figcaption>
        <span class="testimonial-card__avatar" aria-hidden="true">AN</span>
        <span class="testimonial-card__who"><cite>Ahmad Al-Nimr</cite><span>Digital Marketing Manager, AL'ARD · Nablus, Palestine</span></span>
      </figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="outcome">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>07 — Outcome</div>
    <h2 class="cs-title">Reviewed before a line of code — now live</h2>
    <div class="cs-outcome">
      <div>
        <h3>Outcome</h3>
        <p>I built an interactive Figma prototype before development. AL'ARD's marketing manager reviewed it and sent back changes and new feature requests, and the SEO team audited the site — I turned both into design updates, and the redesigned US storefront is now live at alardproducts.com.</p>
      </div>
      <div>
        <h3>What I learned</h3>
        <p>A conversion redesign isn't just a visual refresh. Business goals, real usability for a wide audience, SEO requirements, and what the dev stack could support all pulled in different directions — most of the work was making sure no single priority won at the expense of the others, while keeping the brand's Palestinian heritage front and center.</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="cs-cta">
      <div>
        <h2>Selling online, but losing shoppers before checkout?</h2>
        <p>Tell me about your store, and where people drop off.</p>
      </div>
      <a class="btn btn--primary btn--xl" href="/#contact">Let’s talk</a>
    </div>
  </div>
</article>

<NextProject current="alard" />

<Testimonials />

</Layout>
