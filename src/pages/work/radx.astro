---
import Layout from "../../layouts/Layout.astro";
import StudyHero from "../../components/study/StudyHero.astro";
import StudyGlance from "../../components/study/StudyGlance.astro";
import StudyHead from "../../components/study/StudyHead.astro";
import StudyMedia from "../../components/study/StudyMedia.astro";
import StudyQuote from "../../components/study/StudyQuote.astro";
import StudyCta from "../../components/study/StudyCta.astro";
import StudyNext from "../../components/study/StudyNext.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "RADX Smart Companion — An Arabic assistant that gets things done for you",
    "description": "Redesigned end to end in 5 weeks — an audit, 10 competitors and 40 screens built around one flow: ask, approve, track, get the result.",
    "url": "https://abdulazizabudhair.com/work/radx",
    "image": "https://abdulazizabudhair.com/assets/img/og-radx.jpg",
    "author": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "creator": { "@type": "Person", "name": "Abdulaziz Abu Dhair", "url": "https://abdulazizabudhair.com/" },
    "genre": "AI assistant · Mobile app",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulazizabudhair.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://abdulazizabudhair.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "RADX Smart Companion", "item": "https://abdulazizabudhair.com/work/radx" }
    ]
  }
];
---
<Layout
  title="RADX Smart Companion — Case Study · Abdulaziz Abu Dhair"
  description="Redesigned end to end in 5 weeks — an audit of the old app, 10 competitors analyzed, and 40 screens built around one flow: ask, approve, track, get the result — on an Arabic-first design system in two themes."
  path="/work/radx"
  alternate="/ar/work/radx"
  ogType="article"
  ogImage="og-radx.jpg"
  jsonLd={jsonLd}
  study
>
<article class="study" aria-labelledby="case-title">
  <StudyHero
    project="radx"
    eyebrow="Case study · AI assistant · Mobile app"
    title="RADX Smart Companion"
    subtitle="An Arabic assistant that gets things done for you"
    lead="Redesigned end to end in 5 weeks: an audit of the old app, 10 competitors analyzed, and 40 screens built around one flow — ask, approve, track, get the result — on an Arabic-first design system in two themes."
    facts={[
      { label: "My role", value: "UX/UI Designer, end-to-end" },
      { label: "Platform", value: "iOS & Android app, Arabic UI, light & dark themes" },
      { label: "Timeline", value: "5 weeks · Oct – Nov 2026" },
      { label: "Status", value: "Live on the App Store & Google Play", status: true },
    ]}
    coverAlt="Three RADX App Store screens: Ask. RADX gets it done; Nothing happens without your OK; Booked, confirmed, reminded."
  />

  <StudyGlance label="Project scope & delivery" tabletRow items={[
    { label: "Duration", value: "5 weeks", text: "From audit to developer-ready prototype" },
    { label: "Audit", value: "86", text: "Findings in the audit of the old app" },
    { label: "Competitors", value: "10", text: "Competitors analyzed" },
    { label: "Screens", value: "40", text: "Screens built around one flow" },
  ]} />

  <section class="study-section study-overview" aria-labelledby="overview-title">
    <div class="container study-overview__grid">
      <div class="study-overview__head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>The challenge</p>
        <h2 class="study-overview__title" id="overview-title">An assistant people<br>can trust to act.</h2>
      </div>
      <div class="study-overview__body">
        <div>
          <h3>Context</h3>
          <p>A UX and UI redesign of RADX Smart Companion, the AI assistant that books and gets tasks done on the user’s behalf. From an audit of the existing app to an Arabic design system and a developer-ready prototype, in 5 weeks.</p>
        </div>
        <div>
          <h3>What I did</h3>
          <p>Audited the app (86 findings), analyzed 10 competitors, and built 40 screens around one flow: ask, approve, track, get the result.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="flow-title">
    <div class="container">
      <StudyHead id="flow-title" eyebrow="01 — The core flow" line1="Ask, approve, track," line2="get the result" lead="Users only trust an assistant that acts for them when they can see what it will do — and say yes before it does." accent={false} />
      <figure class="study-figure">
        <StudyMedia project="radx" name="02-core-flow" desktop={[1200, 674]} tablet={[704, 395]} mobile={[358, 211]} alt="The RADX booking flow in four Arabic screens, right to left: review the request, approve the action, track progress, receive confirmation." />
        <ol class="study-steps">
          <li><span>Step 1</span>Review request</li>
          <li><span>Step 2</span>Approve action</li>
          <li><span>Step 3</span>Track progress</li>
          <li><span>Step 4</span>Receive confirmation</li>
        </ol>
        <figcaption><span class="study-only-desktop">Booking flow, step by step — the interface is Arabic, so the steps read right to left.</span><span class="study-only-compact">Booking flow, step by step. The interface is Arabic, so the phones run right to left — step 1 is on the far right.</span></figcaption>
      </figure>
      <div class="study-pair study-pair--after">
        <figure class="study-figure">
          <StudyMedia project="radx" name="03-approval" desktop={[588, 537]} tablet={[704, 643]} mobile={[358, 394]} alt="RADX asks for approval before booking, beside the hotel booking awaiting payment." />
          <figcaption>Approval before anything is booked — and the hotel result.</figcaption>
        </figure>
        <figure class="study-figure">
          <StudyMedia project="radx" name="04-voice" desktop={[588, 537]} tablet={[704, 643]} mobile={[358, 394]} alt="RADX voice input: the assistant listening, and the assistant speaking." />
          <figcaption>Listening and voice input.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="system-title">
    <div class="container">
      <StudyHead id="system-title" eyebrow="02 — Design system" line1="An Arabic-first system," line2="in two themes" accent={false} />
      <div class="study-split">
        <figure class="study-figure">
          <StudyMedia project="radx" name="05-design-system-foundations" desktop={[588, 540]} tablet={[704, 647]} mobile={[358, 329]} alt="RADX design system foundations: the same Arabic chat components in the dark and the light theme." />
          <figcaption>Design system foundations.</figcaption>
        </figure>
        <div class="study-split__col">
          <figure class="study-figure">
            <StudyMedia project="radx" name="06-app-map" desktop={[588, 340]} tablet={[704, 407]} mobile={[358, 205]} alt="RADX app map." />
            <figcaption>App map.</figcaption>
          </figure>
          <figure class="study-figure">
            <StudyMedia project="radx" name="07-journey-booking" desktop={[588, 223]} tablet={[704, 267]} mobile={[358, 133]} alt="RADX booking journey map." />
            <figcaption>Journey — booking.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="store-title">
    <div class="container">
      <div class="study-head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>03 — Store presence</p>
        <h2 class="study-head__title" id="store-title">Live on the App Store<br>and Google Play</h2>
        <div class="study-store-links">
          <a class="btn btn--outline btn--lg" href="https://apps.apple.com/il/app/radx-smart-companion/id6762611427" target="_blank" rel="noopener">App Store <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="visually-hidden"> (opens in a new tab)</span></a>
          <a class="btn btn--outline btn--lg" href="https://play.google.com/store/apps/details?id=ae.radx.agent" target="_blank" rel="noopener">Google Play <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
      </div>
      <div class="study-split study-split--store">
        <figure class="study-figure study-figure--tight">
          <StudyMedia project="radx" name="08-app-store-set" desktop={[792, 372]} tablet={[704, 331]} mobile={[358, 169]} alt="The RADX App Store screenshot set: five screens from ask to booked." />
          <figcaption>App Store screenshot set.</figcaption>
        </figure>
        <div class="study-split__col">
          <figure class="study-figure study-figure--tight">
            <StudyMedia project="radx" name="09-google-play-feature-graphic" desktop={[384, 212]} tablet={[340, 188]} mobile={[358, 187]} alt="The RADX Google Play feature graphic: Ask. RADX gets it done, with the falcon." />
            <figcaption>Google Play feature graphic.</figcaption>
          </figure>
          <figure class="study-figure study-figure--tight">
            <StudyMedia project="radx" name="10-app-icon" desktop={[384, 123]} tablet={[340, 109]} mobile={[358, 115]} alt="The RADX app icon with the Emirati falcon." />
            <figcaption>App icon.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <StudyQuote
    quote="Abdulaziz redesigned the RADX app end to end. He quickly understood our vision and turned it into a clear Arabic-first experience that makes users trust an assistant acting on their behalf. He met every deadline and backed each decision with a reason, which made approvals fast."
    name="Mansour Marzouk"
    role="Founder, RADX · Dubai, UAE"
    initials="MM"
  />

  <section class="study-section" aria-labelledby="outcome-title">
    <div class="container">
      <StudyHead id="outcome-title" eyebrow="04 — Outcome" line1="Approved on time — and now live" />
      <div class="study-outcome study-outcome--rows">
        <div>
          <h3>Outcome</h3>
          <p class="study-outcome__lead">Every phase was approved on or before its deadline, and the dev team started building from the approved screens before the project ended. I reviewed the TestFlight build against the designs and gave the team my feedback before release. RADX is now live on the App Store and Google Play.</p>
        </div>
        <div>
          <h3>Credits</h3>
          <p>Falcon concept &amp; illustration: a design team chosen by RADX’s founder. Original falcon animation: the RADX dev team. Emirati falcon: the character design team — its Rive animation is still in progress.</p>
        </div>
        <div>
          <h3>After delivery · Sign-in</h3>
          <p>After delivery, the client made WhatsApp a required part of sign-in. The login flow is updated to match.</p>
        </div>
        <div>
          <h3>After delivery · Character</h3>
          <p>After delivery, the client asked for a falcon that expresses UAE identity more. The character design team drew a new Emirati falcon, and it shipped with the launch. The seven states and the interface stayed the same; the new falcon’s Rive animation is still in progress.</p>
          <div class="study-falcons">
            <figure><img src="/assets/case-study/radx/11-falcon-before.webp" width="96" height="96" loading="lazy" decoding="async" alt="The original RADX falcon app icon."><figcaption>Before</figcaption></figure>
            <figure><img src="/assets/case-study/radx/11-falcon-after.webp" width="96" height="96" loading="lazy" decoding="async" alt="The new Emirati falcon app icon, live."><figcaption>After · live</figcaption></figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <StudyCta title="Building an AI product people need to trust?" text="Tell me what it does for users, and where it should ask first." />
</article>

<StudyNext current="radx" />

</Layout>
