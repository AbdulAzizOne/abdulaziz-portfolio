    "url": "https://abdulazizabudhair-portfolio.vercel.app/work/radx",
    "image": "https://abdulazizabudhair-portfolio.vercel.app/assets/img/radx/radx-themes.webp",
    "author": {
      "@type": "Person",
      "name": "Abdulaziz Abu Dhair",
      "url": "https://abdulazizabudhair-portfolio.vercel.app/"
    },
    "creator": {
      "@type": "Person",
      "name": "Abdulaziz Abu Dhair",
      "url": "https://abdulazizabudhair-portfolio.vercel.app/"
    },
    "genre": "AI assistant, iOS",
    "inLanguage": "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://abdulazizabudhair-portfolio.vercel.app/"
