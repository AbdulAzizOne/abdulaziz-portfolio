---
import Layout from "../../../../layouts/Layout.astro";
import Testimonials from "../../../../components/Testimonials.astro";
import NextProject from "../../../../components/NextProject.astro";

const img = (name: string, w: number) => `/assets/img/radx/radx-a-${name}-${w}.webp`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "RADX — مساعد عربي لا يكتفي بالإجابة، بل ينفّذ عنك",
    "description": "إعادة تصميم تجربة وواجهة تطبيق RADX، المساعد الذكي الذي يحجز وينجز المهام باسم المستخدم: تدقيق، وعشرة منافسين، ومخطط 40 شاشة، ونظام تصميم عربي، وبروتوتايب جاهز للمطورين في 5 أسابيع.",
    "url": "https://abdulazizabudhair.com/ar/work/radx/assistant",
    "image": "https://abdulazizabudhair.com/assets/img/radx/radx-a-hero-1368.webp",
    "author": {
      "@type": "Person",
      "@id": "https://abdulazizabudhair.com/#person",
      "name": "عبدالعزيز أبو ضهير",
      "url": "https://abdulazizabudhair.com/ar"
    },
    "genre": "مساعد ذكي، تطبيق جوال",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الأعمال", "item": "https://abdulazizabudhair.com/ar#case-studies" },
      { "@type": "ListItem", "position": 3, "name": "RADX", "item": "https://abdulazizabudhair.com/ar/work/radx/assistant" }
    ]
  }
];
---
<Layout
  title="RADX — دراسة حالة · عبدالعزيز أبو ضهير"
  description="إعادة تصميم تجربة وواجهة تطبيق RADX، المساعد الذكي الذي يحجز وينجز المهام باسم المستخدم: من تدقيق التطبيق إلى نظام تصميم عربي وبروتوتايب جاهز للمطورين، في 5 أسابيع."
  path="/ar/work/radx/assistant"
  alternate="/work/radx/assistant"
  lang="ar"
  ogType="article"
  jsonLd={jsonLd}
>
<article class="band band--light case" aria-labelledby="case-title">
  <div class="container">
    <a class="back-link" href="/ar#case-studies"><span aria-hidden="true">→</span> العودة إلى الأعمال</a>
    <header>
      <p class="case__eyebrow">دراسة حالة · ذكاء اصطناعي · تطبيق جوال</p>
      <h1 class="case__title" id="case-title">RADX <span>مساعد عربي لا يكتفي بالإجابة، بل ينفّذ عنك</span></h1>
      <p class="status-pill">قيد التنفيذ · مرحلة البروتوتايب</p>
      <dl class="case__meta case__meta--4">
        <div><dt>الدور</dt><dd>مصمم UX/UI، تجربة وواجهة التطبيق من البداية للنهاية</dd></div>
        <div><dt>المنصة</dt><dd>تطبيق جوال iOS وأندرويد، واجهة عربية بثيمين</dd></div>
        <div><dt>الأدوات</dt><dd><bdi>Figma · Dev Mode</bdi> وأدوات ذكاء اصطناعي</dd></div>
        <div><dt>المدة</dt><dd>5 أسابيع · أكتوبر ونوفمبر 2026</dd></div>
      </dl>
    </header>

    <div class="case__media">
      <img src={img("hero", 1368)} srcset={`${img("hero", 1368)} 1368w, ${img("hero", 2736)} 2736w`} sizes="(min-width: 1448px) 1368px, 94vw" width="2736" height="1400" fetchpriority="high" decoding="async" alt="الصفحة الرئيسية لتطبيق RADX بالثيمين الفاتح والداكن: الصقر اللؤلؤي يرحّب بالمستخدم، وتحته آخر المهام والمهام المقترحة.">
    </div>

    <ul class="stats" aria-label="نظرة سريعة">
      <li><b>5</b><span>أسابيع من التدقيق إلى التسليم</span></li>
      <li><b>40</b><span>شاشة في مخطط المنتج</span></li>
      <li><b>86</b><span>ملاحظة في تدقيق التطبيق</span></li>
      <li><b>10</b><span>منافسين حلّلتهم</span></li>
    </ul>

    <div class="case__body">
      <div class="prose">
        <h2>التحدي</h2>
        <p>تطبيق يقدّم نفسه كمرشد صوتي، والمطلوب وكيل يتصرف باسم المستخدم ويكسب ثقته.</p>
        <h2>ما فعلته</h2>
        <p>دققت التطبيق (86 ملاحظة)، وحلّلت 10 منافسين، وبنيت 40 شاشة حول مسار واحد: اطلب، وافق، تابع، استلم النتيجة.</p>
      </div>
      <div class="prose">
        <h2>النتيجة</h2>
        <p>اعتُمدت كل مرحلة في موعدها أو قبله، وبدأ فريق التطوير البرمجة من الشاشات المعتمدة قبل نهاية المشروع.</p>
      </div>
    </div>

    <!-- 01 Context -->
    <section class="cs-section" aria-labelledby="s-context">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">01 — السياق</p>
          <h2 class="cs-title" id="s-context">فرصة أول وكيل ذكي عربي في المنطقة</h2>
        </div>
        <p class="cs-lead">شركة RADX ناشئة في دبي، تبني مساعداً ذكياً للمستخدم العربي في الخليج. الفكرة بسيطة: تطلب بصوتك أو بالكتابة، فيبحث المساعد ويحجز ويتواصل باسمك عبر واتساب أو الاتصال، ثم يعود إليك بالنتيجة.</p>
      </div>
      <div class="case__body">
        <div class="prose">
          <p>الحجز هو قلب المنتج: مطاعم وفنادق وأنشطة ومواعيد وتذاكر. والوكلاء العالميون المشابهون إما محصورون في السوق الأمريكية أو في اشتراكات مدفوعة، فكانت الفرصة أن يكون المساعد الوكيل العربي الأول في المنطقة.</p>
        </div>
        <div class="collections" style="margin-top:0">
          <div>
            <h3>مجالات الحجز</h3>
            <ul><li>مطاعم</li><li>فنادق</li><li>أنشطة</li><li>مواعيد</li><li>تذاكر</li></ul>
          </div>
          <div>
            <h3>قنوات التواصل</h3>
            <ul><li>واتساب</li><li>اتصال</li></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Problem -->
    <section class="cs-section" aria-labelledby="s-problem">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">02 — المشكلة</p>
          <h2 class="cs-title" id="s-problem">التطبيق كان مرشداً يجيب، لا وكيلاً ينفّذ</h2>
        </div>
        <p class="cs-lead">دققتُ التطبيق الحالي شاشةً شاشة قبل أي تصميم. هذه أرقام التدقيق وأهم ما ظهر فيه.</p>
      </div>
      <ul class="stats stats--3" aria-label="التدقيق">
        <li><b>19</b><span>شاشة وحالة مراجَعة</span></li>
        <li><b>86</b><span>ملاحظة في التدقيق</span></li>
        <li><b>9</b><span>ملاحظات حرجة</span></li>
      </ul>
      <p class="stats-note">من الـ 86: 9 حرجة، و52 متوسطة، و25 تحسيناً.</p>

      <div class="cs-split">
        <figure class="cs-split__media">
          <img src={img("before-after", 548)} srcset={`${img("before-after", 548)} 548w, ${img("before-after", 1096)} 1096w`} sizes="(min-width: 721px) 46vw, 94vw" width="1096" height="1084" loading="lazy" decoding="async" alt="الصفحة الرئيسية قبل وبعد: شاشة صوتية فقط مع روبوت على اليمين، والرئيسية الجديدة مع الصقر وآخر المهام والمهام المقترحة على اليسار.">
          <figcaption class="stats-note">قبل (يمين) وبعد (يسار).</figcaption>
        </figure>
        <ol class="cs-list" style="margin-top:0">
          <li><strong>تفاعل غامض</strong><span>صوت فقط، بلا محادثة نصية ولا سجل، فلا يعرف المستخدم ماذا سمع المساعد أو ماذا فعل.</span></li>
          <li><strong>القيمة الأساسية مخفية</strong><span>الحجز، جوهر الرؤية، كان مقفلاً خلف شارة مستوى.</span></li>
          <li><strong>بداية طويلة</strong><span>الدخول والتعريف والإعدادات طويلة ومكررة قبل أول قيمة حقيقية.</span></li>
          <li><strong>عربية ناقصة</strong><span>التعريب واتجاه الكتابة من اليمين غير مكتملين في تطبيق موجّه لمستخدم عربي.</span></li>
          <li><strong>هوية مشتتة</strong><span>خمس رسائل مختلفة للعلامة، وثيم داكن فقط.</span></li>
        </ol>
      </div>

      <div class="case__body">
        <div class="prose">
          <h2>ولا متطلب واحد متحقق بالكامل</h2>
          <p>قست التطبيق الحالي على 13 متطلباً من وثيقة الرؤية وبنود الاتفاق: 8 متحققة جزئياً، و5 غير متحققة، ولا متطلب متحقق بالكامل.</p>
        </div>
        <div class="prose">
          <h2>ما حافظنا عليه</h2>
          <ul>
            <li>اختيار اللهجة مع أمثلة حيّة، وهي ميزة تنافسية في السوق العربي.</li>
            <li>طلب الأذونات عند الحاجة فقط، مع شرح السبب.</li>
            <li>بنية تنقّل بسيطة من أربعة تبويبات.</li>
            <li>هوية داكنة بلمسات ذهبية، وشخصية مرئية يسهل تذكّرها.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 Role -->
    <section class="cs-section" aria-labelledby="s-role">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">03 — دوري</p>
          <h2 class="cs-title" id="s-role">مصمم واحد لتجربة التطبيق وواجهته</h2>
        </div>
        <p class="cs-lead">المصمم الوحيد لتجربة وواجهة التطبيق، من التدقيق والبحث إلى الشاشات ونظام التصميم والبروتوتايب وتسليم المطورين.</p>
      </div>
      <blockquote class="pull-quote">
        <p>«كيف يثق المستخدم بمساعد يتصرف باسمه، ويعرف في كل لحظة ماذا يفعل؟»</p>
        <footer>سؤال التصميم</footer>
      </blockquote>

      <h3 class="cs-h3">مبادئ التصميم</h3>
      <ul class="features features--4 features--numbered">
        <li><strong>من الجواب إلى الفعل</strong><span>كل إجابة تنتهي بزر «نفّذها لي»، فيتحوّل الحديث إلى مهمة.</span></li>
        <li><strong>لا تواصل قبل الموافقة</strong><span>لا يتصل المساعد بأحد قبل موافقة صريحة من المستخدم.</span></li>
        <li><strong>حالة واحدة واضحة</strong><span>16 حالة تقنية صارت حالة واحدة للمساعد، وست حالات للمهام.</span></li>
        <li><strong>الطلب لا يضيع</strong><span>إذا انقطع الاتصال يبقى الطلب محفوظاً ولا يضطر المستخدم لإعادته.</span></li>
      </ul>

      <h3 class="cs-h3">القيود</h3>
      <ul class="features features--4">
        <li><strong>الوقت</strong><span>5 أسابيع لـ 40 شاشة، بجولة مراجعة واحدة لكل مرحلة.</span></li>
        <li><strong>اللغة</strong><span>واجهة عربية فقط: العربية هي الأصل وليست ترجمة.</span></li>
        <li><strong>الشخصية</strong><span>تغيّرت الشخصية في الأسبوع الأول من روبوت إلى «الصقر اللؤلؤي»، الذي صمّمه فريق تصميم اختاره مؤسس RADX.</span></li>
        <li><strong>التطوير</strong><span>المطورون يبنون بالتوازي بـ <bdi>React Native/Expo</bdi>.</span></li>
      </ul>
    </section>

    <!-- 04 Process -->
    <section class="cs-section" aria-labelledby="s-process">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">04 — العملية</p>
          <h2 class="cs-title" id="s-process">أربع مراحل، واعتماد قبل كل انتقال</h2>
        </div>
        <p class="cs-lead">كل مرحلة بجولة مراجعة واحدة، ولا ننتقل للتالية قبل اعتمادها.</p>
      </div>
      <ol class="steps steps--4" aria-label="المراحل">
        <li><strong>الاستراتيجية</strong><span>الأسبوع 1 · تدقيق التطبيق (86 ملاحظة)، وتحليل 10 منافسين، ومخطط 40 شاشة</span><small>اعتُمدت 10 أكتوبر</small></li>
        <li><strong>نظام التصميم</strong><span>الأسبوع 2 · ثلاثة اتجاهات بصرية، ونسختان للثيم، والرئيسية والمحادثة</span><small>اعتُمد 19 أكتوبر</small></li>
        <li><strong>شاشات التطبيق</strong><span>الأسبوعان 3 و4 · التعريف والكاميرا والخريطة، والحجز والحساب، وحالات النظام</span><small>سُلّمت 31 أكتوبر</small></li>
        <li><strong>البروتوتايب</strong><span>الأسبوع 5 · بروتوتايب تفاعلي، ومراجعة نهائية، وتسليم المطورين، وأصول المتجرين والفيديو الترويجي</span><small>جارٍ الآن</small></li>
      </ol>
      <div class="cs-callout">
        <strong>لحظة مفصلية في الأسبوع الثاني</strong>
        <p>قدّمتُ ثلاثة اتجاهات بصرية، فرُفض الاتجاه الكحلي الأول، واختار العميل اتجاه «اللؤلؤي والفحمي». بنيتُ نظام التصميم عليه، واعتُمد قبل موعده بيوم.</p>
      </div>
    </section>

    <!-- 05 Research -->
    <section class="cs-section" aria-labelledby="s-research">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">05 — البحث</p>
          <h2 class="cs-title" id="s-research">عشرة مراجع، وخمسة أنماط صارت توقّعات المستخدم</h2>
        </div>
        <p class="cs-lead">درستُ كيف تصمّم التطبيقات الأقرب لـ RADX الصوتَ والشخصية وتنفيذ المهام والحجز والخريطة والعربية، لنأخذ ما ثبت نجاحه ونتجنب ما فشل، ونحدّد أين يتميز RADX.</p>
      </div>
      <h3 class="cs-h3">المراجع العشرة</h3>
      <ul class="features features--5">
        <li><strong>Copilot (Mico)</strong><span>مساعد بشخصية مرئية</span><small>الشخصية</small></li>
        <li><strong>Gemini Live</strong><span>مساعد صوتي بالكاميرا</span><small>الصوت والكاميرا</small></li>
        <li><strong>ChatGPT Voice</strong><span>مساعد صوتي ومحادثة</span><small>الصوت</small></li>
        <li><strong>ChatGPT Dots</strong><span>وكيل دائم يعمل في الخلفية</span><small>رئيسي</small></li>
        <li><strong>Meta Muse</strong><span>وكيل شخصي ينفّذ المهام</span><small>رئيسي</small></li>
        <li><strong>Booking · OpenTable</strong><span>تطبيقات حجز</span><small>أنماط الحجز</small></li>
        <li><strong>HUMAIN Chat</strong><span>مساعد عربي</span><small>العربية واللهجات</small></li>
        <li><strong>Mindtrip</strong><span>تخطيط رحلات</span><small>الرحلة</small></li>
        <li><strong>Google Maps</strong><span>خرائط بالذكاء الاصطناعي</span><small>الخريطة</small></li>
        <li><strong>AI Mode · Ask for Me</strong><span>حجز واتصال بالنيابة</span><small>الحجز</small></li>
      </ul>

      <h3 class="cs-h3">خمسة أنماط مشتركة</h3>
      <ol class="cs-list">
        <li><strong>الصوت صار داخل المحادثة</strong><span><bdi>ChatGPT</bdi> و<bdi>Gemini</bdi> تركا الشاشة الصوتية المنفصلة: الكلام والكتابة والبطاقات في مكان واحد.</span></li>
        <li><strong>الموافقة قبل الفعل الحساس</strong><span><bdi>Muse</bdi> و<bdi>Dots</bdi> و<bdi>Ask for Me</bdi> لا ينفّذون فعلاً حساساً قبل موافقة واضحة، وهذا صار توقّع المستخدم.</span></li>
        <li><strong>الشفافية تبني الثقة</strong><span>سجل نشاط، وإفصاح عند الاتصال، وحالة مرئية لكل مهمة. المستخدم يريد أن يعرف ماذا يحدث باسمه.</span></li>
        <li><strong>الوكيل يعمل في الخلفية</strong><span>يكمل العمل بعد إغلاق التطبيق، ويعود بإشعار عند النتيجة أو الحاجة لقرار.</span></li>
        <li><strong>الشخصية تخدم الحالة</strong><span><bdi>Mico</bdi> و<bdi>Jolly</bdi> ينجحان حين يعبّران عمّا يحدث، ويزعجان حين يقاطعان.</span></li>
      </ol>

      <h3 class="cs-h3">أين يتميّز RADX</h3>
      <ul class="features features--4">
        <li><strong>شخصية لها معنى</strong><span>تعابير الصقر مرتبطة بحالات RADX، فيصبح أداة وضوح لا زينة.</span></li>
        <li><strong>حجز يكتمل داخل التطبيق</strong><span>بدل التحويل لمواقع أخرى، يصل RADX إلى التأكيد ويُبقي التفاصيل في مكان واحد.</span></li>
        <li><strong>واتساب أولاً، ثم اتصال</strong><span>رحلة تناسب طريقة تعامل المحلات في المنطقة، تُعرض كخط زمني شفاف.</span></li>
        <li><strong>وكيل عربي في الخليج</strong><span><bdi>Muse</bdi> متاح في أمريكا فقط، و<bdi>Dots</bdi> لاشتراكات العمل، والمساعدات العربية الحالية للمحادثة لا للتنفيذ.</span></li>
      </ul>
    </section>

    <!-- 06 Structure -->
    <section class="cs-section" aria-labelledby="s-structure">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">06 — الهيكل</p>
          <h2 class="cs-title" id="s-structure">40 شاشة في تسع مجموعات وثماني رحلات</h2>
        </div>
        <p class="cs-lead">قبل أي شاشة رسمتُ خريطة التطبيق كاملة: الهيكل والتنقل، ثم الشاشات الأربعين في مجموعاتها، ثم رحلات المستخدم التي تربط كل شاشة بهدفها والقرارات المقترحة مع أسبابها.</p>
      </div>
      <div class="collections">
        <div>
          <h3>مجموعات الشاشات</h3>
          <ul>
            <li>الدخول والتعريف · 6</li><li>الرئيسية · 4</li><li>المحادثة · 5</li>
            <li>الحجز والمهام · 9</li><li>الخريطة · 4</li><li>الكاميرا · 3</li>
            <li>الحساب · 4</li><li>حالات النظام · 2</li><li>تخطيط الرحلة · 3</li>
          </ul>
        </div>
        <div>
          <h3>رحلات المستخدم</h3>
          <ul>
            <li>الدخول والتعريف</li><li>المحادثة: الكتابة والصوت</li><li>الحجز والمهام</li><li>تخطيط الرحلة</li>
            <li>الخريطة</li><li>الكاميرا</li><li>الحساب</li><li>حالات النظام</li>
