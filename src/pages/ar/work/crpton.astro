---
import Layout from "../../../layouts/Layout.astro";
import Testimonials from "../../../components/Testimonials.astro";
import NextProject from "../../../components/NextProject.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "Crpton — نقل نظام العيادات من جهاز المكتب إلى أي جهاز",
    "description": "إعادة بناء نظام عيادات كان حبيس أجهزة المكتب ليصبح تطبيق ويب مع تطبيق جوال مرافق — سجلات المرضى، ومخطط الأسنان، وخطط العلاج، والفواتير.",
    "url": "https://abdulazizabudhair.com/ar/work/crpton",
    "image": "https://abdulazizabudhair.com/assets/img/og-crpton.jpg",
    "author": {
      "@type": "Person",
      "@id": "https://abdulazizabudhair.com/#person",
      "name": "عبدالعزيز أبو ضهير",
      "url": "https://abdulazizabudhair.com/ar"
    },
    "genre": "الرعاية الصحية، إدارة العيادات",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الأعمال", "item": "https://abdulazizabudhair.com/ar#case-studies" },
      { "@type": "ListItem", "position": 3, "name": "Crpton", "item": "https://abdulazizabudhair.com/ar/work/crpton" }
    ]
  }
];
---
<Layout
  title="Crpton — دراسة حالة · عبدالعزيز أبو ضهير"
  description="إعادة بناء نظام عيادات كان حبيس أجهزة المكتب ليصبح تطبيق ويب مع تطبيق جوال مرافق — سجلات المرضى، ومخطط الأسنان، وخطط العلاج، والفواتير."
  path="/ar/work/crpton"
  alternate="/work/crpton"
  lang="ar"
  ogType="article"
  ogImage="og-crpton.jpg"
  jsonLd={jsonLd}
>
<article class="band band--light case" aria-labelledby="case-title">
    <div class="container">
      <a class="back-link" href="/ar#case-studies"><span aria-hidden="true">→</span> العودة إلى الأعمال</a>
      <header>
        <p class="case__eyebrow">الرعاية الصحية · إدارة العيادات</p>
        <h1 class="case__title" id="case-title">Crpton <span>نقل نظام العيادات من جهاز المكتب إلى أي جهاز</span></h1>
        <dl class="case__meta">
          <div><dt>الدور</dt><dd>مصمم UX/UI، المصمم الوحيد من البداية إلى النهاية</dd></div>
          <div><dt>المنصة</dt><dd>تطبيق ويب + تطبيق جوال مرافق</dd></div>
          <div><dt>الأدوات</dt><dd>Figma</dd></div>
        </dl>
      </header>

      <div class="case__media">
        <img src="/assets/img/crpton-1-1368.webp" srcset="/assets/img/crpton-1-1368.webp 1368w, /assets/img/crpton-1-2736.webp 2736w" sizes="(min-width: 1448px) 1368px, 94vw" width="2736" height="1778" fetchpriority="high" decoding="async" alt="تطبيق Crpton على الويب: تبويب الحسابات المالية لمريض، ويعرض إجمالي الرسوم والدفعات والتأمين والرصيد، مع قائمة قابلة للتوسيع بالعلاجات وتوزيع الدفعات.">
      </div>

      <div class="case__body">
        <div class="prose">
          <h2>السياق</h2>
          <p>كان Crpton برنامجًا لإدارة العيادات يُثبَّت على أجهزة الكمبيوتر المكتبية في عيادات الأطباء والمراكز الطبية — يدير المرضى وخطط العلاج والفواتير. وكونه مرتبطًا بجهاز المكتب يعني أنه يعيش على جهاز واحد، في غرفة واحدة.</p>
          <h2>المشكلة</h2>
          <p>حين يتعطّل شيء، لم يكن هناك حل سهل. فإما أن يُرسل الدعم الفني شخصًا إلى العيادة، أو يرشد الطبيب عبر مشاركة الشاشة في منتصف يوم العمل — حل بطيء ومُربك، ويعتمد على أن يكون الطبيب متفرغًا له. ولم يكن بالإمكان الوصول إلى البرنامج إلا من ذلك الجهاز، حتى لإلقاء نظرة سريعة بين مريضين.</p>
          <h2>دوري</h2>
          <p>مصمم UX/UI، ومسؤول وحدي عن تصميم Crpton الجديد من البداية إلى النهاية — منصة الويب وتطبيق الجوال المرافق لها — من الصفر.</p>
        </div>
        <div class="prose">
          <h2>القرارات الأساسية</h2>
          <ul>
            <li>أعدتُ تصميم Crpton كتطبيق ويب يعمل من المتصفح بدل برنامج مثبّت على جهاز المكتب، ليستطيع الطبيب — أو الدعم الفني — فتحه من أي جهاز وفي أي مكان، دون زيارة ميدانية أو جلسة مشاركة شاشة.</li>
            <li>صمّمتُ تطبيق جوال مرافقًا بصفحة رئيسية مختصرة (المواعيد، والتذكيرات، والتحليلات) وقائمة «<bdi>Hub</bdi>» للوصول السريع، ليطمئن الطبيب على العيادة دون أن يكون على مكتبه أصلًا.</li>
            <li>جمعتُ سجل كل مريض في ملف واحد بتبويبات — General وDental وFinance وMedical وX-Ray وPrescription وReports وLab — فلا يضطر الطبيب إلى مغادرة ملف المريض لمجرد مراجعة الفواتير أو التاريخ المرضي.</li>
            <li>صمّمتُ مخطط أسنان تفاعليًا لتخطيط العلاج: يضغط الطبيب على السن، ويحدد الإجراء، فينتقل مباشرة إلى خطة علاج مسعّرة — ليصبح المخطط الذي يُعبّأ عادةً يدويًا سريعًا بما يكفي لاستخدامه بجانب كرسي المريض.</li>
            <li>صمّمتُ عرضًا ماليًا كاملًا لكل مريض — الرسوم والدفعات والتأمين والرصيد — إلى جانب تحليلات مصاريف العيادة كلها، لتكون الفواتير ومالية العيادة في نظام واحد بدل جدول بيانات أو برنامج محاسبة منفصل.</li>
            <li>أضفتُ أوضاع الإضاءة الفاتح والداكن والتلقائي، مع إمكانية تكبير النص، لأن العيادات تعمل تحت إضاءات مختلفة، ولأن الطاقم من أعمار متفاوتة يقضون مناوبات طويلة أمام الشاشة.</li>
          </ul>
        </div>
      </div>

      <div class="media-row media-row--crpton">
        <img src="/assets/img/crpton-2-850.webp" srcset="/assets/img/crpton-2-850.webp 850w, /assets/img/crpton-2-1701.webp 1701w" sizes="(min-width: 1448px) 873px, (min-width: 721px) 60vw, 94vw" width="1701" height="1024" loading="lazy" decoding="async" alt="تبويب الأسنان في Crpton: مخطط أسنان تفاعلي عليه الإجراءات المحددة، بجانب خطة العلاج والعلاجات المتكررة.">
        <img src="/assets/img/crpton-3-482.webp" srcset="/assets/img/crpton-3-482.webp 482w, /assets/img/crpton-3-965.webp 965w" sizes="(min-width: 1448px) 495px, (min-width: 721px) 34vw, 94vw" width="965" height="1024" loading="lazy" decoding="async" alt="الصفحة الرئيسية لتطبيق Crpton على الجوال بالوضعين الفاتح والداكن، وتعرض سير العمل والمواعيد.">
      </div>

      <div class="case__body">
        <div class="prose">
          <h2>النتيجة</h2>
          <p>Crpton يعمل اليوم ويُستخدم يوميًا في عيادات حقيقية — ليس تجربة أولية ولا نسخة تجريبية، بل النظام الذي يدير به الأطباء وطواقمهم يومهم فعلًا.</p>
        </div>
        <div class="prose">
          <h2>ما تعلّمته</h2>
          <p>أخرجني هذا المشروع من حدود تصميم الواجهات وحده. فلكي أصمّم خطط علاج ومسارات تأمين وفواتير عيادات تصمد في الاستخدام الحقيقي، كان عليّ أن أقرأ في طب الأسنان والمحاسبة بما يكفي لأفكّر كما يفكر من يستخدمون النظام كل يوم، لا أن أكتفي بتجميل الشاشات لهم.</p>
          <p>وهذه العادة — أن أتعلّم المجال قبل أن أثق بحدسي التصميمي — كانت أنفع ما خرجتُ به من Crpton، وهي العدسة التي أنظر بها اليوم إلى أي مجال متخصص لا أعرفه.</p>
        </div>
      </div>
    </div>
  </article>

<NextProject current="crpton" lang="ar" />

<Testimonials band="light" lang="ar" />

</Layout>
