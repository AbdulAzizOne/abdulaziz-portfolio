---
import Layout from "../../../layouts/Layout.astro";
import StudyHero from "../../../components/study/StudyHero.astro";
import StudyGlance from "../../../components/study/StudyGlance.astro";
import StudyHead from "../../../components/study/StudyHead.astro";
import StudyMedia from "../../../components/study/StudyMedia.astro";
import StudyQuote from "../../../components/study/StudyQuote.astro";
import StudyCta from "../../../components/study/StudyCta.astro";
import StudyNext from "../../../components/study/StudyNext.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "ZenRaise — تحويل جمع التبرعات النقدية إلى نظام موثّق ومتكرر",
    "description": "تطبيق تابلت صُمم ليصبح الطاقم جاهزًا للجمع في أقل من دقيقة — كل تبرع مرتبط بفعاليته، والعطاء المتكرر في الواجهة الأمامية.",
    "url": "https://abdulazizabudhair.com/ar/work/zenraise",
    "image": "https://abdulazizabudhair.com/assets/img/og-zenraise.jpg",
    "author": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "creator": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "genre": "تطبيق تابلت · جمع تبرعات",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "أعمالي", "item": "https://abdulazizabudhair.com/ar#work" },
      { "@type": "ListItem", "position": 3, "name": "ZenRaise", "item": "https://abdulazizabudhair.com/ar/work/zenraise" }
    ]
  }
];
---
<Layout
  title="ZenRaise — دراسة حالة · عبدالعزيز أبو ضهير"
  description="تطبيق تابلت مصمَّم ليجهّز الموظفين للجمع في أقل من دقيقة — كل تبرع مرتبط بفعاليته، والتبرع المتكرر في الواجهة، والمتبرعون العائدون يُعرفون من رقم الهاتف."
  path="/ar/work/zenraise"
  alternate="/work/zenraise"
  lang="ar"
  ogType="article"
  ogImage="og-zenraise-ar.jpg"
  jsonLd={jsonLd}
  study
>
<article class="study" aria-labelledby="case-title">
  <StudyHero
    lang="ar"
    project="zenraise"
    eyebrow="دراسة حالة · تطبيق تابلت · جمع التبرعات"
    title="ZenRaise"
    subtitle="من صندوق نقود إلى نظام تبرعات موثّق ومتكرر"
    lead="تطبيق تابلت مصمَّم ليجهّز الموظفين للجمع في أقل من دقيقة — كل تبرع مرتبط بفعاليته، والتبرع المتكرر في الواجهة، والمتبرعون العائدون يُعرفون من رقم الهاتف."
    facts={[
      { label: "دوري", value: "مصمم UX/UI، وحدي من البداية للنهاية" },
      { label: "المنصة", value: "تطبيق تابلت" },
      { label: "المدة", value: "7 أسابيع · أبريل – مايو 2026" },
      { label: "الحالة", value: "متاح على App Store", status: true },
    ]}
    coverAlt="ثلاث شاشات من تطبيق ZenRaise للتابلت: البدء، وتبرع بعدّاد لكل طفل، وشاشة الشكر."
  />

  <StudyGlance lang="ar" items={[
    { label: "النطاق", value: "7 أسابيع", text: "وحدي من البداية للنهاية — المسارات والواجهات والنموذج الأولي والتفاعلات الدقيقة" },
    { label: "هدف التصميم", value: "أقل من دقيقة", text: "مصمَّم ليجهّز الموظفين للجمع في أقل من دقيقة." },
    { label: "الحالة", value: "منشور", text: "على App Store، ويُستخدم في فعاليات حقيقية" },
  ]} />

  <section class="study-section study-overview" aria-labelledby="overview-title">
    <div class="container study-overview__grid">
      <div class="study-overview__head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>التحدي</p>
        <h2 class="study-overview__title" id="overview-title">صندوق نقود،<br>بلا سجل حقيقي.</h2>
      </div>
      <div class="study-overview__body">
        <div>
          <h3>السياق</h3>
          <p>يستبدل ZenRaise طريقة اللوح الورقي وصندوق النقود التي تجمع بها المساجد والمؤسسات المجتمعية التبرعات في الفعاليات. يدير الطاقم الليلة نفسها مع عشرات المتبرعين، وعدة برامج تبرع، وقارئ بطاقات — غالباً دون وجود شخص تقني مخصص.</p>
        </div>
        <div>
          <h3>المشكلة</h3>
          <p>لم يترك الجمع اليدوي أي سجل حقيقي: لا طريقة موثوقة لمعرفة كم جُمع، ولا لمقارنة فعالية بأخرى، ولا لإعداد تبرعات متكررة بدل النقد لمرة واحدة. ومن يدير التابلت كان يحتاج قارئ بطاقات يعمل خلال دقائق دون خلفية تقنية، والمتبرعون يحتاجون شاشة بسيطة تكفي لفهم لمن يتبرعون وبأي تكرار.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="decisions-title">
    <div class="container">
      <StudyHead id="decisions-title" eyebrow="01 — القرارات الرئيسية" line1="سبعة قرارات خلف تابلت" line2="يستطيع أي موظف تشغيله" lead="من ربط قارئ البطاقات إلى إغلاق الليلة — كل قرار يلغي خطوة كانت تحتاج شخصاً تقنياً أو عدّاً يدوياً." accent={false} />
      <ol class="study-decisions">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">إعداد موجَّه من 3 خطوات</h3><p class="fact__text">اختر الفعالية، اربط القارئ، جاهز للجمع — مع حالة ربط Bluetooth مباشرة، ليتمكّن أي موظف، لا التقني فقط، من التجهيز للجمع. مصمَّم ليتم ذلك في أقل من دقيقة.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">كل تبرع مرتبط بفعاليته</h3><p class="fact__text">مجاميع كل فعالية تبقى منفصلة تلقائياً، فيتحوّل سؤال "أي فعالية أفضل أداءً" من تخمين إلى رقم حقيقي قابل للمقارنة.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">إدخال يتشكّل حسب البرنامج</h3><p class="fact__text">مبلغ بالدولار مع خيارات سريعة لبرنامج، وعدّاد لكل مستفيد بسعر ثابت لبرنامج آخر — لأنهما نوعان مختلفان جذرياً من العطاء.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">التبرع المتكرر في المقدمة</h3><p class="fact__text">شهري / سنوي خيار ظاهر في شاشة التبرع الرئيسية، لا إعداد ثانوي، لأن تحويل الناس من التبرع لمرة واحدة إلى التبرع المتكرر كان هدفاً أساسياً.</p></li>
        <li class="fact fact--md"><span class="fact__label">05</span><h3 class="fact__value">"هل هذا أنت؟"</h3><p class="fact__text">التعرّف على رقم الهاتف يرحّب بالمتبرع العائد باسمه، ويمنح المؤسسة سجلاً واحداً نظيفاً لكل متبرع بدل نسخ مكررة موزعة على الفعاليات.</p></li>
        <li class="fact fact--md"><span class="fact__label">06</span><h3 class="fact__value">رقم الليلة، فوراً</h3><p class="fact__text">شاشة تفاصيل فعالية متاحة دائماً — إجمالي ما جُمع حسب البرنامج والتكرار، مع العملاء المحتملين — فإنهاء الوردية يعطي الرقم الذي كان المنظمون ينتظرونه.</p></li>
        <li class="fact fact--md"><span class="fact__label">07</span><h3 class="fact__value">مبني ليُعاد تخصيصه بعلامات أخرى</h3><p class="fact__text">النظام كاملاً مبني على Material Theme Builder بمكوّنات Vector، لأن العميل خطّط لإعادة بيع ZenRaise لمؤسسات شريكة بألوانها وهويتها.</p></li>
      </ol>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="tablet-title">
    <div class="container study-stack">
      <StudyHead id="tablet-title" eyebrow="02 — تطبيق التابلت" line1="من أول متبرع" line2="إلى إجمالي الليلة" accent={false} />
      <figure class="study-figure study-group">
        <StudyMedia project="zenraise" name="02-programs" rtl desktop={[1200, 600]} tablet={[704, 352]} mobile={[358, 213]} alt="ثلاث شاشات من تطبيق ZenRaise للتابلت: اختيار الفعالية، وتبرع للمساعدات الغذائية بخيارات سريعة، وبرنامج الأيتام بعدّاد لكل طفل وتكرار سنوي." />
        <figcaption class="study-group__captions study-group__captions--3 study-group__captions--center">
          <span>اختر الفعالية — كل تبرع يرتبط بها.</span>
          <span>المساعدات الغذائية — مبلغ بالدولار مع خيارات سريعة.</span>
          <span>برنامج الأيتام — عدّاد لكل طفل مع اختيار التكرار السنوي.</span>
        </figcaption>
      </figure>
      <figure class="study-figure study-group">
        <StudyMedia project="zenraise" name="03-after-payment" rtl desktop={[1200, 600]} tablet={[704, 352]} mobile={[358, 213]} alt="ثلاث شاشات من تطبيق ZenRaise للتابلت: متبرع عائد تم التعرّف عليه من رقم الهاتف، وتمت معالجة الدفع، وتفاصيل الفعالية مع إجمالي ما جُمع." />
        <figcaption class="study-group__captions study-group__captions--3 study-group__captions--center">
          <span>متبرع عائد تم التعرّف عليه من رقم الهاتف.</span>
          <span>تمت معالجة الدفع.</span>
          <span>تفاصيل الفعالية — إجمالي ما جُمع حسب البرنامج والتكرار، مع العملاء المحتملين.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <StudyQuote
    quote="تصميم UX/UI وWireframes رائعة. قدّم نماذج أولية متعددة على Figma وسلّم تصاميم عالية الدقة لتطبيق التابلت، ما أنتج أفضل تجربة مستخدم ممكنة. أنصح بشدة بالتعامل معه، وسأعمل مع عبدالعزيز مجدداً بالتأكيد."
    name="عميد ج."
    role="مؤسس ZenRaise · الولايات المتحدة"
    initials="ع ج"
  />

  <section class="study-section" aria-labelledby="outcome-title">
    <div class="container">
      <StudyHead id="outcome-title" eyebrow="03 — النتيجة" line1="متاح على App Store" />
      <div class="study-outcome">
        <div>
          <h3>النتيجة</h3>
          <p class="study-outcome__lead">ZenRaise متاح على App Store — يُستخدم في فعاليات حقيقية، ويجمع تبرعات حقيقية من متبرعين حقيقيين.</p>
        </div>
        <div>
          <h3>ماذا تعلّمت</h3>
          <p>البناء على Material Theme Builder منذ اليوم الأول جعل طلب إعادة التخصيص، حين جاء، مجرد تبديل Tokens وخطوط في التطبيق كله، لا إعادة تصميم. والعمل بحلقات ملاحظات سريعة مع العميل — مراجعات قصيرة بدل دورات بناء طويلة صامتة — كشف الانحراف مبكراً. كما بدأت استخدام أدوات الذكاء الاصطناعي لمراجعة الشاشات النهائية بحثاً عن الأخطاء الإملائية والتناقضات الصغيرة قبل التسليم، مراجعة من خمس دقائق وفّرت عدة جولات تصحيح.</p>
        </div>
      </div>
    </div>
  </section>

  <StudyCta lang="ar" title="تستقبل مدفوعات في الفعاليات أو في مقرّك؟" text="أخبرني كيف يتم الأمر اليوم، وأين يبطئ فريقك." />
</article>

<StudyNext current="zenraise" lang="ar" />

</Layout>
