---
import Layout from "../../../layouts/Layout.astro";
import Testimonials from "../../../components/Testimonials.astro";
import NextProject from "../../../components/NextProject.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "AL'ARD — قصة جميلة يسهل الشراء منها",
    "description": "إعادة تصميم تركّز على المبيعات لمتجر AL'ARD لزيت الزيتون الفلسطيني: بنية معلومات جديدة، وقائمة موسّعة، وصفحات منتج يظهر أهم ما فيها أولًا، ومسار للهدايا. التصميم منشور الآن.",
    "url": "https://abdulazizabudhair.com/ar/work/alard",
    "image": "https://abdulazizabudhair.com/assets/img/og-alard.jpg",
    "author": {
      "@type": "Person",
      "@id": "https://abdulazizabudhair.com/#person",
      "name": "عبدالعزيز أبو ضهير",
      "url": "https://abdulazizabudhair.com/ar"
    },
    "genre": "تجارة إلكترونية، إعادة تصميم لرفع المبيعات",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الأعمال", "item": "https://abdulazizabudhair.com/ar#case-studies" },
      { "@type": "ListItem", "position": 3, "name": "AL'ARD", "item": "https://abdulazizabudhair.com/ar/work/alard" }
    ]
  }
];
---
<Layout
  title="AL'ARD — دراسة حالة · عبدالعزيز أبو ضهير"
  description="إعادة تصميم تركّز على المبيعات لمتجر AL'ARD لزيت الزيتون الفلسطيني: بنية معلومات جديدة، وقائمة موسّعة، وصفحات منتج يظهر أهم ما فيها أولًا، ومسار للهدايا. التصميم منشور الآن."
  path="/ar/work/alard"
  alternate="/work/alard"
  lang="ar"
  ogType="article"
  ogImage="og-alard.jpg"
  jsonLd={jsonLd}
>
<article class="band band--light case" aria-labelledby="case-title">
  <div class="container">
    <a class="back-link" href="/ar#case-studies"><span aria-hidden="true">→</span> العودة إلى الأعمال</a>
    <header>
      <p class="case__eyebrow">تجارة إلكترونية · إعادة تصميم لرفع المبيعات</p>
      <h1 class="case__title" id="case-title">AL'ARD <span>قصة جميلة يسهل الشراء منها</span></h1>
      <dl class="case__meta">
        <div><dt>الدور</dt><dd>مصمم UX/UI</dd></div>
        <div><dt>المنصة</dt><dd>موقع متجاوب — متاجر للولايات المتحدة وأوروبا والسعودية</dd></div>
        <div><dt>الأدوات</dt><dd>Figma</dd></div>
      </dl>
    </header>

    <figure class="case__media">
      <img src="/assets/img/alard/alard-home-desktop-1400.webp" srcset="/assets/img/alard/alard-home-desktop-700.webp 700w, /assets/img/alard/alard-home-desktop-1400.webp 1400w" sizes="(min-width: 1448px) 1368px, 94vw" width="1400" height="836" fetchpriority="high" decoding="async" alt="الصفحة الرئيسية لمتجر AL'ARD بعد إعادة التصميم: رأس صفحة ثابت فيه البحث والفئات، فوق واجهة لزيت الزيتون الفلسطيني.">
    </figure>

    <!-- 01 Overview -->
    <section class="cs-section" aria-labelledby="s-overview">
      <div class="case__body" style="margin-top:0">
        <div class="prose">
          <p class="cs-eyebrow">01 — نظرة عامة ودوري</p>
          <h2 class="cs-title" id="s-overview">منتجات تراثية تُباع في ثلاث مناطق</h2>
          <p>يبيع AL'ARD زيت الزيتون الفلسطيني والمنتجات الغذائية الحرفية — منتجات تراثية ترتبط ارتباطًا وثيقًا بالهوية الفلسطينية — عبر متاجر إقليمية للولايات المتحدة وأوروبا والسعودية.</p>
          <p><strong>دوري:</strong> مصمم UX/UI مسؤول عن إعادة التصميم على مراحل — الصفحة الرئيسية، وصفحة المنتج، وإعادة هيكلة كاملة للمجموعات وبنية المعلومات في المتاجر الثلاثة، على سطح المكتب والجوال.</p>
        </div>
        <div class="prose">
          <p class="cs-eyebrow">02 — المشكلة</p>
          <h2 class="cs-title">قصة جميلة — لكن الشراء منها كان صعبًا</h2>
          <ul>
            <li><strong>نوافذ منبثقة كثيرة.</strong> صفحات رئيسية مزدحمة بنوافذ منبثقة متراكمة تتنافس على الانتباه.</li>
            <li><strong>تنقّل مدفون.</strong> الفئات الأساسية مخفية داخل قائمة جانبية على سطح المكتب.</li>
            <li><strong>كل شيء يحتاج إلى تمرير.</strong> صورة المنتج وسعره وخيارات الأحجام لا تظهر إلا بعد التمرير.</li>
            <li><strong>مشكلات في SEO.</strong> كشفت المراجعات في المواقع الإقليمية الثلاثة مشكلات في البنية.</li>
          </ul>
          <p><strong>المطلوب:</strong> إعادة تصميم تركّز على المبيعات وتجعل التسوق سهلًا على سطح المكتب والجوال — دون أن تُضعف هوية العلامة التراثية الفلسطينية.</p>
        </div>
      </div>

      <ol class="steps" aria-label="مراحل العمل">
        <li><strong>التدقيق</strong><span>مشكلات تجربة المستخدم ونتائج SEO</span></li>
        <li><strong>إعادة الهيكلة</strong><span>الكتالوج وبنية المعلومات حسب طريقة تسوّق الناس</span></li>
        <li><strong>التصميم</strong><span>شاشات سطح المكتب والجوال</span></li>
        <li><strong>النموذج الأولي</strong><span>نموذج تفاعلي في Figma</span></li>
        <li><strong>الاختبار</strong><span>جلسات مع مستخدمين من الفئة المستهدفة</span></li>
      </ol>
    </section>

    <!-- 03 IA -->
    <section class="cs-section" aria-labelledby="s-ia">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">03 — قرار أساسي · بنية المعلومات</p>
          <h2 class="cs-title" id="s-ia">منظّمة حسب طريقة تسوّق العملاء — لا حسب طريقة تخزين المنتجات</h2>
        </div>
        <p class="cs-lead">تسع مجموعات للتنقّل تغطي ما يأتي الناس من أجله، فيما تقدّم مجموعات العروض مداخل موسمية وأخرى حسب الميزانية.</p>
      </div>
      <div class="collections">
        <div>
          <h3>مجموعات التنقّل</h3>
          <ul>
            <li>زيت الزيتون الفلسطيني</li><li>صناديق الهدايا والباقات</li><li>المؤونة الفلسطينية</li>
            <li>الزعتر والأعشاب والتوابل</li><li>الكوفية والتراث</li><li>الصابون النابلسي</li>
            <li>المخللات وزيتون المائدة</li><li>ادعم المزارعين الفلسطينيين</li><li>المفضّلة لدى العملاء</li>
          </ul>
        </div>
        <div>
          <h3>مجموعات العروض</h3>
          <ul>
            <li>أساسيات الفطور الفلسطيني</li><li>هدايا بأقل من 30 دولارًا</li><li>الحصاد الجديد</li>
          </ul>
        </div>
      </div>
      <figure class="cs-figure">
        <img src="/assets/img/alard/alard-all-products-1400.webp" srcset="/assets/img/alard/alard-all-products-700.webp 700w, /assets/img/alard/alard-all-products-1400.webp 1400w" sizes="(min-width: 1448px) 1368px, 94vw" width="1400" height="1213" loading="lazy" decoding="async" alt="صفحة كل المنتجات في AL'ARD مع فلاتر للفئة والسعر والحجم بجانب شبكة من زيوت الزيتون وصناديق الهدايا.">
        <figcaption>كل المنتجات — فلترة حسب الفئة والسعر والحجم.</figcaption>
      </figure>
    </section>

    <!-- 04 Navigation -->
    <section class="cs-section" aria-labelledby="s-nav">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">04 — قرار أساسي · التنقّل</p>
          <h2 class="cs-title" id="s-nav">كل فئة على بُعد نقرة واحدة — من أي مكان في الصفحة</h2>
        </div>
      </div>
      <ul class="features features--4 features--numbered">
        <li><strong>رأس صفحة ثابت</strong><span>نُقل التنقّل الأساسي من القائمة الجانبية إلى رأس صفحة يبقى مع المتسوّق.</span></li>
        <li><strong>قائمة موسّعة حسب النيّة</strong><span>تسوّق حسب الحاجة أو الحجم أو النوع — بالطريقة التي يقرر بها الناس فعلًا.</span></li>
        <li><strong>بطاقة عروض</strong><span>عروض موسمية مثل «<bdi>First Press of the Season</bdi>» داخل القائمة نفسها.</span></li>
        <li><strong>البحث أولًا</strong><span>شريط بحث عريض مع اقتراحات مفيدة: زيت الزيتون، الزعتر، صناديق الهدايا.</span></li>
      </ul>
      <figure class="cs-figure">
        <img src="/assets/img/alard/alard-mega-menu-1400.webp" srcset="/assets/img/alard/alard-mega-menu-700.webp 700w, /assets/img/alard/alard-mega-menu-1400.webp 1400w" sizes="(min-width: 1448px) 1368px, 94vw" width="1400" height="983" loading="lazy" decoding="async" alt="القائمة الموسّعة لزيت الزيتون الفلسطيني، منظّمة حسب الحاجة والحجم والنوع، مع عرض First Press of the Season.">
      </figure>
    </section>

    <!-- 05 Homepage -->
    <section class="cs-section" aria-labelledby="s-home">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">05 — قرار أساسي · الصفحة الرئيسية</p>
          <h2 class="cs-title" id="s-home">صفحة رئيسية أهدأ تبيع أكثر</h2>
        </div>
      </div>
      <ul class="features features--3">
        <li><strong>نوافذ منبثقة أقل</strong><span>رسالة واضحة واحدة في كل مرة بدل نوافذ متراكمة.</span></li>
        <li><strong>منتجات أكثر في أول الشاشة</strong><span>المنتجات الأكثر مبيعًا تظهر منذ أول تمريرة.</span></li>
        <li><strong>«<bdi>Compare the Gifts</bdi>»</strong><span>يرشد المشترين حسب الميزانية والمناسبة — Mini وPantry وOlive Oil وPremium.</span></li>
      </ul>
      <div class="cs-grid cs-grid--2">
        <figure>
          <img src="/assets/img/alard/alard-best-sellers-1400.webp" srcset="/assets/img/alard/alard-best-sellers-700.webp 700w, /assets/img/alard/alard-best-sellers-1400.webp 1400w" sizes="(min-width: 1448px) 674px, (min-width: 721px) 47vw, 94vw" width="1400" height="772" loading="lazy" decoding="async" alt="صف الأكثر مبيعًا: زيت زيتون وزعتر وطحينة، لكلٍّ منها خيارات أحجام وزر إضافة إلى السلة.">
          <figcaption>الأكثر مبيعًا، في أول الشاشة.</figcaption>
        </figure>
        <figure>
          <img src="/assets/img/alard/alard-collections-1400.webp" srcset="/assets/img/alard/alard-collections-700.webp 700w, /assets/img/alard/alard-collections-1400.webp 1400w" sizes="(min-width: 1448px) 674px, (min-width: 721px) 47vw, 94vw" width="1400" height="686" loading="lazy" decoding="async" alt="شبكة التسوق حسب المجموعة: زيت الزيتون، صناديق الهدايا، الزعتر والتوابل، المؤونة، الكوفية والتراث.">
          <figcaption>التسوق حسب المجموعة — مجمّعة حسب ما يطبخه الناس ويهدونه ويجتمعون حوله.</figcaption>
        </figure>
      </div>
      <figure class="cs-figure">
        <img src="/assets/img/alard/alard-compare-gifts-1592.webp" srcset="/assets/img/alard/alard-compare-gifts-796.webp 796w, /assets/img/alard/alard-compare-gifts-1592.webp 1592w" sizes="(min-width: 1448px) 1368px, 94vw" width="1592" height="570" loading="lazy" decoding="async" alt="وحدة Compare the Gifts تعرض فئات الهدايا Mini وPantry وOlive Oil وPremium جنبًا إلى جنب.">
        <figcaption>Compare the Gifts — الاختيار حسب الميزانية والمناسبة.</figcaption>
      </figure>
    </section>

    <!-- 06 Product page -->
    <section class="cs-section" aria-labelledby="s-pdp">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">06 — قرار أساسي · صفحة المنتج</p>
          <h2 class="cs-title" id="s-pdp">صفحة المنتج، مبنية حول ما يظهر أولًا</h2>
        </div>
      </div>
      <figure class="cs-figure">
        <img src="/assets/img/alard/alard-product-page-1512.webp" srcset="/assets/img/alard/alard-product-page-756.webp 756w, /assets/img/alard/alard-product-page-1512.webp 1512w" sizes="(min-width: 1448px) 1368px, 94vw" width="1512" height="1104" loading="lazy" decoding="async" alt="صفحة منتج لزيت الزيتون فيها معرض الصور، ووسوم Halal وHarvest، والتقييم، والسعر لكل ملّيلتر، وبطاقات الأحجام، والاشتراك والتوفير، وشارات الثقة — كلها في أول الشاشة.">
      </figure>
      <ul class="features features--3 features--numbered">
        <li><strong>المعرض في أول الشاشة</strong><span>الصورة الرئيسية والصور المصغّرة ظاهرة دون تمرير.</span></li>
        <li><strong>العنوان والتقييم والدليل</strong><span>وسوم Halal وHarvest والتقييم و«<bdi>300+ bought</bdi>» في الأعلى.</span></li>
        <li><strong>السعر لكل وحدة</strong><span>السعر لكل ملّيلتر يجعل خصم الأحجام الكبيرة واضحًا بذاته.</span></li>
        <li><strong>الأحجام كبطاقات</strong><span>كل حجم يعرض سعره ومقدار التوفير فيه.</span></li>
        <li><strong>اشترك ووفّر</strong><span>شراء لمرة واحدة أو توصيل متكرر في خطوة واحدة.</span></li>
        <li><strong>شارات ثقة دائمة</strong><span>منشأ فلسطيني أصيل، وحدّ الشحن المجاني.</span></li>
      </ul>
    </section>

    <!-- 07 Conversion -->
    <section class="cs-section" aria-labelledby="s-aov">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">07 — رفع المبيعات وقيمة الطلب</p>
          <h2 class="cs-title" id="s-aov">أنماط لطلبات أكثر — وأكبر</h2>
        </div>
        <p class="cs-lead">اشترك ووفّر، والباقات، والتقييمات، وأسئلة شائعة قابلة للطي، ومنتجات ذات صلة، وصندوق تبنيه بنفسك، وشريط تقدّم نحو الشحن المجاني.</p>
      </div>
      <div class="cs-grid cs-grid--2">
        <figure>
          <img src="/assets/img/alard/alard-bought-together-900.webp" srcset="/assets/img/alard/alard-bought-together-450.webp 450w, /assets/img/alard/alard-bought-together-900.webp 900w" sizes="(min-width: 1448px) 674px, (min-width: 721px) 47vw, 94vw" width="900" height="610" loading="lazy" decoding="async" alt="يُشترى معًا عادةً: معجون الطحينة وتمر المجهول مع خصم 10% على الباقة.">
          <figcaption>يُشترى معًا عادةً.</figcaption>
        </figure>
        <figure>
          <img src="/assets/img/alard/alard-cart-drawer-1400.webp" srcset="/assets/img/alard/alard-cart-drawer-700.webp 700w, /assets/img/alard/alard-cart-drawer-1400.webp 1400w" sizes="(min-width: 1448px) 674px, (min-width: 721px) 47vw, 94vw" width="1400" height="983" loading="lazy" decoding="async" alt="درج السلة مع شريط تقدّم نحو الشحن المجاني ونقاط الولاء.">
          <figcaption>درج السلة — التقدّم نحو الشحن المجاني ونقاط الولاء.</figcaption>
        </figure>
        <figure>
          <img src="/assets/img/alard/alard-build-box-1400.webp" srcset="/assets/img/alard/alard-build-box-700.webp 700w, /assets/img/alard/alard-build-box-1400.webp 1400w" sizes="(min-width: 1448px) 674px, (min-width: 721px) 47vw, 94vw" width="1400" height="756" loading="lazy" decoding="async" alt="ابنِ صندوقك بنفسك: اختر من خمسة إلى عشرة منتجات، مع ملخص للصندوق يفتح خصمًا عند خمسة منتجات.">
          <figcaption>ابنِ صندوقك بنفسك — يُفتح الخصم عند خمسة منتجات.</figcaption>
        </figure>
        <figure>
          <img src="/assets/img/alard/alard-reviews-1520.webp" srcset="/assets/img/alard/alard-reviews-760.webp 760w, /assets/img/alard/alard-reviews-1520.webp 1520w" sizes="(min-width: 1448px) 674px, (min-width: 721px) 47vw, 94vw" width="1520" height="600" loading="lazy" decoding="async" alt="تبويب تقييمات العملاء مع توزيع التقييمات وأختام الثقة.">
          <figcaption>معاينة التقييمات مع توزيعها وأختام الثقة.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 08 Gifting & B2B -->
    <section class="cs-section" aria-labelledby="s-gift">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">08 — الهدايا والشركات</p>
          <h2 class="cs-title" id="s-gift">مسار مخصص للهدايا — وللشركات</h2>
        </div>
      </div>
      <ul class="features features--3">
        <li><strong>فئات الهدايا</strong><span>حسب الميزانية والمناسبة، مقارنةً جنبًا إلى جنب.</span></li>
        <li><strong>إضافات</strong><span>كوفية، وتمر، وصابون نابلسي، ورعاية شجرة، وبطاقة هدية.</span></li>
        <li><strong>للشركات</strong><span>هدايا الشركات والكميات الكبيرة، مع علامة تجارية مخصصة وشحن إلى عدة عناوين.</span></li>
      </ul>
      <figure class="cs-figure">
        <img src="/assets/img/alard/alard-gift-boxes-1400.webp" srcset="/assets/img/alard/alard-gift-boxes-700.webp 700w, /assets/img/alard/alard-gift-boxes-1400.webp 1400w" sizes="(min-width: 1448px) 1368px, 94vw" width="1400" height="840" loading="lazy" decoding="async" alt="واجهة صفحة مجموعة صناديق الهدايا الفلسطينية مع طقم زيت زيتون ومؤونة في صندوق.">
      </figure>
      <figure class="cs-figure">
        <img src="/assets/img/alard/alard-bulk-gifting-1400.webp" srcset="/assets/img/alard/alard-bulk-gifting-700.webp 700w, /assets/img/alard/alard-bulk-gifting-1400.webp 1400w" sizes="(min-width: 1448px) 1368px, 94vw" width="1400" height="454" loading="lazy" decoding="async" alt="لافتة هدايا الشركات والكميات الكبيرة: Gift Palestine, at scale.">
        <figcaption>هدايا الشركات والكميات الكبيرة — «<bdi>Gift Palestine, at scale</bdi>».</figcaption>
      </figure>
    </section>

    <!-- 09 Visual language -->
    <section class="cs-section" aria-labelledby="s-visual">
      <div class="cs-section__head">
        <div>
          <p class="cs-eyebrow">09 — اللغة البصرية</p>
          <h2 class="cs-title" id="s-visual">لغة بصرية متجذّرة في الأرض</h2>
        </div>
        <p class="cs-lead">مبنية على الدليل البصري لعلامة AL'ARD، مع استخدام الألوان الثانوية باعتدال.</p>
      </div>
