---
import Layout from "../../../layouts/Layout.astro";
import Testimonials from "../../../components/Testimonials.astro";
import NextProject from "../../../components/NextProject.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "AL'ARD — جعل قصة جميلة سهلة الشراء",
    "description": "إعادة تصميم تركّز على التحويل لمتجر AL'ARD الأمريكي الإلكتروني لزيت الزيتون والمنتجات التراثية الفلسطينية.",
    "url": "https://abdulazizabudhair.com/ar/work/alard",
    "image": "https://abdulazizabudhair.com/assets/img/og-alard.jpg",
    "author": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "creator": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "genre": "تجارة إلكترونية · إعادة تصميم لرفع التحويل",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "أعمالي", "item": "https://abdulazizabudhair.com/ar#work" },
      { "@type": "ListItem", "position": 3, "name": "AL'ARD", "item": "https://abdulazizabudhair.com/ar/work/alard" }
    ]
  }
];
---
<Layout
  title="AL'ARD — دراسة حالة · عبدالعزيز أبو ضهير"
  description="إعادة تصميم تركّز على رفع التحويل لمتجر AL'ARD الأمريكي الإلكتروني لزيت الزيتون والمنتجات التراثية الفلسطينية — صفحة رئيسية أهدأ، وكل فئة على بُعد نقرة واحدة، وصفحة منتج أُعيد بناؤها حول الجزء الظاهر من الشاشة."
  path="/ar/work/alard"
  alternate="/work/alard"
  lang="ar"
  ogType="article"
  ogImage="og-alard.jpg"
  jsonLd={jsonLd}
>
<article class="case" aria-labelledby="case-title">
  <div class="container cs-hero">
    <a class="back-link text-link" href="/ar/#work"><span aria-hidden="true">→</span> العودة إلى الأعمال</a>
    <p class="cs-hero__eyebrow">دراسة حالة · تجارة إلكترونية · إعادة تصميم لرفع التحويل</p>
    <h1 class="cs-hero__title" id="case-title">AL'ARD</h1>
    <p class="cs-hero__subtitle">جعل قصة جميلة سهلة الشراء — إعادة تصميم تركّز على رفع التحويل لمتجر AL'ARD الأمريكي الإلكتروني لزيت الزيتون والمنتجات التراثية الفلسطينية، صفحة رئيسية أهدأ، وكل فئة على بُعد نقرة واحدة، وصفحة منتج أُعيد بناؤها حول الجزء الظاهر من الشاشة.</p>
    <dl class="cs-hero__facts">
      <div><dt>دوري</dt><dd>مصمم UX/UI</dd></div>
      <div><dt>المنصة</dt><dd>ويب متجاوب — متجر أمريكي على Shopify</dd></div>
      <div><dt>المدة</dt><dd>12 شهرًا · سبتمبر 2025 – أغسطس 2026</dd></div>
      <div><dt>الحالة</dt><dd class="cs-status"><span class="work-card__dot" aria-hidden="true"></span>التصميم الجديد منشور الآن</dd></div>
    </dl>
    <nav class="cs-onthispage" aria-label="في هذه الصفحة">
      <span class="cs-onthispage__label">في هذه الصفحة</span>
      <a href="#overview">نظرة عامة</a>
      <a href="#the-problem">المشكلة</a>
      <a href="#navigation">التنقل</a>
      <a href="#homepage">الصفحة الرئيسية</a>
      <a href="#product-page">صفحة المنتج</a>
      <a href="#mobile">الجوال</a>
      <a href="#conversion">التحويل والبيع للشركات</a>
      <a href="#outcome">النتيجة</a>
    </nav>
  </div>

  <div class="container">
    <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
      <img src="/assets/img/alard-cs-hero-1040.webp" srcset="/assets/img/alard-cs-hero-1040.webp 1040w, /assets/img/alard-cs-hero-2080.webp 2080w" sizes="(min-width: 1280px) 1040px, 90vw" width="1040" height="589" fetchpriority="high" decoding="async" alt="الصفحة الرئيسية الجديدة لمتجر AL'ARD لزيت الزيتون والمنتجات التراثية الفلسطينية.">
    </div>
  </div>

  <div class="container cs-section">
    <p class="fact-card__label">المشروع في لمحة</p>
    <div class="cs-glance">
      <div class="fact-card"><p class="fact-card__value">متجر أمريكي</p><p class="fact-card__text">لسطح المكتب والجوال، مبني على Shopify</p></div>
      <div class="fact-card"><p class="fact-card__value">يعمل فعليًا</p><p class="fact-card__text">التصميم الجديد منشور على alardproducts.com</p></div>
    </div>
  </div>

  <div class="container cs-section" id="overview">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>التحدي</div>
    <h2 class="cs-title">قصة جميلة — <em>وكانت صعبة الشراء</em></h2>
    <div class="cs-prose">
      <div>
        <h3>السياق</h3>
        <p>يبيع AL'ARD زيت الزيتون الفلسطيني والمنتجات الحرفية — منتجات تراثية مرتبطة ارتباطًا وثيقًا بالهوية الفلسطينية. غطّت إعادة تصميمي متجره الإلكتروني الأمريكي.</p>
      </div>
      <div>
        <h3>الموجز</h3>
        <p>إعادة تصميم تركّز على رفع التحويل تجعل التسوق سهلًا على سطح المكتب والجوال — دون تخفيف هوية العلامة التراثية الفلسطينية.</p>
      </div>
    </div>
  </div>

  <div class="container cs-section" id="the-problem">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>01 — المشكلة</div>
    <h2 class="cs-title">ما الذي جعل المتجر القديم صعب التسوق</h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">فيض من النوافذ المنبثقة</p><p class="fact-card__text">صفحات رئيسية مزدحمة بنوافذ منبثقة متراكمة تتنافس على الانتباه.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">تنقل مدفون</p><p class="fact-card__text">الفئات الأساسية مخفية داخل قائمة جانبية في سطح المكتب.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">تحت الجزء الظاهر</p><p class="fact-card__text">صورة المنتج والسعر وخيارات الحجم كلها تحت الجزء الظاهر من الشاشة.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">ديون SEO</p><p class="fact-card__text">مراجعات SEO للمتجر كشفت مشكلات بنيوية.</p></div>
    </div>
    <div class="cs-eyebrow" style={{ marginTop: "32px" }}><span class="cs-eyebrow__square"></span>كيف عملت</div>
    <div class="cs-decisions" style={{ marginTop: "24px" }}>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">تدقيق</p><p class="fact-card__text">نقاط ألم تجربة المستخدم ونتائج SEO</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">إعادة هيكلة</p><p class="fact-card__text">الكتالوج وبنية المعلومات حول طريقة تسوق الناس</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">تصميم</p><p class="fact-card__text">شاشات سطح المكتب والجوال</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">نموذج أولي</p><p class="fact-card__text">نموذج تفاعلي في Figma</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">05</p><p class="fact-card__value">تكرار</p><p class="fact-card__text">ملاحظات فريق التسويق، ميزات جديدة ومراجعات SEO</p></div>
    </div>
  </div>

  <div class="container cs-section" id="navigation">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>02 — قرار رئيسي · التنقل وبنية المعلومات</div>
    <h2 class="cs-title">كل فئة على بُعد نقرة واحدة — <em>من أي موضع تمرير</em></h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">رأس ثابت</p><p class="fact-card__text">انتقل التنقل الأساسي من القائمة الجانبية إلى رأس يبقى مع المتسوق أثناء التمرير.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">قائمة ضخمة حسب الهدف</p><p class="fact-card__text">تسوّق حسب الحاجة، أو الحجم، أو النوع — بالطريقة التي يقرر بها الناس فعليًا.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">بلاطة تسويقية</p><p class="fact-card__text">عروض موسمية مثل "أول عصرة الموسم" تعيش داخل القائمة نفسها.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">رأس يبدأ بالبحث</p><p class="fact-card__text">شريط بحث عريض مع اقتراحات مفيدة: زيت زيتون، زعتر، صناديق هدايا.</p></div>
    </div>
    <figure style={{ marginTop: "48px" }}>
      <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
        <img src="/assets/img/alard-cs-megamenu-1104.webp" srcset="/assets/img/alard-cs-megamenu-1104.webp 1104w, /assets/img/alard-cs-megamenu-2208.webp 2208w" sizes="(min-width: 1280px) 1104px, 90vw" width="1104" height="744" loading="lazy" decoding="async" alt="القائمة الضخمة لزيت الزيتون الفلسطيني في AL'ARD، منظمة حسب الحاجة والحجم والنوع.">
      </div>
      <figcaption>القائمة الضخمة لزيت الزيتون الفلسطيني — حسب الحاجة والحجم والنوع.</figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="homepage">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>03 — قرار رئيسي · الصفحة الرئيسية</div>
    <h2 class="cs-title">صفحة رئيسية أهدأ، وتبيع</h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">نوافذ منبثقة أقل</p><p class="fact-card__text">رسالة واحدة واضحة في كل مرة بدل طبقات متراكمة.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">منتجات أكثر فوق الطي</p><p class="fact-card__text">الأكثر مبيعًا يظهر من أول تمريرة.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">"قارن الهدايا"</p><p class="fact-card__text">يوجّه المشترين حسب الميزانية والمناسبة — صغيرة، تموينية، زيت زيتون، فاخرة.</p></div>
    </div>
  </div>

  <div class="container cs-section" id="product-page">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>04 — قرار رئيسي · صفحة المنتج</div>
    <h2 class="cs-title">صفحة المنتج، أُعيد بناؤها حول الجزء الظاهر</h2>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">معرض فوق الطي</p><p class="fact-card__text">الصورة الرئيسية والصور المصغرة ظاهرة دون تمرير.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">العنوان والتقييم والإثبات</p><p class="fact-card__text">وسوم حلال والموسم، والتقييم و"أكثر من 300 عملية شراء" في الأعلى.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">تسعير لكل وحدة</p><p class="fact-card__text">السعر لكل مل يجعل خصم الكمية واضحًا بذاته.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">خيارات الحجم كبطاقات</p><p class="fact-card__text">كل حجم يعرض سعره ووفره الخاص.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">05</p><p class="fact-card__value">اشترك ووفّر</p><p class="fact-card__text">توصيل لمرة واحدة أو متكرر في خطوة واحدة.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">06</p><p class="fact-card__value">شارات ثقة دائمة</p><p class="fact-card__text">أصل فلسطيني أصيل + حد الشحن المجاني.</p></div>
    </div>
    <figure style={{ marginTop: "48px" }}>
      <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
        <img src="/assets/img/alard-cs-productpage-1104.webp" srcset="/assets/img/alard-cs-productpage-1104.webp 1104w, /assets/img/alard-cs-productpage-2208.webp 2208w" sizes="(min-width: 1280px) 1104px, 90vw" width="1104" height="833" loading="lazy" decoding="async" alt="صفحة منتج AL'ARD مع المعرض والوسوم والتقييم وتسعير لكل مل وبطاقات الحجم والاشتراك والتوفير وشارات الثقة فوق الطي.">
      </div>
      <figcaption>المعرض، الوسوم، التقييم، التسعير لكل مل، بطاقات الحجم، اشترك ووفّر وشارات الثقة — كلها فوق الطي.</figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="mobile">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>05 — الجوال</div>
    <h2 class="cs-title">مصمّم للجوال أيضًا</h2>
    <p class="cs-lead">صُممت الشاشات الأساسية للهاتف أيضًا — الرئيسية، القائمة الضخمة، صفحة المنتج والفلاتر.</p>
    <div class="cs-grid cs-grid--4" style={{ "--project-tile": "var(--project-alard)", marginTop: "40px" }}>
      <figure><img src="/assets/img/alard-cs-mobile-1-216.webp" srcset="/assets/img/alard-cs-mobile-1-216.webp 216w, /assets/img/alard-cs-mobile-1-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="الصفحة الرئيسية لتطبيق AL'ARD على الجوال."><figcaption>الرئيسية</figcaption></figure>
      <figure><img src="/assets/img/alard-cs-mobile-2-216.webp" srcset="/assets/img/alard-cs-mobile-2-216.webp 216w, /assets/img/alard-cs-mobile-2-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="القائمة الضخمة لزيت الزيتون الفلسطيني على جوال AL'ARD."><figcaption>القائمة الضخمة — زيت الزيتون الفلسطيني</figcaption></figure>
      <figure><img src="/assets/img/alard-cs-mobile-3-216.webp" srcset="/assets/img/alard-cs-mobile-3-216.webp 216w, /assets/img/alard-cs-mobile-3-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="صفحة منتج على جوال AL'ARD بالأحجام والتسعير لكل مل."><figcaption>صفحة المنتج — الأحجام والتسعير لكل مل</figcaption></figure>
      <figure><img src="/assets/img/alard-cs-mobile-4-216.webp" srcset="/assets/img/alard-cs-mobile-4-216.webp 216w, /assets/img/alard-cs-mobile-4-432.webp 432w" sizes="216px" width="216" height="470" loading="lazy" decoding="async" alt="صفحة كل المنتجات على جوال AL'ARD مع الفلاتر."><figcaption>كل المنتجات — الفلاتر</figcaption></figure>
    </div>
  </div>

  <div class="container cs-section" id="conversion">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>06 — التحويل والإهداء والبيع للشركات</div>
    <h2 class="cs-title">أنماط لطلبات أكثر — <em>وأكبر</em></h2>
    <p class="cs-lead">اشترك ووفّر، باقات، تقييمات، صندوق هدايا مخصص وشريط شحن مجاني — إضافة إلى مسار مخصص للإهداء والطلبات المؤسسية.</p>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">فئات الهدايا</p><p class="fact-card__text">حسب الميزانية والمناسبة، بمقارنة جنبًا إلى جنب.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">إضافات</p><p class="fact-card__text">كوفية، تمر، صابون نابلسي، رعاية شجرة، بطاقة هدايا.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">بيع للشركات</p><p class="fact-card__text">هدايا مؤسسية وبالجملة، مع هوية مخصصة وشحن لعدة عناوين.</p></div>
    </div>
    <div class="cs-grid cs-grid--2" style={{ marginTop: "48px" }}>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
          <img src="/assets/img/alard-cs-conv-1-524.webp" srcset="/assets/img/alard-cs-conv-1-524.webp 524w, /assets/img/alard-cs-conv-1-1048.webp 1048w" sizes="524px" width="524" height="348" loading="lazy" decoding="async" alt="اقتراح باقة 'يُشترى معًا غالبًا' في AL'ARD.">
        </div>
        <figcaption>يُشترى معًا غالبًا.</figcaption>
      </figure>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-alard)" }}>
          <img src="/assets/img/alard-cs-conv-2-524.webp" srcset="/assets/img/alard-cs-conv-2-524.webp 524w, /assets/img/alard-cs-conv-2-1048.webp 1048w" sizes="524px" width="524" height="353" loading="lazy" decoding="async" alt="درج سلة AL'ARD مع تقدّم الشحن المجاني ونقاط الولاء.">
        </div>
        <figcaption>درج السلة — تقدّم الشحن المجاني ونقاط الولاء.</figcaption>
      </figure>
    </div>
  </div>

  <div class="container cs-section">
    <figure class="cs-quote">
      <span class="cs-quote__mark" aria-hidden="true">&ldquo;</span>
      <blockquote><p>يفهم التوجه جيدًا، ويتجاوب مع الملاحظات، ويساعدنا على تحويل أفكارنا إلى تجربة موقع أوضح وأسهل في الاستخدام.</p></blockquote>
      <figcaption>
        <span class="testimonial-card__avatar" aria-hidden="true">أا</span>
        <span class="testimonial-card__who"><cite>أحمد النمر</cite><span>مدير التسويق الرقمي، AL'ARD · نابلس، فلسطين</span></span>
      </figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="outcome">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>07 — النتيجة</div>
    <h2 class="cs-title">رُوجع قبل سطر برمجة واحد — ومنشور الآن</h2>
    <div class="cs-outcome">
      <div>
        <h3>النتيجة</h3>
