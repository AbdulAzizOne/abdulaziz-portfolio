---
import Layout from "../../../layouts/Layout.astro";
import StudyHero from "../../../components/study/StudyHero.astro";
import StudyGlance from "../../../components/study/StudyGlance.astro";
import StudyHead from "../../../components/study/StudyHead.astro";
import StudyMedia from "../../../components/study/StudyMedia.astro";
import StudyQuote from "../../../components/study/StudyQuote.astro";
import StudyCta from "../../../components/study/StudyCta.astro";
import StudyNext from "../../../components/study/StudyNext.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "AL'ARD — جعل قصة جميلة سهلة الشراء",
    "description": "إعادة تصميم تركّز على التحويل لمتجر AL'ARD الأمريكي الإلكتروني لزيت الزيتون والمنتجات التراثية الفلسطينية.",
    "url": "https://abdulazizabudhair.com/ar/work/alard",
    "image": "https://abdulazizabudhair.com/assets/img/og-alard.jpg",
    "author": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "creator": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "genre": "تجارة إلكترونية · إعادة تصميم لرفع التحويل",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "أعمالي", "item": "https://abdulazizabudhair.com/ar#work" },
      { "@type": "ListItem", "position": 3, "name": "AL'ARD", "item": "https://abdulazizabudhair.com/ar/work/alard" }
    ]
  }
];
---
<Layout
  title="AL'ARD — دراسة حالة · عبدالعزيز أبو ضهير"
  description="إعادة تصميم تركّز على رفع المبيعات لمتجر AL'ARD الأمريكي لزيت الزيتون والمنتجات التراثية الفلسطينية — صفحة رئيسية أهدأ، وكل فئة على بُعد نقرة، وصفحة منتج أُعيد بناؤها حول الجزء الظاهر من الشاشة."
  path="/ar/work/alard"
  alternate="/work/alard"
  lang="ar"
  ogType="article"
  ogImage="og-alard.jpg"
  jsonLd={jsonLd}
  study
>
<article class="study" aria-labelledby="case-title">
  <StudyHero
    lang="ar"
    project="alard"
    eyebrow="دراسة حالة · تجارة إلكترونية · إعادة تصميم لرفع المبيعات"
    title="AL’ARD"
    subtitle="قصة جميلة يسهل الشراء منها"
    lead="إعادة تصميم تركّز على رفع المبيعات لمتجر AL’ARD الأمريكي لزيت الزيتون والمنتجات التراثية الفلسطينية — صفحة رئيسية أهدأ، وكل فئة على بُعد نقرة، وصفحة منتج أُعيد بناؤها حول الجزء الظاهر من الشاشة."
    facts={[
      { label: "دوري", value: "مصمم UX/UI" },
      { label: "المنصة", value: "ويب متجاوب — متجر الولايات المتحدة على Shopify" },
      { label: "المدة", value: "12 شهراً · سبتمبر 2025 – أغسطس 2026" },
      { label: "الحالة", value: "التصميم الجديد منشور الآن", status: true },
    ]}
    stackFacts
    coverAlt="متجر AL’ARD بتصميمه الجديد: القائمة الموسّعة لزيت الزيتون فوق مجموعة زيت الزيتون الفلسطيني."
  />

  <StudyGlance lang="ar" items={[
    { label: "النطاق", value: "متجر أمريكا", text: "ديسكتوب وموبايل، مبني على Shopify" },
    { label: "الحالة", value: "منشور", text: "التصميم الجديد منشور على alardproducts.com" },
  ]} />

  <section class="study-section study-overview" aria-labelledby="overview-title">
    <div class="container study-overview__grid">
      <div class="study-overview__head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>التحدي</p>
        <h2 class="study-overview__title" id="overview-title">قصة جميلة —<br>كان الشراء منها صعباً</h2>
      </div>
      <div class="study-overview__body">
        <div>
          <h3>السياق</h3>
          <p>تبيع AL’ARD زيت الزيتون الفلسطيني والأطعمة الحرفية — منتجات تراثية مرتبطة بعمق بالهوية الفلسطينية. وشملت إعادة التصميم متجرها الإلكتروني في الولايات المتحدة.</p>
        </div>
        <div>
          <h3>المطلوب</h3>
          <p>إعادة تصميم تركّز على رفع المبيعات وتجعل التسوق سهلاً على الديسكتوب والموبايل — دون أن تُضعف هوية العلامة التراثية الفلسطينية.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="problem-title">
    <div class="container">
      <StudyHead id="problem-title" eyebrow="01 — المشكلة" line1="ما الذي جعل التسوق" line2="في المتجر القديم صعباً" accent={false} />
      <ol class="study-facts study-facts--4">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">نوافذ منبثقة كثيرة</h3><p class="fact__text">صفحات رئيسية مزدحمة بنوافذ منبثقة متراكمة تتنافس على الانتباه.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">تنقّل مدفون</h3><p class="fact__text">الفئات الرئيسية مخفية داخل قائمة جانبية على الديسكتوب.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">أسفل الجزء الظاهر</h3><p class="fact__text">صورة المنتج والسعر وخيارات الحجم كلها أسفل الجزء الظاهر من الشاشة.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">مشكلات SEO متراكمة</h3><p class="fact__text">كشف تدقيق SEO للمتجر مشكلات هيكلية.</p></li>
      </ol>
      <h3 class="eyebrow study-subhead" id="worked-title"><span class="eyebrow__square" aria-hidden="true"></span>كيف عملت</h3>
      <ol class="study-facts study-facts--5">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">التدقيق</h3><p class="fact__text">نقاط الألم في UX ونتائج SEO</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">إعادة الهيكلة</h3><p class="fact__text">الكتالوج وهيكلة المعلومات حسب طريقة تسوق الناس</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">التصميم</h3><p class="fact__text">شاشات ديسكتوب + موبايل</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">النموذج الأولي</h3><p class="fact__text">نموذج تفاعلي على Figma</p></li>
        <li class="fact fact--md"><span class="fact__label">05</span><h3 class="fact__value">التحسين المستمر</h3><p class="fact__text">ملاحظات التسويق، وميزات جديدة، ومراجعات SEO</p></li>
      </ol>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="nav-title">
    <div class="container">
      <StudyHead id="nav-title" eyebrow="02 — قرار رئيسي · التنقّل وهيكلة المعلومات" line1="كل فئة على بُعد نقرة —" line2="من أي مكان في الصفحة" accent={false} />
      <ol class="study-facts study-facts--4">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">هيدر ثابت</h3><p class="fact__text">نُقل التنقّل الرئيسي من القائمة الجانبية إلى هيدر يرافق المتسوّق.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">قائمة موسّعة حسب النية</h3><p class="fact__text">تسوّق حسب الحاجة أو الحجم أو النوع — بالطريقة التي يقرّر بها الناس فعلاً.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">بطاقة ترويجية</h3><p class="fact__text">عروض موسمية مثل "أول عصرة في الموسم" داخل القائمة نفسها.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">هيدر يبدأ بالبحث</h3><p class="fact__text">شريط بحث عريض مع اقتراحات مفيدة: زيت زيتون، زعتر، صناديق هدايا.</p></li>
      </ol>
      <figure class="study-figure study-figure--after-facts">
        <StudyMedia project="alard" name="02-mega-menu-olive-oil" desktop={[1200, 487]} tablet={[704, 287]} mobile={[358, 145]} alt="القائمة الموسّعة لزيت الزيتون الفلسطيني في AL’ARD: تسوّق حسب الحاجة والحجم والنوع، مع بطاقة أول عصرة في الموسم." />
        <figcaption>القائمة الموسّعة لزيت الزيتون الفلسطيني — حسب الحاجة والحجم والنوع.</figcaption>
      </figure>
      <div class="study-next-block">
        <StudyHead id="home-title" eyebrow="03 — قرار رئيسي · الصفحة الرئيسية" line1="صفحة رئيسية أهدأ تبيع أكثر" />
      <ol class="study-facts study-facts--3">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">نوافذ منبثقة أقل</h3><p class="fact__text">رسالة واضحة واحدة في كل مرة بدل طبقات متراكمة.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">منتجات أكثر في الجزء الظاهر</h3><p class="fact__text">الأكثر مبيعاً يظهر من أول تمرير.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">"قارن الهدايا"</h3><p class="fact__text">يرشد المشترين حسب الميزانية والمناسبة — Mini، وPantry، وOlive Oil، وPremium.</p></li>
      </ol>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="pdp-title">
    <div class="container">
      <StudyHead id="pdp-title" eyebrow="04 — قرار رئيسي · صفحة المنتج" line1="صفحة المنتج،" line2="أُعيد بناؤها حول الجزء الظاهر" accent={false} />
      <ol class="study-facts study-facts--3">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">المعرض في الجزء الظاهر</h3><p class="fact__text">الصورة الرئيسية والمصغّرات ظاهرة دون تمرير.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">العنوان والتقييم والدليل</h3><p class="fact__text">وسوم حلال والحصاد، والتقييم، و"اشتراه +300" في الأعلى.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">السعر لكل وحدة</h3><p class="fact__text">السعر لكل مل يجعل خصم الكمية واضحاً بذاته.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">أحجام على شكل بطاقات</h3><p class="fact__text">كل حجم يعرض سعره وتوفيره الخاص.</p></li>
        <li class="fact fact--md"><span class="fact__label">05</span><h3 class="fact__value">اشترك ووفّر</h3><p class="fact__text">توصيل لمرة واحدة أو متكرر في خطوة واحدة.</p></li>
        <li class="fact fact--md"><span class="fact__label">06</span><h3 class="fact__value">شارات ثقة دائمة</h3><p class="fact__text">منشأ فلسطيني أصيل + حدّ الشحن المجاني.</p></li>
      </ol>
      <figure class="study-figure study-figure--after-facts">
        <StudyMedia project="alard" name="03-product-page" desktop={[1200, 894]} tablet={[704, 524]} mobile={[358, 281]} alt="صفحة منتج AL’ARD: المعرض، ووسوم حلال والحصاد، والتقييم، والسعر لكل مل، وبطاقات الأحجام، واشترك ووفّر، وشارات الثقة في الجزء الظاهر." />
        <figcaption>المعرض، والوسوم، والتقييم، والسعر لكل مل، وبطاقات الأحجام، واشترك ووفّر، وشارات الثقة — كلها في الجزء الظاهر.</figcaption>
      </figure>
    </div>
  </section>

  <section class="study-section study-section--card" aria-labelledby="mobile-title">
    <div class="container">
      <StudyHead id="mobile-title" eyebrow="05 — الموبايل" line1="مصمَّم للموبايل أيضاً" lead="صُمّمت الشاشات الرئيسية للهاتف أيضاً — الرئيسية، والقائمة الموسّعة، وصفحة المنتج، والفلاتر." />
      <figure class="study-figure study-group">
        <StudyMedia project="alard" name="04-mobile-screens" rtl desktop={[1200, 590]} tablet={[704, 346]} mobile={[358, 211]} alt="أربع شاشات موبايل من AL’ARD: الرئيسية، والقائمة الموسّعة لزيت الزيتون، وصفحة المنتج بالأحجام، وفلاتر كل المنتجات." />
        <figcaption class="study-group__captions study-group__captions--4 study-group__captions--center">
          <span>الرئيسية</span><span>القائمة الموسّعة — زيت الزيتون الفلسطيني</span><span>صفحة المنتج — الأحجام والسعر لكل مل</span><span>كل المنتجات — الفلاتر</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="conversion-title">
    <div class="container">
      <StudyHead id="conversion-title" eyebrow="06 — رفع المبيعات والهدايا وB2B" line1="أنماط لطلبات أكثر —" line2="وأكبر" lead="اشترك ووفّر، والحزم، والتقييمات، وصندوق تختار محتواه بنفسك، وشريط الشحن المجاني — مع مسار مخصص للهدايا وطلبات الشركات." accent={false} />
      <ol class="study-facts study-facts--3">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">فئات الهدايا</h3><p class="fact__text">حسب الميزانية والمناسبة، مقارنةً جنباً إلى جنب.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">إضافات</h3><p class="fact__text">كوفية، وتمر، وصابون نابلسي، ورعاية شجرة، وبطاقة هدية.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">B2B</h3><p class="fact__text">هدايا الشركات والكميات مع علامة مخصصة وشحن لعناوين متعددة.</p></li>
      </ol>
      <div class="study-pair study-pair--after">
        <figure class="study-figure">
          <StudyMedia project="alard" name="05-frequently-bought-together" desktop={[588, 447]} tablet={[704, 535]} mobile={[358, 271]} alt="يُشترى معاً عادةً في AL’ARD: طحينة وتمر مجهول، بسعر حزمة مخفّض 10%." />
          <figcaption>يُشترى معاً عادةً.</figcaption>
        </figure>
        <figure class="study-figure">
          <StudyMedia project="alard" name="06-cart-drawer-free-shipping" desktop={[588, 447]} tablet={[704, 535]} mobile={[358, 271]} alt="درج السلة في AL’ARD مع تقدّم الشحن المجاني ونقاط الولاء." />
          <figcaption>درج السلة — تقدّم الشحن المجاني ونقاط الولاء.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <StudyQuote
    quote="يفهم التوجّه جيداً، ويتجاوب مع الملاحظات، ويساعد في ترجمة أفكارنا إلى تجربة موقع أوضح وأسهل للمستخدم."
    name="أحمد النمر"
    role="مدير التسويق الرقمي، AL’ARD · نابلس، فلسطين"
    initials="أ ن"
  />

  <section class="study-section" aria-labelledby="outcome-title">
    <div class="container">
      <StudyHead id="outcome-title" eyebrow="07 — النتيجة" line1="رُوجع قبل سطر برمجة واحد —" line2="ومنشور الآن" accent={false} />
      <div class="study-outcome">
        <div>
          <h3>النتيجة</h3>
          <p class="study-outcome__lead">بنيت نموذجاً تفاعلياً على Figma قبل التطوير. راجعه مدير التسويق في AL’ARD وأرسل تعديلات وطلبات ميزات جديدة، ودقّق فريق SEO الموقع — فحوّلت الاثنين إلى تحديثات تصميم، والمتجر الأمريكي بتصميمه الجديد منشور الآن على alardproducts.com.</p>
        </div>
        <div>
          <h3>ماذا تعلّمت</h3>
          <p>إعادة التصميم لرفع المبيعات ليست مجرد تحديث بصري. أهداف العمل، وسهولة الاستخدام الحقيقية لجمهور واسع، ومتطلبات SEO، وما تدعمه بيئة التطوير — كلها شدّت في اتجاهات مختلفة. ومعظم العمل كان ضمان ألا تفوز أولوية على حساب الأخرى، مع إبقاء التراث الفلسطيني للعلامة في المقدمة.</p>
        </div>
      </div>
    </div>
  </section>

  <StudyCta lang="ar" title="تبيع أونلاين، لكنك تخسر المتسوّقين قبل الدفع؟" text="أخبرني عن متجرك، وأين يتوقف الناس." />
</article>

<StudyNext current="alard" lang="ar" />

</Layout>
