---
import Layout from "../../../layouts/Layout.astro";
import StudyHero from "../../../components/study/StudyHero.astro";
import StudyGlance from "../../../components/study/StudyGlance.astro";
import StudyHead from "../../../components/study/StudyHead.astro";
import StudyMedia from "../../../components/study/StudyMedia.astro";
import StudyQuote from "../../../components/study/StudyQuote.astro";
import StudyCta from "../../../components/study/StudyCta.astro";
import StudyNext from "../../../components/study/StudyNext.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "VBooking — منصة سفر واحدة بوجهين",
    "description": "مجتمع للمسافرين مع تخطيط رحلات بالذكاء الاصطناعي وخبراء سفر حقيقيين، ومساحة عمل لوكلاء السفر توحّد الحجز ومسار CRM ومساعد Ask Genie الذكي.",
    "url": "https://abdulazizabudhair.com/ar/work/vbooking",
    "image": "https://abdulazizabudhair.com/assets/img/og-vbooking.jpg",
    "author": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "creator": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "genre": "تقنيات السفر · مستهلكين وشركات",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "أعمالي", "item": "https://abdulazizabudhair.com/ar#work" },
      { "@type": "ListItem", "position": 3, "name": "VBooking", "item": "https://abdulazizabudhair.com/ar/work/vbooking" }
    ]
  }
];
---
<Layout
  title="VBooking — دراسة حالة · عبدالعزيز أبو ضهير"
  description="مجتمع للمسافرين يجمع تخطيط الرحلات بالذكاء الاصطناعي وخبراء سفر حقيقيين، ومساحة عمل للوكلاء توحّد الحجز وخط مبيعات CRM والمساعد الذكي Ask Genie."
  path="/ar/work/vbooking"
  alternate="/work/vbooking"
  lang="ar"
  ogType="article"
  ogImage="og-vbooking.jpg"
  jsonLd={jsonLd}
  study
>
<article class="study" aria-labelledby="case-title">
  <StudyHero
    lang="ar"
    project="vbooking"
    eyebrow="دراسة حالة · تقنيات السفر · B2C + B2B"
    title="VBooking"
    subtitle="منصة سفر واحدة بجانبين — المسافرون ووكلاء السفر"
    lead="مجتمع للمسافرين يجمع تخطيط الرحلات بالذكاء الاصطناعي وخبراء سفر حقيقيين، ومساحة عمل للوكلاء توحّد الحجز وخط مبيعات CRM والمساعد الذكي Ask Genie."
    facts={[
      { label: "دوري", value: "مصمم UX/UI رئيسي، وحدي من البداية للنهاية" },
      { label: "المنصة", value: "Community (ويب + موبايل)، وTurbo Suite للوكلاء، والموقع التسويقي" },
      { label: "المدة", value: "11 شهراً · أغسطس 2024 – يونيو 2025" },
      { label: "الحالة", value: "الجانبان متاحان بنسخة تجريبية", status: true },
    ]}
    coverAlt="صفحة رحلة في VBooking Community لمغامرة 7 أيام في طوكيو ومدن اليابان، فوق خط مبيعات CRM في Turbo Suite."
  />

  <StudyGlance lang="ar" items={[
    { label: "النطاق", value: "منصتان", text: "Community للمسافرين + Turbo Suite للوكلاء" },
    { label: "الحالة", value: "نسخة تجريبية منشورة", text: "منشور بنسخة تجريبية للمسافرين والوكلاء" },
  ]} />

  <section class="study-section study-overview" aria-labelledby="overview-title">
    <div class="container study-overview__grid">
      <div class="study-overview__head">
        <p class="eyebrow"><span class="eyebrow__square" aria-hidden="true"></span>التحدي</p>
        <h2 class="study-overview__title" id="overview-title">المسافرون يريدون الثقة.<br>الوكلاء يريدون السرعة.</h2>
      </div>
      <div class="study-overview__body">
        <div>
          <h3>السياق</h3>
          <p>هدفت VBooking إلى توحيد قطاع سفر مجزّأ في منصة واحدة بجانبين: Community، حيث يخطط المسافرون رحلاتهم ويحجزونها، وTurbo Suite، حيث يبني وكلاء السفر الرحلات ويبيعونها. يلتقي الجانبان على الرحلة نفسها — طلب من مسافر في Community يصل كعميل محتمل في خط مبيعات الوكيل.</p>
        </div>
        <div>
          <h3>المشكلة</h3>
          <p>لم يعرف المسافرون نصيحة من يثقون بها، وتجميع رحلة كاملة كان يعني التنقّل بين مواقع منفصلة. وكان لدى الوكلاء المشكلة المعاكسة: أدوات منفصلة للبحث والتسعير وCRM والمالية، وأسعار تتقادم، ولا مكان واحد لمتابعة العميل من أول تواصل حتى الدفع.</p>
        </div>
        <ul class="study-sides">
          <li class="fact"><span class="fact__label">COMMUNITY · للمسافرين</span><p>الثقة، ومكان واحد للتخطيط.</p></li>
          <li class="fact"><span class="fact__label">TURBO SUITE · للوكلاء</span><p>السرعة، والتحكم بأرقامهم.</p></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="community-title">
    <div class="container">
      <StudyHead id="community-title" eyebrow="01 — COMMUNITY · للمسافرين" line1="ثلاث طرق لبدء الرحلة — وشخص حقيقي" line2="خلف كل عرض سعر" lead="لم تكن الفجوة في المعلومات — بل في الثقة، وغياب طريق واحد معروف للوصول إلى إجابة حقيقية." accent={false} />
      <ol class="study-decisions">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">ثلاث طرق للتخطيط</h3><p class="fact__text">بالذكاء الاصطناعي، أو يدوياً، أو مع خبير سفر حقيقي — من نقطة الدخول نفسها، بعد استكشاف ثلاثة تصاميم لإبراز الخيار ومراجعتها مع أصحاب القرار. فرابط واحد مدفون كان يعني أن الناس يكتفون بالتصفح وحدهم.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">مسودة بالذكاء الاصطناعي، وسعر من إنسان</h3><p class="fact__text">يُنتج المخطِّط الذكي برنامجاً كاملاً يوماً بيوم مع خريطة قبل طلب الدفع، ثم يحوّل زر "Send Request" تلك المسودة إلى عرض حقيقي يسعّره إنسان.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">صفحات الوجهات كمركز واحد</h3><p class="fact__text">الفنادق، والأنشطة، والمطاعم، وتأجير السيارات، والمقالات معاً — بدل أن تتوزّع على أقسام متفرقة.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">خبراء بملفات عامة</h3><p class="fact__text">تقييمات ومتابعون وباقاتهم الخاصة، فيُجاب عن سؤال "بمن أثق" بالدليل الاجتماعي الذي يعتمد عليه الناس أصلاً.</p></li>
      </ol>
      <div class="study-pair study-pair--after">
        <figure class="study-figure">
          <StudyMedia project="vbooking" name="02-destination-hub-tokyo" desktop={[588, 477]} tablet={[704, 571]} mobile={[358, 288]} alt="مركز وجهة طوكيو في VBooking مع المعلومات وملخص بالذكاء الاصطناعي واختصارات للفنادق والأنشطة." />
          <figcaption>مركز وجهة طوكيو — معلومات، وملخص بالذكاء الاصطناعي، واختصارات للفنادق والأنشطة وغيرها.</figcaption>
        </figure>
        <figure class="study-figure">
          <StudyMedia project="vbooking" name="03-travel-expert-profile" desktop={[588, 477]} tablet={[704, 571]} mobile={[358, 288]} alt="ملف خبير سفر في VBooking مع التقييمات والمتابعين والباقات." />
          <figcaption>ملف خبير السفر — التقييمات والمتابعون والباقات.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="study-section" aria-labelledby="turbo-title">
    <div class="container">
      <StudyHead id="turbo-title" eyebrow="02 — TURBO SUITE · لوكلاء السفر" line1="مساحة عمل واحدة من أول تواصل" line2="حتى الدفع" lead={'لا يبحث الوكلاء عن المتعة — بل عن السرعة والتحكم بأرقامهم. وُزن كل قرار بسؤال: "هل يوفّر هذا خطوة؟"'} accent={false} />
      <ol class="study-decisions">
        <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">خط مبيعات CRM واحد</h3><p class="fact__text">كل عميل محتمل في عرض Kanban واحد، فلا يحتاج الوكيل لفتح نظامين ليعرف أين وصلت الصفقة.</p></li>
        <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">أرقام لحظية في الواجهة</h3><p class="fact__text">المخزون والانكشاف المالي — الطلبات غير المدفوعة، وحدود العقود، والإلغاءات — على لوحة التحكم الرئيسية، لأن الأرقام القديمة كانت الشكوى بالضبط.</p></li>
        <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">منشئ البرامج، يوماً بيوم</h3><p class="fact__text">رحلات طيران وفنادق ومطاعم ومواصلات — مع اختصار "Generate with AI"، فيتحوّل طلب العميل إلى باقة مسعّرة خلال دقائق.</p></li>
        <li class="fact fact--md"><span class="fact__label">04</span><h3 class="fact__value">Ask Genie كتبويب أساسي</h3><p class="fact__text">ليس لوحة جانبية: يصف الوكلاء ما يحتاجه العميل بلغة بسيطة ويحصلون على العروض فوراً.</p></li>
      </ol>
      <figure class="study-figure study-figure--after-facts">
        <StudyMedia project="vbooking" name="05-turbo-crm-pipeline" desktop={[1200, 775]} tablet={[704, 455]} mobile={[358, 241]} alt="خط مبيعات CRM في Turbo Suite من VBooking: كل عميل محتمل في عرض Kanban واحد من New إلى Paid." />
        <figcaption>خط مبيعات CRM — كل عميل محتمل في عرض Kanban واحد: New ← Sent ← Follow ups ← Viewed ← Paid.</figcaption>
      </figure>
      <div class="study-pair study-pair--after">
        <figure class="study-figure">
          <StudyMedia project="vbooking" name="04-itinerary-builder" desktop={[588, 477]} tablet={[704, 571]} mobile={[358, 288]} alt="منشئ البرامج في Turbo Suite من VBooking: عرض سعر لطوكيو يوماً بيوم." />
          <figcaption>منشئ البرامج — عرض سعر لطوكيو يوماً بيوم مع Generate with AI.</figcaption>
        </figure>
        <figure class="study-figure">
          <StudyMedia project="vbooking" name="06-turbo-suite-home" desktop={[588, 477]} tablet={[704, 571]} mobile={[358, 288]} alt="الصفحة الرئيسية لـ Turbo Suite من VBooking: Ask Genie وأحدث العروض وتحليلات المبيعات." />
          <figcaption>الصفحة الرئيسية لـ Turbo Suite — Ask Genie، وأحدث العروض، وتحليلات المبيعات.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="study-section study-section--muted" aria-labelledby="marketing-title">
    <div class="container">
      <StudyHead id="marketing-title" eyebrow="03 — الموقع التسويقي · الباب الأمامي" line1="باب أمامي واحد" line2="لمنصة متعددة المنتجات" lead="تبيع VBooking منتجات كثيرة لأعمال مختلفة جداً. وكان على الصفحة الرئيسية أن تتيح لكل زائر إيجاد طريقه خلال تمرير واحد." accent={false} />
      <div class="study-split study-split--marketing">
        <figure class="study-figure">
          <StudyMedia project="vbooking" name="07-marketing-homepage" desktop={[588, 627]} tablet={[704, 751]} mobile={[358, 380]} alt="الصفحة الرئيسية لموقع VBooking التسويقي: بطاقات المنتجات، وTurbo Suite حسب نوع العمل، ونقاط دخول حسب الدور." />
          <figcaption>الصفحة الرئيسية لـ VBooking.</figcaption>
        </figure>
        <ol class="study-decisions study-decisions--stack">
          <li class="fact fact--md"><span class="fact__label">01</span><h3 class="fact__value">المنتجات كصف واحد من البطاقات</h3><p class="fact__text">محرك بحث، ووكيل ذكي، ومنشئ عطلات، وCRM وغيرها — اتساع المنصة يُقرأ بنظرة قبل أي تفاصيل.</p></li>
          <li class="fact fact--md"><span class="fact__label">02</span><h3 class="fact__value">Turbo Suite حسب نوع المشتري</h3><p class="fact__text">منظمو الرحلات بالجملة، ووكالات الاستقبال، ووكالات السفر الإلكترونية، ومديرو الإيجارات السياحية — لكل منهم رسالته وزر "Book Demo".</p></li>
          <li class="fact fact--md"><span class="fact__label">03</span><h3 class="fact__value">نقاط دخول حسب الدور</h3><p class="fact__text">مسافر، خبير سفر، وكيل سفر — يوجّه الموقع كل زائر مباشرة إلى الجانب الصحيح من المنصة.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <StudyQuote
    quote="بناءً على تجربتي الطويلة في العمل معه، أستطيع القول بصدق إن لمساته الإبداعية دائماً متقنة ومدروسة. هو محترف للغاية، ومتعاون بشكل استثنائي، ولم يقصّر في أي مرحلة. أنصح بشدة بالعمل معه."
    name="عمري أبو ماضي"
    role="مؤسس VBooking · دبي، الإمارات"
    initials="ع أ"
  />

  <section class="study-section" aria-labelledby="outcome-title">
    <div class="container">
      <StudyHead id="outcome-title" eyebrow="04 — النتيجة" line1="الجانبان متاحان بنسخة تجريبية" />
      <div class="study-outcome">
        <div>
          <h3>النتيجة</h3>
          <p class="study-outcome__lead">أُطلق الجانبان كنسخ تجريبية منشورة، نشطة لكنها غير مفتوحة للسوق العام بعد. وطوال المشروع راجعت كل مرحلة مع أصحاب القرار في VBooking — ملاحظاتهم شكّلت فكرة نقاط الدخول الثلاث للتخطيط، وأظهرت أين ما زال التنقّل القديم بين الأدوات يتسرّب إلى سير العمل الجديد، وهي توجّه الآن التحضير للإطلاق الكامل.</p>
        </div>
        <div>
          <h3>ماذا تعلّمت</h3>
          <p>تصميم المنصتين معاً أوضح أن المسافر وخبير السفر ووكيل السفر ثلاثة أشخاص مختلفين حتى وهم ينظرون إلى الرحلة نفسها. وحدّد التحليل المكثّف للمنافسين أين اختارت VBooking أن تتميّز: الجمع بين التخطيط بالذكاء الاصطناعي وإنسان حقيقي خلف كل عرض سعر، وخط مبيعات CRM موحّد بدل تكرار ما تفعله كل أداة حجز أخرى.</p>
        </div>
      </div>
    </div>
  </section>

  <StudyCta lang="ar" title="تبني منصة بأكثر من جانب؟" text="أخبرني من تخدم، وأين تلتقي رحلاتهم." />
</article>

<StudyNext current="vbooking" lang="ar" />

</Layout>
