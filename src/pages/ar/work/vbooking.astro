---
import Layout from "../../../layouts/Layout.astro";
import Testimonials from "../../../components/Testimonials.astro";
import NextProject from "../../../components/NextProject.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "VBooking — منصة سفر واحدة بوجهين",
    "description": "مجتمع للمسافرين مع تخطيط رحلات بالذكاء الاصطناعي وخبراء سفر حقيقيين، ومساحة عمل لوكلاء السفر توحّد الحجز ومسار CRM ومساعد Ask Genie الذكي.",
    "url": "https://abdulazizabudhair.com/ar/work/vbooking",
    "image": "https://abdulazizabudhair.com/assets/img/og-vbooking.jpg",
    "author": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "creator": { "@type": "Person", "name": "عبدالعزيز أبو ضهير", "url": "https://abdulazizabudhair.com/ar" },
    "genre": "تقنيات السفر · مستهلكين وشركات",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://abdulazizabudhair.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "أعمالي", "item": "https://abdulazizabudhair.com/ar#work" },
      { "@type": "ListItem", "position": 3, "name": "VBooking", "item": "https://abdulazizabudhair.com/ar/work/vbooking" }
    ]
  }
];
---
<Layout
  title="VBooking — دراسة حالة · عبدالعزيز أبو ضهير"
  description="مجتمع للمسافرين مع تخطيط رحلات بالذكاء الاصطناعي وخبراء سفر حقيقيين، ومساحة عمل لوكلاء السفر توحّد الحجز ومسار CRM ومساعد Ask Genie الذكي — صُممت كنظام واحد من البداية إلى النهاية."
  path="/ar/work/vbooking"
  alternate="/work/vbooking"
  lang="ar"
  ogType="article"
  ogImage="og-vbooking.jpg"
  jsonLd={jsonLd}
>
<article class="case" aria-labelledby="case-title">
  <div class="container cs-hero">
    <a class="back-link text-link" href="/ar/#work"><span aria-hidden="true">→</span> العودة إلى الأعمال</a>
    <p class="cs-hero__eyebrow">دراسة حالة · تقنيات السفر · مستهلكين وشركات</p>
    <h1 class="cs-hero__title" id="case-title">VBooking</h1>
    <p class="cs-hero__subtitle">منصة سفر واحدة، بوجهين — المسافرون ووكلاء السفر. مجتمع للمسافرين مع تخطيط رحلات بالذكاء الاصطناعي وخبراء سفر حقيقيين، ومساحة عمل للوكلاء توحّد الحجز ومسار CRM ومساعد Ask Genie الذكي.</p>
    <dl class="cs-hero__facts">
      <div><dt>دوري</dt><dd>مصمم UX/UI رئيسي، منفردًا من البداية إلى النهاية</dd></div>
      <div><dt>المنصة</dt><dd>المجتمع (ويب وجوال)، Turbo Suite للوكلاء، والموقع التسويقي</dd></div>
      <div><dt>المدة</dt><dd>11 شهرًا · أغسطس 2024 – يونيو 2025</dd></div>
      <div><dt>الحالة</dt><dd class="cs-status"><span class="work-card__dot" aria-hidden="true"></span>الوجهان يعملان بنسخة تجريبية</dd></div>
    </dl>
    <nav class="cs-onthispage" aria-label="في هذه الصفحة">
      <span class="cs-onthispage__label">في هذه الصفحة</span>
      <a href="#overview">نظرة عامة</a>
      <a href="#community">المجتمع</a>
      <a href="#turbo-suite">Turbo Suite</a>
      <a href="#marketing-site">الموقع التسويقي</a>
      <a href="#outcome">النتيجة</a>
    </nav>
  </div>

  <div class="container">
    <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
      <img src="/assets/img/vbooking-cs-hero-1040.webp" srcset="/assets/img/vbooking-cs-hero-1040.webp 1040w, /assets/img/vbooking-cs-hero-2080.webp 2080w" sizes="(min-width: 1280px) 1040px, 90vw" width="1040" height="676" fetchpriority="high" decoding="async" alt="صفحة رحلة في مجتمع VBooking: مغامرة 7 أيام في طوكيو ومدن اليابان.">
    </div>
  </div>

  <div class="container cs-section">
    <p class="fact-card__label">المشروع في لمحة</p>
    <div class="cs-glance">
      <div class="fact-card"><p class="fact-card__value">منصتان</p><p class="fact-card__text">مجتمع للمسافرين + Turbo Suite للوكلاء</p></div>
      <div class="fact-card"><p class="fact-card__value">نسخة تجريبية فعّالة</p><p class="fact-card__text">تعمل بنسخة تجريبية للمسافرين والوكلاء</p></div>
    </div>
  </div>

  <div class="container cs-section" id="overview">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>التحدي</div>
    <h2 class="cs-title">المسافرون يريدون الثقة. الوكلاء يريدون السرعة.</h2>
    <div class="cs-prose">
      <div>
        <h3>السياق</h3>
        <p>سعت VBooking لتوحيد صناعة سفر مجزّأة تحت منصة واحدة بوجهين: Community، حيث يخطط المسافرون رحلاتهم ويحجزونها، وTurbo Suite، حيث يبنيها وكلاء السفر ويبيعونها. يلتقي الوجهان في الرحلة نفسها — طلب من مسافر في Community يصل كفرصة بيع في مسار وكيل.</p>
      </div>
      <div>
        <h3>المشكلة</h3>
        <p>لم يكن المسافرون يعرفون بمن يثقون، وتجميع رحلة كاملة يعني التنقل بين مواقع منفصلة. وكان لدى الوكلاء المشكلة المعاكسة: أدوات منفصلة للبحث والتسعير وCRM والمالية، أسعار تصبح قديمة، ولا مكان واحد لمتابعة فرصة بيع من أول تواصل حتى الدفع.</p>
      </div>
    </div>
    <div class="cs-glance" style={{ marginTop: "32px" }}>
      <div class="fact-card">
        <p class="fact-card__label">للمسافرين</p>
        <p class="fact-card__value" style={{ fontSize: "1.5rem", marginTop: "10px" }}>ثقة، ومكان واحد للتخطيط.</p>
      </div>
      <div class="fact-card">
        <p class="fact-card__label">للوكلاء</p>
        <p class="fact-card__value" style={{ fontSize: "1.5rem", marginTop: "10px" }}>سرعة، وتحكّم بأرقامهم الخاصة.</p>
      </div>
    </div>
  </div>

  <div class="container cs-section" id="community">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>01 — Community · للمسافرين</div>
    <h2 class="cs-title">ثلاث طرق لبدء رحلة — وشخص حقيقي خلف كل عرض سعر</h2>
    <p class="cs-lead">الفجوة لم تكن في المعلومات — بل في الثقة، وغياب مسار واحد معروف للوصول إلى إجابة حقيقية.</p>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">ثلاث طرق للتخطيط</p><p class="fact-card__text">ذكاء اصطناعي، يدوي، أو خبير سفر حقيقي — من نقطة دخول واحدة، بعد تجربة ثلاثة تخطيطات لإظهار الخيار ومراجعتها مع أصحاب القرار. رابط واحد مدفون كان يجعل الناس يكتفون بالتصفح وحدهم.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">مسودة ذكاء اصطناعي، سعر بشري</p><p class="fact-card__text">يُنتج مخطط الذكاء الاصطناعي خط سير كاملًا يومًا بيوم مع خريطة قبل طلب الدفع، ثم يحوّل زر "أرسل الطلب" تلك المسودة إلى عرض حقيقي مُسعّر من إنسان.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">صفحات الوجهات كمركز واحد</p><p class="fact-card__text">الفنادق والأنشطة والمطاعم وتأجير السيارات والمقالات معًا — بدل تفرقها بين أقسام.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">خبراء بملف شخصي عام</p><p class="fact-card__text">تقييمات، متابعون، وباقاتهم الخاصة، فيُجاب سؤال "بمن أثق" بالدليل الاجتماعي الذي يعتمد عليه الناس أصلًا.</p></div>
    </div>
    <div class="cs-grid cs-grid--2" style={{ marginTop: "48px" }}>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
          <img src="/assets/img/vbooking-cs-community-1-524.webp" srcset="/assets/img/vbooking-cs-community-1-524.webp 524w, /assets/img/vbooking-cs-community-1-1048.webp 1048w" sizes="524px" width="524" height="396" loading="lazy" decoding="async" alt="مركز وجهة طوكيو في VBooking مع معلومات وملخص ذكاء اصطناعي واختصارات للفنادق والأنشطة.">
        </div>
        <figcaption>مركز وجهة طوكيو — معلومات، ملخص ذكاء اصطناعي، واختصارات للفنادق والأنشطة وأكثر.</figcaption>
      </figure>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
          <img src="/assets/img/vbooking-cs-community-2-524.webp" srcset="/assets/img/vbooking-cs-community-2-524.webp 524w, /assets/img/vbooking-cs-community-2-1048.webp 1048w" sizes="524px" width="524" height="397" loading="lazy" decoding="async" alt="ملف خبير سفر في VBooking مع التقييمات والمتابعين والباقات.">
        </div>
        <figcaption>ملف خبير السفر — التقييمات والمتابعون والباقات.</figcaption>
      </figure>
    </div>
  </div>

  <div class="container cs-section" id="turbo-suite">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>02 — Turbo Suite · لوكلاء السفر</div>
    <h2 class="cs-title">مساحة عمل واحدة من أول تواصل حتى الدفع</h2>
    <p class="cs-lead">الوكلاء لا يريدون بهجة — يريدون سرعة وتحكمًا بأرقامهم. كل قرار قِيس بمقياس واحد: "هل يوفّر هذا خطوة؟"</p>
    <div class="cs-decisions">
      <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">مسار CRM واحد</p><p class="fact-card__text">كل فرصة واردة في عرض Kanban واحد، فلا يحتاج الوكيل أبدًا لفحص نظامين ليعرف أين تقف الصفقة.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">أرقام لحظية في الواجهة</p><p class="fact-card__text">المخزون والتعرض المالي — طلبات غير مدفوعة، حدود العقود، الإلغاءات — في لوحة التحكم الرئيسية، لأن الأرقام القديمة كانت الشكوى بالذات.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">باني خط سير، يومًا بيوم</p><p class="fact-card__text">طيران، فنادق، مطاعم، نقل — مع اختصار "أنشئ بالذكاء الاصطناعي"، فيتحول طلب عميل إلى باقة مُسعّرة خلال دقائق.</p></div>
      <div class="fact-card fact-card--decision"><p class="fact-card__label">04</p><p class="fact-card__value">Ask Genie كتبويب أساسي</p><p class="fact-card__text">ليس لوحة جانبية: يصف الوكلاء ما يحتاجه العميل بلغة بسيطة ويحصلون على عروض فورًا.</p></div>
    </div>
    <figure style={{ marginTop: "48px" }}>
      <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
        <img src="/assets/img/vbooking-cs-crm-1264.webp" srcset="/assets/img/vbooking-cs-crm-1264.webp 1264w, /assets/img/vbooking-cs-crm-2528.webp 2528w" sizes="(min-width: 1280px) 1264px, 90vw" width="1264" height="822" loading="lazy" decoding="async" alt="مسار CRM في Turbo Suite: كل فرصة بيع في عرض Kanban واحد من جديد إلى مدفوع.">
      </div>
      <figcaption>مسار CRM — كل فرصة بيع في عرض Kanban واحد: جديد ← مُرسَل ← متابعات ← مُشاهَد ← مدفوع.</figcaption>
    </figure>
    <div class="cs-grid cs-grid--2" style={{ marginTop: "48px" }}>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
          <img src="/assets/img/vbooking-cs-itinerary-524.webp" srcset="/assets/img/vbooking-cs-itinerary-524.webp 524w, /assets/img/vbooking-cs-itinerary-1048.webp 1048w" sizes="524px" width="524" height="396" loading="lazy" decoding="async" alt="باني خط سير في Turbo Suite: عرض سعر يومي لرحلة طوكيو.">
        </div>
        <figcaption>باني خط السير — عرض سعر يومي لرحلة طوكيو مع ميزة "أنشئ بالذكاء الاصطناعي".</figcaption>
      </figure>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
          <img src="/assets/img/vbooking-cs-turbohome-524.webp" srcset="/assets/img/vbooking-cs-turbohome-524.webp 524w, /assets/img/vbooking-cs-turbohome-1048.webp 1048w" sizes="524px" width="524" height="397" loading="lazy" decoding="async" alt="الصفحة الرئيسية لـTurbo Suite: Ask Genie، أحدث العروض وتحليلات المبيعات.">
        </div>
        <figcaption>الصفحة الرئيسية لـTurbo Suite — Ask Genie، أحدث العروض وتحليلات المبيعات.</figcaption>
      </figure>
    </div>
  </div>

  <div class="container cs-section" id="marketing-site">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>03 — الموقع التسويقي · الباب الأمامي</div>
    <h2 class="cs-title">باب أمامي واحد لمنصة متعددة المنتجات</h2>
    <p class="cs-lead">تبيع VBooking منتجات كثيرة لأنواع مختلفة جدًا من الأعمال. كان على الصفحة الرئيسية أن تمنح كل زائر طريقه الخاص خلال تمريرة واحدة.</p>
    <div class="cs-grid cs-grid--2" style={{ marginTop: "40px", alignItems: "start" }}>
      <figure>
        <div class="cs-panel" style={{ background: "var(--project-vbooking)" }}>
          <img src="/assets/img/vbooking-cs-marketing-524.webp" srcset="/assets/img/vbooking-cs-marketing-524.webp 524w, /assets/img/vbooking-cs-marketing-1048.webp 1048w" sizes="524px" width="524" height="547" loading="lazy" decoding="async" alt="الصفحة الرئيسية التسويقية لـVBooking.">
        </div>
        <figcaption>الصفحة الرئيسية لـVBooking.</figcaption>
      </figure>
      <div style={{ display: "flex", flexDirection: "column", gap: "24px" }}>
        <div class="fact-card fact-card--decision"><p class="fact-card__label">01</p><p class="fact-card__value">المنتجات كصف بلاطات واحد</p><p class="fact-card__text">محرك بحث، وكيل ذكاء اصطناعي، باني عطلات، CRM وأكثر — يظهر اتساع المنصة بنظرة واحدة قبل أي تفصيل.</p></div>
        <div class="fact-card fact-card--decision"><p class="fact-card__label">02</p><p class="fact-card__value">Turbo Suite حسب المشتري</p><p class="fact-card__text">منظمو جولات بالجملة، وكالات استقبال، وكالات سفر إلكترونية، مدراء تأجير عطلات — لكل منهم عرضه الخاص وزر "احجز عرضًا تجريبيًا".</p></div>
        <div class="fact-card fact-card--decision"><p class="fact-card__label">03</p><p class="fact-card__value">نقاط دخول حسب الدور</p><p class="fact-card__text">مسافر، خبير سفر، وكيل سفر — يسلّم الموقع كل زائر مباشرة إلى الجانب الصحيح من المنصة.</p></div>
      </div>
    </div>
  </div>

  <div class="container cs-section">
    <figure class="cs-quote">
      <span class="cs-quote__mark" aria-hidden="true">&ldquo;</span>
      <blockquote><p>من خلال تجربتي الطويلة في العمل معه، أستطيع القول بصدق إن لمساته الإبداعية دائمًا متقنة ومدروسة بعناية. هو محترف للغاية، ومتعاون بشكل استثنائي، ولم يقصّر في أي مرحلة. أنصح بشدة بالعمل معه.</p></blockquote>
      <figcaption>
        <span class="testimonial-card__avatar" aria-hidden="true">عأ</span>
        <span class="testimonial-card__who"><cite>عمري أبو ماضي</cite><span>مؤسس VBooking · دبي، الإمارات</span></span>
      </figcaption>
    </figure>
  </div>

  <div class="container cs-section" id="outcome">
    <div class="cs-eyebrow"><span class="cs-eyebrow__square"></span>04 — النتيجة</div>
    <h2 class="cs-title">الوجهان يعملان بنسخة تجريبية</h2>
    <div class="cs-outcome">
      <div>
        <h3>النتيجة</h3>
        <p>انطلق الوجهان كنسختين تجريبيتين فعّالتين، نشطتين لكن لم تُفتحا بعد للسوق العام. راجعتُ كل مرحلة طوال المشروع مع أصحاب القرار في VBooking — شكّلت ملاحظاتهم نهج نقاط الدخول الثلاث للتخطيط، وكشفت أين ما زال تنقل الأدوات القديم يتسرب إلى النظام الجديد، وهي الآن توجّه التحضير للإطلاق الكامل.</p>
      </div>
      <div>
        <h3>ما تعلمته</h3>
        <p>تصميم المنصتين معًا أوضح أن المسافر وخبير السفر ووكيل السفر ثلاثة أشخاص مختلفين حتى وهم ينظرون إلى الرحلة نفسها. تحليل منافسين مكثّف وجّه أين اختارت VBooking أن تتميز: قرن تخطيط الذكاء الاصطناعي بإنسان حقيقي خلف كل عرض سعر، ومسار CRM موحّد بدل تكرار ما تفعله كل أداة حجز أخرى.</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="cs-cta">
      <div>
        <h2>تبني منصة بأكثر من وجه؟</h2>
        <p>أخبرني من تخدم، وأين تلتقي مساراتهم.</p>
      </div>
      <a class="btn btn--primary btn--xl" href="/ar/#contact">لنتحدث</a>
    </div>
  </div>
</article>

<NextProject current="vbooking" lang="ar" />

<Testimonials lang="ar" />

</Layout>
