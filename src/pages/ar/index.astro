---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Process from "../../components/Process.astro";
import About from "../../components/About.astro";
import Testimonials from "../../components/Testimonials.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { projects } from "../../data/projects";
import { ui } from "../../i18n/ui";

const t = ui.ar;

// Same person as the English home page (@id), described in Arabic.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://abdulazizabudhair.com/#person",
  "name": "عبدالعزيز أبو ضهير",
  "alternateName": ["Abdulaziz Abu Dhair", "عبد العزيز أبو ضهير", "Abdulaziz Abudhair"],
  "jobTitle": "مصمم منتجات أول (UX/UI)",
  "image": "https://abdulazizabudhair.com/assets/img/abdulaziz-portrait-v4-960.webp",
  "url": "https://abdulazizabudhair.com/ar",
  "email": "mailto:abdulaziz.abudhair@gmail.com",
  "telephone": "+970599835978",
  "sameAs": [
    "https://linkedin.com/in/abdulaziz-abudhair",
    "https://www.behance.net/abdulazizabudhair",
    "https://www.upwork.com/freelancers/~01608bf0df4b2dc6fd"
  ]
};
---
<Layout
  title="عبدالعزيز أبو ضهير — مصمم منتجات أول (UX/UI)"
  description="مصمم منتجات أول بخبرة تزيد على 15 عامًا في تصميم منتجات المؤسسات والرعاية الصحية والسفر والتقنية المالية، لفرق البحث والتطوير في شركات Fortune 500 وللشركات الناشئة."
  path="/ar"
  alternate="/"
  lang="ar"
  jsonLd={jsonLd}
  home
>
<Hero lang="ar" />

<!-- Clients -->
<section class="clients" aria-labelledby="clients-title">
  <h2 class="visually-hidden" id="clients-title">العملاء والشركاء</h2>
  <LogoMarquee lang="ar" />
</section>

<!-- Selected work -->
<section class="work" id="work" aria-labelledby="work-title">
  <span id="case-studies" aria-hidden="true"></span>{/* old links to /#case-studies */}
  <div class="container">
    <div class="work__head reveal">
      <Eyebrow label={t.workEyebrow} rtl />
      <h2 class="work__title" id="work-title">{t.workTitle}</h2>
    </div>
    <ol class="work__grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i + 1} lang="ar" />)}
    </ol>
  </div>
</section>

<Process lang="ar" />
<About lang="ar" />
<Testimonials lang="ar" />

</Layout>
