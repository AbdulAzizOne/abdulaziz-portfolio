---
import Layout from "../../layouts/Layout.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Testimonials from "../../components/Testimonials.astro";
import FeaturedQuote from "../../components/FeaturedQuote.astro";
import { projects } from "../../data/projects";

// Same person as the English home page (@id), described in Arabic.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://abdulazizabudhair.com/#person",
  "name": "عبدالعزيز أبو ضهير",
  "alternateName": ["Abdulaziz Abu Dhair", "عبد العزيز أبو ضهير", "Abdulaziz Abudhair"],
  "jobTitle": "مصمم منتجات أول (UX/UI)",
  "image": "https://abdulazizabudhair.com/assets/img/abdulaziz-portrait-v4-960.webp",
  "url": "https://abdulazizabudhair.com/ar",
  "email": "mailto:abdulaziz.abudhair@gmail.com",
  "telephone": "+970599835978",
  "sameAs": [
    "https://linkedin.com/in/abdulaziz-abudhair",
    "https://www.behance.net/abdulazizabudhair",
    "https://www.upwork.com/freelancers/~01608bf0df4b2dc6fd"
  ]
};
---
<Layout
  title="عبدالعزيز أبو ضهير — مصمم منتجات أول (UX/UI)"
  description="مصمم منتجات أول بخبرة تزيد على 15 عامًا في تصميم منتجات المؤسسات والرعاية الصحية والسفر والتقنية المالية، لفرق البحث والتطوير في شركات Fortune 500 وللشركات الناشئة."
  path="/ar"
  alternate="/"
  lang="ar"
  jsonLd={jsonLd}
  home
>
<!-- Hero -->
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__inner">
      <p class="eyebrow">مصمم منتجات مستقل · نابلس، فلسطين</p>
      <h1 class="hero__title" id="hero-title">أجعل المنتجات المعقّدة <em>سهلة الاستخدام.</em></h1>
      <p class="hero__lead">مصمم منتجات أول بخبرة تزيد على 15 عامًا مع فرق شركات <bdi>Fortune 500</bdi> والشركات الناشئة — من الاكتشاف واستراتيجية تجربة المستخدم إلى تصميم الواجهات والتسليم للمطورين.</p>
      <div class="hero__actions">
        <a class="btn btn--dark" href="#case-studies">تصفّح أعمالي <span class="btn__arrow" aria-hidden="true">↖</span></a>
        <a class="text-link" href="#contact">لنبنِ شيئًا معًا <span aria-hidden="true">←</span></a>
      </div>
      <dl class="hero__stats">
        <div><dt>أكثر من 15 عامًا</dt><dd>في تصميم المنتجات الرقمية</dd></div>
        <div><dt>شهادة Google</dt><dd>في تصميم تجربة المستخدم</dd></div>
        <div><dt>محاضر جامعي</dt><dd>في UX/UI بجامعة النجاح</dd></div>
      </dl>
    </div>
    <figure class="hero__visual">
      <span class="hero__panel" aria-hidden="true"></span>
      <span class="hero__label" aria-hidden="true">استراتيجية ← تجربة ← منتج</span>
      <div class="hero__stage" dir="ltr">
        <img class="hero__shot" src="/assets/img/crpton-1-1368.webp" srcset="/assets/img/crpton-1-1368.webp 1368w, /assets/img/crpton-1-2736.webp 2736w" sizes="(min-width: 1448px) 560px, (min-width: 961px) 40vw, 84vw" width="2736" height="1778" fetchpriority="high" decoding="async" alt="تطبيق Crpton للعيادات على الويب: تبويب الحسابات المالية لمريض، مع الرسوم والدفعات والتأمين والرصيد.">
        <span class="hero__tablet"><img src="/assets/img/zenraise-3-445.webp" srcset="/assets/img/zenraise-3-445.webp 445w, /assets/img/zenraise-3-891.webp 891w" sizes="(min-width: 961px) 200px, 30vw" width="891" height="1424" decoding="async" alt="تطبيق ZenRaise على التابلت: شاشة التبرع مع البرنامج وتكرار التبرع ورقم الهاتف."></span>
        <p class="hero__badge" dir="auto"><span class="hero__badge-icon" aria-hidden="true">✓</span>يعمل في عيادات حقيقية</p>
      </div>
      <figcaption class="hero__caption"><span aria-hidden="true">↳</span> منتجات حقيقية. قرارات مدروسة.</figcaption>
    </figure>
  </div>
</section>

<!-- Clients -->
<section class="clients" aria-labelledby="clients-title">
  <div class="container">
    <div class="clients__head">
      <h2 class="eyebrow" id="clients-title">فرق صمّمتُ لها</h2>
      <p class="clients__intro">من برمجيات المؤسسات والبنوك وأسواق المال إلى الرعاية الصحية والسفر والتجارة الإلكترونية والاتصالات والخدمات اللوجستية. ولا يزال عدد من المشاريع العالمية خاضعًا لاتفاقيات عدم الإفصاح.</p>
    </div>
    <LogoMarquee lang="ar" />
  </div>
</section>

<!-- Case studies -->
<section class="band band--light" id="case-studies" aria-labelledby="case-studies-title">
  <div class="container">
    <div class="section-head section-head--split reveal">
      <div>
        <p class="eyebrow">أعمال مختارة / 01–04</p>
        <h2 class="section-title" id="case-studies-title">أربع مشكلات <em>تستحق أن أحدّثك عنها.</em></h2>
      </div>
      <p class="section-sub">عمل حقيقي مع مستخدمين حقيقيين — من نظام تدير به العيادات يومها كاملًا، إلى تطبيق تبرعات يعمل في فعاليات حقيقية، ومتجر يبيع في ثلاث مناطق.</p>
    </div>
    <ol class="work-grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i + 1} lang="ar" />)}
    </ol>
  </div>
</section>

<!-- Featured testimonial -->
<div class="quote-band">
  <div class="container reveal">
    <FeaturedQuote lang="ar" />
  </div>
</div>

<!-- About -->
<section class="band band--light" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about">
      <figure class="about__card reveal">
        <img src="/assets/img/abdulaziz-portrait-v4-480.webp" srcset="/assets/img/abdulaziz-portrait-v4-480.webp 480w, /assets/img/abdulaziz-portrait-v4-960.webp 960w" sizes="(min-width: 961px) 400px, (min-width: 721px) 300px, 86vw" width="960" height="960" loading="lazy" decoding="async" alt="صورة شخصية لعبدالعزيز أبو ضهير">
        <figcaption><span class="about__card-name">عبدالعزيز أبو ضهير</span><span>نابلس، فلسطين</span></figcaption>
      </figure>
      <div class="about__body reveal">
        <p class="eyebrow">الشخص وراء العمل</p>
        <h2 class="section-title" id="about-title">شريك تصميم، <em>من السؤال الأول.</em></h2>
        <div class="about__bio">
          <p>أنا عبدالعزيز، مصمم منتجات أول آخذ المنتجات الرقمية المعقّدة من المتطلبات الأولى إلى تصميم جاهز للتطوير. أجمع بين البحث في المجال، ومسارات الاستخدام، وتصميم الواجهات، والعمل عن قرب مع المطورين، لأسلّم أنظمة متكاملة — لا شاشات فقط.</p>
          <p>بدأتُ العمل في تصميم المنتجات عام 2011 في شركة <bdi>EXALT Technologies</bdi>، وأعمل مستقلًا منذ عام 2023. تمتد خبرتي بين برمجيات المؤسسات ومنتجات الشركات الناشئة في الرعاية الصحية والسفر والتجارة الإلكترونية والتقنية المالية والقطاع العام — وبشكل متزايد على منتجات يؤدي فيها الذكاء الاصطناعي جزءًا من العمل ويبقى القرار فيها للإنسان.</p>
        </div>
        <dl class="about__facts">
          <div><dt>الخبرة</dt><dd>أكثر من 15 عامًا، منها أكثر من 12 عامًا في <bdi>EXALT Technologies</bdi></dd></div>
          <div><dt>التعليم</dt><dd>بكالوريوس التصميم الجرافيكي، جامعة النجاح الوطنية</dd></div>
          <div><dt>الشهادات</dt><dd>شهادة Google في تصميم تجربة المستخدم</dd></div>
          <div><dt>اللغات</dt><dd>العربية (اللغة الأم)، والإنجليزية (بطلاقة)</dd></div>
        </dl>
        <p class="about__links">
          <a class="text-link" href="/assets/files/abdulaziz-abudhair-resume.pdf" target="_blank" rel="noopener" hreflang="en">السيرة الذاتية (بالإنجليزية) <span aria-hidden="true">↖</span></a>
          <a class="text-link" href="https://linkedin.com/in/abdulaziz-abudhair" target="_blank" rel="noopener">لينكدإن <span aria-hidden="true">↖</span></a>
        </p>
      </div>
    </div>

    <div class="beyond reveal">
      <div class="beyond__head">
        <h3 class="eyebrow" id="beyond-design">ما وراء الشاشة</h3>
        <p>تدريس التصميم وتقييمه يُبقيان طريقتي في العمل صادقة.</p>
      </div>
      <ul class="beyond__list">
        <li><span>محاضر في التصميم الجرافيكي وUX/UI</span><span>جامعة النجاح الوطنية</span></li>
        <li><span>مقيّم خارجي لمشاريع UX/UI</span><span>جامعة بيرزيت · 2023–2026</span></li>
        <li><span>لجنة تطوير المناهج</span><span>جامعة النجاح الوطنية</span></li>
        <li><span>مدرّب ورشة الذكاء الاصطناعي في التصميم</span><span>تدريب مستقل</span></li>
        <li><span>مرشد UX/UI</span><span>Startup Weekend، نابلس</span></li>
        <li><span>شهادة تقدير</span><span>معرض TEDI Najah Expo، لإرشاد مشاريع التخرج</span></li>
      </ul>
    </div>
  </div>
</section>

<Testimonials featured="none" lang="ar" />

</Layout>
